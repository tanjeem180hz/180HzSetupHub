<UserControl x:Class="SetupHub180Hz.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:services="clr-namespace:SetupHub180Hz.Services">

    <UserControl.Resources>
        <!-- ======================================================== -->
        <!--  1. PROFESSIONAL CYBER-GLASS MODULE TILE STYLE           -->
        <!-- ======================================================== -->
        <Style x:Key="DashboardTile" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="136"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="TileScale" ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform x:Name="TileTranslate" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- Ambient Cyan Glow Shadow (Blooms on hover) -->
                            <Border x:Name="GlowShadow"
                                    CornerRadius="10"
                                    Margin="2"
                                    Opacity="0"
                                    Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00F0FF" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.32"/>
                                </Border.Effect>
                            </Border>

                            <!-- Dark Elevation Depth Shadow -->
                            <Border x:Name="DepthShadow"
                                    CornerRadius="10"
                                    Margin="2"
                                    Opacity="0.4"
                                    Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>

                            <!-- Main Glass Card Container -->
                            <Border x:Name="TileBorder"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    Padding="18,16"
                                    SnapsToDevicePixels="True"
                                    ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#151F30" Offset="0"/>
                                        <GradientStop Color="#0D131F" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#2A3C56" Offset="0"/>
                                        <GradientStop Color="#162232" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.BorderBrush>

                                <Grid>
                                    <!-- Ambient Radial Cyber Aura in Top-Right Corner -->
                                    <Ellipse x:Name="RadialAura"
                                             Width="160" Height="160"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,-50,-50,0"
                                             IsHitTestVisible="False"
                                             Opacity="0.05">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                                <GradientStop Color="#00F0FF" Offset="0"/>
                                                <GradientStop Color="#0077B6" Offset="0.55"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>

                                    <!-- Top Specular Glass Edge Highlight -->
                                    <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="10,0,10,0" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#00000000" Offset="0"/>
                                                <GradientStop Color="#3000F0FF" Offset="0.5"/>
                                                <GradientStop Color="#00000000" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Card Content -->
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- MouseOver Hover Pop Up State -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00F0FF" Offset="0"/>
                                            <GradientStop Color="#0080FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="TileBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#1A2840" Offset="0"/>
                                            <GradientStop Color="#101726" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Smooth Elevation Lift (Y: -5) -->
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-5" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- 3D Scale Pop (1.018) -->
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.018" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.018" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Ambient Radial Aura Bloom -->
                                            <DoubleAnimation Storyboard.TargetName="RadialAura"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.38" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Glow Shadow Bloom -->
                                            <DoubleAnimation Storyboard.TargetName="GlowShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Depth Shadow -->
                                            <DoubleAnimation Storyboard.TargetName="DepthShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.75" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Return Elevation Lift (Y: 0) -->
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Return Scale (1.0) -->
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Dim Radial Aura -->
                                            <DoubleAnimation Storyboard.TargetName="RadialAura"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.05" Duration="0:0:0.22"/>

                                            <!-- Dim Glow Shadow -->
                                            <DoubleAnimation Storyboard.TargetName="GlowShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.0" Duration="0:0:0.22"/>

                                            <!-- Return Depth Shadow -->
                                            <DoubleAnimation Storyboard.TargetName="DepthShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Pressed State -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#121B2A" Offset="0"/>
                                            <GradientStop Color="#090E16" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.992" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.992" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================================================== -->
        <!--  2. INTERACTIVE LIVE SYSTEM STAT CARD STYLE              -->
        <!-- ======================================================== -->
        <Style x:Key="DashboardStatCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="6,0,6,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#151F30" Offset="0"/>
                        <GradientStop Color="#0D131F" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2A3C56" Offset="0"/>
                        <GradientStop Color="#162232" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00F0FF" Offset="0"/>
                                <GradientStop Color="#0080FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#1A2840" Offset="0"/>
                                <GradientStop Color="#101726" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-4" Duration="0:0:0.24">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ======================================================== -->
        <!--  3. HERO COMMAND BANNER STYLE                            -->
        <!-- ======================================================== -->
        <Style x:Key="DashboardHeroCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#152136" Offset="0"/>
                        <GradientStop Color="#0C121D" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#304462" Offset="0"/>
                        <GradientStop Color="#162232" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#00F0FF" Offset="0"/>
                                <GradientStop Color="#0080FF" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-3" Duration="0:0:0.24">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- ======================================================== -->
    <!--  STAGGERED HIGH-PRECISION ENTRANCE ANIMATIONS            -->
    <!-- ======================================================== -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- 1. Header Block -->
                    <DoubleAnimation Storyboard.TargetName="HeaderBlock"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32"/>
                    <DoubleAnimation Storyboard.TargetName="HeaderTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="18" To="0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 2. Hero Card -->
                    <DoubleAnimation Storyboard.TargetName="HeroCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.06" Duration="0:0:0.36"/>
                    <DoubleAnimation Storyboard.TargetName="HeroTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="22" To="0" BeginTime="0:0:0.06" Duration="0:0:0.36">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 3. System Stats Section -->
                    <DoubleAnimation Storyboard.TargetName="SystemStatsSection"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.38"/>
                    <DoubleAnimation Storyboard.TargetName="StatsTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="24" To="0" BeginTime="0:0:0.12" Duration="0:0:0.38">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 4. Command Modules Grid -->
                    <DoubleAnimation Storyboard.TargetName="ModulesSection"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.18" Duration="0:0:0.42"/>
                    <DoubleAnimation Storyboard.TargetName="ModulesTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="28" To="0" BeginTime="0:0:0.18" Duration="0:0:0.42">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer Style="{StaticResource CleanScrollViewer}" Padding="32,24,32,32">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Block with Status -->
            <Grid x:Name="HeaderBlock" Grid.Row="0" Margin="0,0,0,20">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HeaderTransform" Y="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                            <TextBlock Text="⚡ 180Hz PRO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                        <TextBlock Text="COMMAND CENTER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource TextHeader}" FontSize="26"/>
                    <TextBlock Text="System status, feature flow, and quick actions." Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Engine Status and Refresh Action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnEngineStatus" Tag="ENGINE READY" Style="{StaticResource ExpandableSuccessButton}"
                            ToolTip="Winget Core Engine Status (Click to re-check)" Click="EngineStatus_Click" Margin="0,0,8,0">
                        <Ellipse x:Name="EngineStatusDot" Width="9" Height="9" Fill="{DynamicResource BrushSuccess}" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="RefreshSummaryButton" Tag="Refresh" Style="{StaticResource ExpandableOutlineButton}" Margin="0,0,0,0" Click="RefreshSummary_Click">
                        <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                    services:LottieHelper.AssetName="loading_disc.json"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Hero Card -->
            <Border x:Name="HeroCard" Grid.Row="1" Style="{StaticResource DashboardHeroCard}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HeroTransform" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <!-- Ambient Cybernetic Glow Orb in top-right -->
                    <Ellipse Width="340" Height="340" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-120,-100,0" IsHitTestVisible="False" Opacity="0.12">
                        <Ellipse.Fill>
                            <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                                <GradientStop Color="#00F0FF" Offset="0"/>
                                <GradientStop Color="#0055AA" Offset="0.6"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <!-- Top Specular Glass Highlight -->
                    <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="14,0,14,0" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#00000000" Offset="0"/>
                                <GradientStop Color="#4000F0FF" Offset="0.5"/>
                                <GradientStop Color="#00000000" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="OPTIMIZE. MONITOR. DEPLOY." FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"/>
                            <TextBlock Text="Automated app setup, update tracking, bandwidth monitoring, and junk cleanup — all in one place."
                                       Style="{StaticResource TextBody}" FontSize="13" Margin="0,8,0,18" HorizontalAlignment="Left"/>

                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔔" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="UpdateSummaryText" Text="Checking for updates…" Style="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🛡️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Windows 64-bit Ready" Style="{StaticResource TextBody}"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right Module Counter Card -->
                        <Border Grid.Column="1" CornerRadius="10" Padding="18" VerticalAlignment="Center" SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#101826" Offset="0"/>
                                    <GradientStop Color="#090E17" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#4000F0FF" Offset="0"/>
                                    <GradientStop Color="#1500F0FF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <StackPanel HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource BrushAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="180Hz HUB" Foreground="{DynamicResource BrushAccent}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="ModuleCountText" Text="8" FontSize="36" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                                <TextBlock Text="MODULES ACTIVE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2b. Live System Stats -->
            <UniformGrid x:Name="SystemStatsSection" Grid.Row="2" Columns="3" Margin="-6,0,-6,24">
                <UniformGrid.RenderTransform>
                    <TranslateTransform x:Name="StatsTransform" Y="0"/>
                </UniformGrid.RenderTransform>

                <!-- 1. CPU Usage -->
                <Border Style="{StaticResource DashboardStatCard}">
                    <Grid>
                        <!-- Specular Edge -->
                        <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="6,0,6,0" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#2500F0FF" Offset="0.5"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="wave.json"
                                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CPU LOAD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                                <TextBlock x:Name="CpuPercentText" Text="0.0%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <TextBlock Text=" active" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" x:Name="CpuProgressBar" Style="{StaticResource FlatProgressBar}"
                                         Minimum="0" Maximum="100" Value="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. Memory Usage -->
                <Border Style="{StaticResource DashboardStatCard}">
                    <Grid>
                        <!-- Specular Edge -->
                        <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="6,0,6,0" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#2500F0FF" Offset="0.5"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="gears.json"
                                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MEMORY (RAM)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                                <TextBlock x:Name="RamUsageText" Text="0.0 / 0.0 GB" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="RamPercentText" Text=" (0%)" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" x:Name="RamProgressBar" Style="{StaticResource FlatProgressBar}"
                                         Minimum="0" Maximum="100" Value="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. Disk Space (C:) -->
                <Border Style="{StaticResource DashboardStatCard}">
                    <Grid>
                        <!-- Specular Edge -->
                        <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="6,0,6,0" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#2500F0FF" Offset="0.5"/>
                                    <GradientStop Color="#00000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="scan.json"
                                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DISK (C:)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                                <TextBlock x:Name="DiskUsageText" Text="0.0 GB Free" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="DiskTotalText" Text=" of 0.0 GB" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" x:Name="DiskProgressBar" Style="{StaticResource FlatProgressBar}"
                                         Minimum="0" Maximum="100" Value="0"/>
                        </Grid>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- 3. Modules Section -->
            <StackPanel x:Name="ModulesSection" Grid.Row="3">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ModulesTransform" Y="0"/>
                </StackPanel.RenderTransform>

                <Grid Margin="0,0,0,14">
                    <TextBlock Text="COMMAND MODULES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="Click any tile to jump directly into the module" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 8 Responsive Module Tiles in Dynamic UniformGrid -->
                <UniformGrid x:Name="ModulesGrid" Columns="4" Rows="2" Margin="-6,0,-6,0">
                    <!-- 01 Setup Apps -->
                    <Button x:Name="TileSetupApps" Style="{StaticResource DashboardTile}" Margin="6" Click="TileSetupApps_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1500F0FF" BorderBrush="#3500F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="01" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="18" Height="18" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="gears.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Setup Apps" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,4"/>
                            <TextBlock Grid.Row="2" Text="Search winget catalog and install essential applications with one click."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 02 Downloads -->
                    <Button x:Name="TileDownloads" Style="{StaticResource DashboardTile}" Margin="6" Click="TileDownloads_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1500F0FF" BorderBrush="#3500F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="02" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="18" Height="18" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="download_flow.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Downloads" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,4"/>
                            <TextBlock Grid.Row="2" Text="Real-time bandwidth monitoring, concurrent queue manager, and speed charts."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 03 Update Center -->
                    <Button x:Name="TileUpdateCenter" Style="{StaticResource DashboardTile}" Margin="6" Click="TileUpdateCenter_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1500F0FF" BorderBrush="#3500F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="03" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="18" Height="18" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="update_sync.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Update Center" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,4"/>
                            <TextBlock Grid.Row="2" Text="Detect out-of-date apps and upgrade them individually or all at once."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 04 Uninstaller -->
                    <Button x:Name="TileUninstaller" Style="{StaticResource DashboardTile}" Margin="6" Click="TileUninstaller_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1500F0FF" BorderBrush="#3500F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="04" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="18" Height="18" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="uninstaller_bin.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Uninstaller" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,4"/>
                            <TextBlock Grid.Row="2" Text="View all installed applications and cleanly uninstall unwanted software."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 05 Startup Apps -->
                    <Button x:Name="TileStartup" Style="{StaticResource DashboardTile}" Margin="6" Click="TileStartup_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1500F0FF" BorderBrush="#3500F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="05" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="18" Height="18" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="startup_boost.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Startup Apps" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,4"/>
                            <TextBlock Grid.Row="2" Text="Inspect and control apps configured to launch automatically with Windows."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 06 Cleanup -->
                    <Button x:Name="TileCleanup" Style="{StaticResource DashboardTile}" Margin="6" Click="TileCleanup_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1500F0FF" BorderBrush="#3500F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="06" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="18" Height="18" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="cleanup_sparkle.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Cleanup" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,4"/>
                            <TextBlock Grid.Row="2" Text="Scan and safely purge temporary files, caches, and prefetch items."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 07 Activity -->
                    <Button x:Name="TileActivity" Style="{StaticResource DashboardTile}" Margin="6" Click="TileActivity_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1500F0FF" BorderBrush="#3500F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="07" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="18" Height="18" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="activity_pulse.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Activity" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,4"/>
                            <TextBlock Grid.Row="2" Text="Live event log and telemetry history for installs, updates and cleanups."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 08 Storage -->
                    <Button x:Name="TileStorage" Style="{StaticResource DashboardTile}" Margin="6" Click="TileStorage_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1500F0FF" BorderBrush="#3500F0FF" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="08" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="18" Height="18" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="scan.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Storage" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,12,0,4"/>
                            <TextBlock Grid.Row="2" Text="View disk footprint and open the local application data directory."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
