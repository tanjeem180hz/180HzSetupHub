<Window x:Class="SetupHub180Hz.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="180Hz Setup Hub"
        Height="250"
        Width="380"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI, Arial, sans-serif">

    <!-- Minimal, distraction-free floating card -->
    <Border Background="#090E0A"
            BorderBrush="#18241A"
            BorderThickness="1"
            CornerRadius="16"
            Margin="16"
            MouseLeftButtonDown="Window_MouseDown">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                              BlurRadius="28"
                              ShadowDepth="4"
                              Opacity="0.75"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center">

            <!-- Center Brand Logo with subtle toxic ambient glow -->
            <Border Width="76"
                    Height="76"
                    CornerRadius="14"
                    Background="#0F1611"
                    BorderBrush="#213024"
                    BorderThickness="1"
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#00FF66"
                                      BlurRadius="18"
                                      ShadowDepth="0"
                                      Opacity="0.35"/>
                </Border.Effect>
                <Image Source="pack://application:,,,/Assets/AppIcon-1024.png"
                       Width="62"
                       Height="62"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>

            <!-- Minimal App Title -->
            <TextBlock Text="180Hz Setup Hub"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,14,0,16"/>

            <!-- Sleek Minimal Progress Bar (No extra text, no clutter) -->
            <Border Width="180"
                    Height="3"
                    Background="#141E16"
                    CornerRadius="1.5"
                    ClipToBounds="True"
                    HorizontalAlignment="Center">
                <ProgressBar x:Name="StartupProgressBar"
                             Height="3"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="Transparent"
                             Foreground="#00FF66"
                             BorderThickness="0"/>
            </Border>
        </StackPanel>
    </Border>
</Window>
