<UserControl x:Class="SetupHub180Hz.Views.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SetupHub180Hz.Converters">
    <UserControl.Resources>
        <conv:ActivityTypeToBrushConverter x:Key="TypeToBrush"/>
    </UserControl.Resources>
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Activity" Style="{StaticResource TextHeader}"/>
            <TextBlock Text="A running log of everything the app has done." Style="{StaticResource TextBody}" Margin="0,4,0,16"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}">
            <ItemsControl x:Name="LogList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="{Binding Type, Converter={StaticResource TypeToBrush}}"
                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource TextBody}"
                                           Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding TimestampDisplay}" Style="{StaticResource TextBody}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
