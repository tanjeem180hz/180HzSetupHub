<UserControl x:Class="SetupHub180Hz.Views.UninstallerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SetupHub180Hz.Models"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:services="clr-namespace:SetupHub180Hz.Services">

    <UserControl.Resources>
        <!-- Danger / Uninstall Button Style -->
        <Style x:Key="DangerOutlineButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushError}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource BrushError}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#25F0556B"/>
                                <Setter Property="Foreground" Value="#FFA4B2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40F0556B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfirmDangerButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource BrushError}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF6B7F"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#D93D53"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ListBox Item Style -->
        <Style x:Key="CleanListBoxItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Installed App Card Template -->
        <DataTemplate x:Key="InstalledAppCardTemplate">
            <Border Style="{StaticResource ListRow}" Padding="14,10,14,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Logo / Monogram -->
                    <Border Width="44" Height="44" CornerRadius="8"
                            Background="{StaticResource BrushBackground}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Neutral Loading/Fallback Placeholder: ONLY visible when HasIconImage is False -->
                            <Border Background="{StaticResource BrushSurface}" CornerRadius="7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIconImage}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="📦"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.4"/>
                            </Border>

                            <!-- Real Image Source (Local .exe icon or cached remote icon) -->
                            <Image Source="{Binding IconImageSource}"
                                   Width="32" Height="32"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 2. Info Panel -->
                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>

                            <!-- Source Badge -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1,6,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SourceTag}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>
                        </StackPanel>

                        <!-- Meta Row (Exact Version + Real Measured Size + ID) -->
                        <StackPanel Orientation="Horizontal">
                            <!-- Version Pill -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2,8,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormattedVersion}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>

                            <!-- Size Pill -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2,8,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormattedSize}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>

                            <!-- Install Date Pill -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2,8,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FormattedInstallDate}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding FormattedInstallDate}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushAccent}"/>
                            </Border>

                            <!-- ID Text -->
                            <TextBlock Text="{Binding Id}"
                                       Style="{StaticResource TextBody}"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 3. Actions: Official Link & Uninstall Button -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Loaded="OfficialLinkContainer_Loaded" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button Content="🗑" Tag="Uninstall"
                                Style="{StaticResource ExpandableDangerButton}"
                                VerticalAlignment="Center"
                                Click="UninstallButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Main Content -->
        <Grid Margin="32,24,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Filter & Controls -->
                <RowDefinition Height="*"/>    <!-- Apps List -->
            </Grid.RowDefinitions>

            <!-- 1. Header Block -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <lottie:LottieAnimationView Width="26" Height="26" AutoPlay="True" RepeatCount="-1"
                                                    services:LottieHelper.AssetName="uninstaller_bin.json" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Uninstall Software" Style="{StaticResource TextHeader}" FontSize="26" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="View installed software with authentic versions, measured disk sizes, and verified registry entries."
                               Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Installed Count Badge -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <lottie:LottieAnimationView Width="14" Height="14" AutoPlay="True" RepeatCount="-1"
                                                        services:LottieHelper.AssetName="scan.json" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="InstalledCountText" Text="Scanning installed apps…" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- 2. Filter & Toolbar -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>
                        <TextBox x:Name="FilterBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{StaticResource BrushTextPrimary}" CaretBrush="{StaticResource BrushAccent}"
                                 FontFamily="{StaticResource AppFont}" FontSize="13" Padding="10,10"
                                 VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged"/>
                        <Button x:Name="ClearFilterButton" Grid.Column="2" Content="✕"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextSecondary}"
                                Padding="10,0" Cursor="Hand" Visibility="Collapsed" Click="ClearFilter_Click"/>
                    </Grid>
                </Border>

                <Button Grid.Column="1" Tag="Rescan" Style="{StaticResource ExpandableOutlineButton}" Margin="8,0,0,0" Click="Refresh_Click">
                    <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                services:LottieHelper.AssetName="loading_disc.json"/>
                </Button>
                <Button Grid.Column="2" Content="📤" Tag="Export List" Style="{StaticResource ExpandableOutlineButton}" Margin="8,0,0,0" ToolTip="Export installed apps list to JSON" Click="ExportList_Click"/>
            </Grid>

            <!-- 3. Installed Apps List with UI Virtualization -->
            <Grid Grid.Row="2">
                <TextBlock x:Name="StatusText" Text="Scanning installed applications…" Style="{StaticResource TextBody}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>

                <ListBox x:Name="AppsListBox"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemContainerStyle="{StaticResource CleanListBoxItem}"
                         ItemTemplate="{StaticResource InstalledAppCardTemplate}"/>
            </Grid>
        </Grid>

        <!-- 4. Modern In-App Warning & Confirmation Dialog Overlay -->
        <Grid x:Name="WarningOverlay" Visibility="Collapsed" Background="#D9070A10">
            <Border Style="{StaticResource Card}" CornerRadius="12" Padding="28" MaxWidth="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.7"/>
                </Border.Effect>

                <StackPanel>
                    <!-- Warning Icon & Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Border Width="38" Height="38" CornerRadius="19" Background="#2DF0556B" Margin="0,0,12,0" VerticalAlignment="Center">
                            <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CONFIRM UNINSTALLATION" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushError}"/>
                            <TextBlock Text="Are you sure you want to proceed?" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- App Preview Card -->
                    <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Dialog Logo -->
                            <Border x:Name="DialogLogoBorder" Width="42" Height="42" CornerRadius="8" Background="{StaticResource BrushSurface}"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" Margin="0,0,12,0" ClipToBounds="True">
                                <Grid x:Name="DialogLogoGrid">
                                    <TextBlock x:Name="DialogFallbackInitial" Text="📦" FontSize="18"
                                               Foreground="{StaticResource BrushTextSecondary}" Opacity="0.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Dialog Details -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="DialogAppNameText" Text="App Name" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="DialogVersionText" Text="🏷️ v1.0.0" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="DialogSizeText" Text="💾 120 MB" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="DialogIdText" Text="App.Id" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Warning Details -->
                    <TextBlock Text="This action will permanently uninstall this application and may purge its associated local configs and registry settings from Windows."
                               Style="{StaticResource TextBody}" LineHeight="18" Margin="0,0,0,24"/>

                    <!-- Action Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="Cancel" Style="{StaticResource OutlineButton}" Grid.Column="1" Margin="0,0,10,0" Padding="18,8" Click="CancelUninstall_Click"/>
                        <Button x:Name="ConfirmUninstallButton" Content="Yes, Uninstall" Style="{StaticResource ConfirmDangerButton}" Grid.Column="2" Click="ConfirmUninstall_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
