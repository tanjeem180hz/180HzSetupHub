<Window x:Class="SetupHub180Hz.Views.RevoUninstallWizardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="180Hz Setup Hub — Revo Uninstall Engine"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        ShowInTaskbar="False">

    <Border Background="{DynamicResource BrushBackground}"
            BorderBrush="{DynamicResource BrushAccent}"
            BorderThickness="1"
            CornerRadius="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.75"/>
        </Border.Effect>

        <Grid Margin="24,18,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- 5-Step Progress Ribbon -->
                <RowDefinition Height="*"/>    <!-- Active Phase Content -->
            </Grid.RowDefinitions>

            <!-- 1. Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseDown="TitleBar_MouseDown" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="REVO UNINSTALL ENGINE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock x:Name="HeaderAppNameText" Text="Uninstalling Application" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="WindowCloseBtn" Grid.Column="1" Content="✕" Width="30" Height="30"
                        Style="{StaticResource CloseCaptionButton}"
                        Click="WindowCloseBtn_Click"/>
            </Grid>

            <!-- 2. Revo 5-Step Ribbon -->
            <Border Grid.Row="1" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Step 1 Indicator -->
                    <StackPanel x:Name="StepIndicator1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="StepBadge1" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BrushAccent}" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StepNum1" Text="1" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccentForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="StepLabel1" Text="Analysis" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="›" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Opacity="0.5" VerticalAlignment="Center"/>

                    <!-- Step 2 Indicator -->
                    <StackPanel x:Name="StepIndicator2" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="StepBadge2" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BrushBorder}" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StepNum2" Text="2" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="StepLabel2" Text="Built-in" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="›" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Opacity="0.5" VerticalAlignment="Center"/>

                    <!-- Step 3 Indicator -->
                    <StackPanel x:Name="StepIndicator3" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="StepBadge3" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BrushBorder}" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StepNum3" Text="3" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="StepLabel3" Text="Scan Mode" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="5" Text="›" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Opacity="0.5" VerticalAlignment="Center"/>

                    <!-- Step 4 Indicator -->
                    <StackPanel x:Name="StepIndicator4" Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="StepBadge4" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BrushBorder}" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StepNum4" Text="4" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="StepLabel4" Text="Registry" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Grid.Column="7" Text="›" FontSize="14" Foreground="{DynamicResource BrushTextSecondary}" Opacity="0.5" VerticalAlignment="Center"/>

                    <!-- Step 5 Indicator -->
                    <StackPanel x:Name="StepIndicator5" Grid.Column="8" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border x:Name="StepBadge5" Width="20" Height="20" CornerRadius="10" Background="{DynamicResource BrushBorder}" Margin="0,0,6,0" VerticalAlignment="Center">
                            <TextBlock x:Name="StepNum5" Text="5" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="StepLabel5" Text="Files" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 3. Dynamic Step Panels Container -->
            <Grid Grid.Row="2">

                <!-- ================= PHASE 1: ANALYSIS & SYSTEM BACKUP ================= -->
                <Grid x:Name="PanelStep1_Analysis" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- App Card -->
                        <RowDefinition Height="*"/>    <!-- Checklist Card -->
                        <RowDefinition Height="Auto"/> <!-- Action Footer -->
                    </Grid.RowDefinitions>

                    <!-- Target App Summary Card -->
                    <Border Grid.Row="0" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border x:Name="AppLogoBorder" Width="48" Height="48" CornerRadius="8" Background="{DynamicResource BrushBackground}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Grid x:Name="AppLogoGrid">
                                    <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="AppNameText" Text="Application Name" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock x:Name="AppVersionText" Text="v1.0.0" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="AppSizeText" Text="120 MB" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="AppPublisherText" Text="" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0"/>
                                    <TextBlock x:Name="AppIdText" Text="App.Id" FontSize="11" Foreground="{DynamicResource BrushAccent}"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- System Protection Checklist Card -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="PRE-UNINSTALL SAFEGUARDS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,12"/>

                            <!-- Restore Point Item -->
                            <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkCreateRestorePoint" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Make a System Restore Point before uninstall" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="RestorePointStatusText" Text="Windows Restore checkpoint protects system state." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="RestorePointIcon" Grid.Column="2" Text="🛡️" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Registry Backup Item -->
                            <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ChkCreateRegistryBackup" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Create a full Registry backup before uninstall" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="RegistryBackupStatusText" Text="Exports application registry keys to safe backup storage." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="RegistryBackupIcon" Grid.Column="2" Text="💾" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>

                            <!-- Installation Analysis Item -->
                            <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="2,0,10,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Analyze Installation Data" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <TextBlock x:Name="AnalysisStatusText" Text="Ready to index official uninstaller and installation paths." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock x:Name="AnalysisIcon" Grid.Column="2" Text="⚡" FontSize="14" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Footer -->
                    <Grid Grid.Row="2">
                        <ProgressBar x:Name="PrepProgressBar" Height="4" Visibility="Collapsed" IsIndeterminate="True" VerticalAlignment="Top" Margin="0,0,0,10" Foreground="{DynamicResource BrushAccent}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Cancel" Style="{StaticResource OutlineButton}" Padding="16,6" Margin="0,0,10,0" Click="WindowCloseBtn_Click"/>
                            <Button x:Name="BtnProceedToUninstaller" Content="Continue ➔" Style="{StaticResource PrimaryButton}" Padding="24,6" Click="BtnProceedToUninstaller_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= PHASE 2: BUILT-IN UNINSTALLER ================= -->
                <Grid x:Name="PanelStep2_BuiltIn" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="24" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="560">
                            <Border Width="56" Height="56" CornerRadius="28" Background="#2000FF66" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🚀" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>

                            <TextBlock Text="BUILT-IN UNINSTALLER LAUNCHED" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="The official publisher uninstaller for this program has been invoked." FontSize="13" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>

                            <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,18">
                                <StackPanel>
                                    <TextBlock Text="💡 What to do now:" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,6"/>
                                    <TextBlock Text="1. Follow and complete any uninstallation prompts shown on your screen." FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" LineHeight="18"/>
                                    <TextBlock Text="2. If the uninstaller asks to restart your computer, select 'Restart Later' so residual trace cleaning can finish." FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" LineHeight="18"/>
                                    <TextBlock Text="3. Once the built-in uninstaller has finished (or if no dialog appeared), click 'Scan for Leftovers' below." FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" LineHeight="18"/>
                                </StackPanel>
                            </Border>

                            <Button x:Name="BtnRerunUninstaller" Content="↺ Rerun Official Uninstaller" Style="{StaticResource OutlineButton}" HorizontalAlignment="Center" Padding="14,5" FontSize="11" Click="BtnRerunUninstaller_Click"/>
                        </StackPanel>
                    </Border>

                    <!-- Footer -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Skip to Scan Modes" Style="{StaticResource OutlineButton}" Padding="16,6" Margin="0,0,10,0" Click="BtnProceedToScanMode_Click"/>
                        <Button Content="Scan for Leftovers ➔" Style="{StaticResource PrimaryButton}" Padding="22,6" Click="BtnProceedToScanMode_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ================= PHASE 3: SCANNING MODES (REVO TRIAD) ================= -->
                <Grid x:Name="PanelStep3_ScanMode" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Select Scanning Mode" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        <TextBlock Text="Choose the depth of leftover trace scanning across Windows registry and disk locations." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- 3 Revo Mode Cards -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <!-- Mode 1: Safe -->
                        <Border x:Name="CardModeSafe" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" Cursor="Hand" MouseDown="CardModeSafe_MouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="RadioModeSafe" GroupName="ScanMode" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🟢 Safe Mode" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <Border Background="#2000FF66" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="Fastest" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Scans Program Files, Local Programs, and official uninstall registry keys. Zero risk of false positives." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Mode 2: Moderate (Recommended) -->
                        <Border x:Name="CardModeModerate" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="2" CornerRadius="8" Padding="14,12" Margin="0,0,0,10" Cursor="Hand" MouseDown="CardModeModerate_MouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="RadioModeModerate" IsChecked="True" GroupName="ScanMode" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🔵 Moderate Mode" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <Border Background="#202FB6FF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="Recommended" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Includes Safe mode plus deep scan in AppData (Local and Roaming), registry vendor hives, and Desktop/Start shortcuts." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Mode 3: Advanced -->
                        <Border x:Name="CardModeAdvanced" Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12" Cursor="Hand" MouseDown="CardModeAdvanced_MouseDown">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton x:Name="RadioModeAdvanced" GroupName="ScanMode" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🟣 Advanced Mode" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                        <Border Background="#20D946EF" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock Text="Deep Heuristics" FontSize="10" FontWeight="Bold" Foreground="#D946EF"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Comprehensive scan across ProgramData, LocalLow, WOW6432Node, and virtual trace caches." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Scanning State Panel (Visible during scan) -->
                        <Border x:Name="ScanProgressPanel" Visibility="Collapsed" Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,4,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="🔍" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ScanStatusText" Text="Deep scanning registry and filesystem for residual traces…" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <ProgressBar Height="4" IsIndeterminate="True" Foreground="{DynamicResource BrushAccent}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Footer -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                        <Button Content="‹ Back" Style="{StaticResource OutlineButton}" Padding="16,6" Margin="0,0,10,0" Click="BtnBackToBuiltIn_Click"/>
                        <Button x:Name="BtnStartScan" Content="🔍 Scan" Style="{StaticResource PrimaryButton}" Padding="26,6" Click="BtnStartScan_Click"/>
                    </StackPanel>
                </Grid>

                <!-- ================= PHASE 4: REGISTRY LEFTOVERS ================= -->
                <Grid x:Name="PanelStep4_Registry" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header & Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Registry Items List -->
                        <RowDefinition Height="Auto"/> <!-- Action Footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Found Leftover Registry Items" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="RegistryCountText" Text="0 residual registry keys detected" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Select All" Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="SelectAllRegistry_Click"/>
                            <Button Content="Deselect All" Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11" Click="DeselectAllRegistry_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Registry ListBox -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,12">
                        <Grid>
                            <ListBox x:Name="RegistryListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="4,3"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Opacity="{Binding ItemOpacity}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding IsSelected}" Visibility="{Binding CheckBoxVisibility}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <Border Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding StatusBadgeVisibility}">
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="12" FontWeight="Bold" Foreground="{Binding BadgeForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Text="🔑" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Registry Key" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                        <Border Background="{DynamicResource BrushBackground}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding MatchedOn, StringFormat='Matched on: {0}'}" FontSize="10" Foreground="{DynamicResource BrushAccent}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                </StackPanel>

                                                <Border Grid.Column="2" Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeForeground}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="{Binding StatusBadgeVisibility}">
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty State -->
                            <TextBlock x:Name="RegistryEmptyText" Text="✓ No residual registry keys detected for this application." FontSize="13" Foreground="{DynamicResource BrushSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Registry Footer -->
                    <Grid Grid.Row="2">
                        <!-- Inline Deletion Progress -->
                        <Border x:Name="RegistryProgressPanel" Visibility="Collapsed" Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="RegistryProgressStatusText" Text="Purging residual registry keys…" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="RegistryProgressBar" Height="4" Foreground="{DynamicResource BrushAccent}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="RegistryActionsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnDeleteRegistry" Content="🗑️ Delete Selected" Style="{StaticResource ConfirmDangerButton}" Margin="0,0,10,0" Click="BtnDeleteRegistry_Click"/>
                            <Button x:Name="BtnNextToFiles" Content="Next: Residual Files ➔" Style="{StaticResource PrimaryButton}" Padding="20,6" Click="BtnNextToFiles_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= PHASE 5: FILES & FOLDERS LEFTOVERS ================= -->
                <Grid x:Name="PanelStep5_Files" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header & Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Files List -->
                        <RowDefinition Height="Auto"/> <!-- Action Footer -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Found Leftover Files and Folders" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock x:Name="FilesCountText" Text="0 residual files and folders detected" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Select All" Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="SelectAllFiles_Click"/>
                            <Button Content="Deselect All" Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11" Click="DeselectAllFiles_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Files ListBox -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,12">
                        <Grid>
                            <ListBox x:Name="FilesListBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="4,3"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,4" Opacity="{Binding ItemOpacity}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding IsSelected}" Visibility="{Binding CheckBoxVisibility}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                                <Border Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding StatusBadgeVisibility}">
                                                    <TextBlock Text="{Binding StatusBadgeText}" FontSize="12" FontWeight="Bold" Foreground="{Binding BadgeForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                        <TextBlock Text="{Binding TypeIcon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding TypeName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                        <Border Background="{DynamicResource BrushBackground}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                            <TextBlock Text="{Binding MatchedOn, StringFormat='Matched on: {0}'}" FontSize="10" Foreground="{DynamicResource BrushAccent}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <TextBlock Text="{Binding SizeDisplay}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <Border Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeForeground}" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Visibility="{Binding StatusBadgeVisibility}">
                                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Empty State -->
                            <TextBlock x:Name="FilesEmptyText" Text="✓ No residual files or folders detected on disk." FontSize="13" Foreground="{DynamicResource BrushSuccess}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <!-- Files Footer -->
                    <Grid Grid.Row="2">
                        <!-- Inline Deletion Progress -->
                        <Border x:Name="FilesProgressPanel" Visibility="Collapsed" Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="FilesProgressStatusText" Text="Purging residual directories and files…" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,4"/>
                                <ProgressBar x:Name="FilesProgressBar" Height="4" Foreground="{DynamicResource BrushAccent}"/>
                            </StackPanel>
                        </Border>

                        <StackPanel x:Name="FilesActionsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="BtnDeleteFiles" Content="🗑️ Delete Selected" Style="{StaticResource ConfirmDangerButton}" Margin="0,0,10,0" Click="BtnDeleteFiles_Click"/>
                            <Button x:Name="BtnFinishFiles" Content="Finish ✓" Style="{StaticResource PrimaryButton}" Padding="24,6" Click="BtnFinishFiles_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ================= PHASE 6: COMPLETION SUMMARY ================= -->
                <Grid x:Name="PanelStep6_Complete" Visibility="Collapsed">
                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                        <StackPanel HorizontalAlignment="Center">
                            <Border Width="64" Height="64" CornerRadius="32" Background="#2000FF66" HorizontalAlignment="Center" Margin="0,0,0,16">
                                <TextBlock Text="🛡️✓" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrushSuccess}"/>
                            </Border>

                            <TextBlock Text="UNINSTALLATION COMPLETE" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock x:Name="CompleteSummaryAppName" Text="Application has been completely eradicated." FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,16"/>

                            <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock x:Name="SummaryBuiltInText" Text="✓ Official application uninstaller completed" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="SummaryRegistryText" Text="✓ 0 residual registry traces eradicated" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="SummaryFilesText" Text="✓ 0 residual files and folders purged" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Close" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Padding="28,7" Click="WindowCloseBtn_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
