<UserControl x:Class="SetupHub180Hz.Views.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Margin="28" MaxWidth="600" HorizontalAlignment="Left">
        <TextBlock Text="Storage" Style="{StaticResource TextHeader}"/>
        <TextBlock Text="Local data folder where package config, logs, and downloads are kept."
                   Style="{StaticResource TextBody}" Margin="0,4,0,20"/>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="FOLDER PATH" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                <TextBlock x:Name="PathText" Text="—" Foreground="{StaticResource BrushTextPrimary}"
                           FontFamily="{StaticResource AppFont}" Margin="0,4,0,16" TextWrapping="Wrap"/>

                <TextBlock Text="SIZE ON DISK" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                <TextBlock x:Name="SizeText" Text="Calculating…" Foreground="{StaticResource BrushAccent}"
                           FontSize="22" FontWeight="Bold" Margin="0,4,0,20"/>

                <StackPanel Orientation="Horizontal">
                    <Button Content="Open Storage" Style="{StaticResource AccentButton}" Click="OpenStorage_Click" Margin="0,0,8,0"/>
                    <Button Content="Refresh Size" Style="{StaticResource OutlineButton}" Click="Refresh_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
