<UserControl x:Class="SetupHub180Hz.Views.StartupManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SetupHub180Hz.Models">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                    <TextBlock Text="⚡ STARTUP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                </Border>
                <TextBlock Text="WINDOWS LAUNCH MANAGER" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Startup Manager" Style="{StaticResource TextHeader}" FontSize="26"/>
            <TextBlock Text="View, enable, or disable applications configured to launch automatically with Windows."
                       Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText" Text="Scanning startup entries…"
                       VerticalAlignment="Center" Style="{StaticResource TextBody}" FontWeight="SemiBold"/>

            <Button Grid.Column="1" Content="🔄" Tag="Refresh" Style="{StaticResource ExpandableOutlineButton}"
                    Click="Refresh_Click"/>
        </Grid>

        <!-- Startup Items List -->
        <ScrollViewer Grid.Row="2" Style="{StaticResource CleanScrollViewer}">
            <ItemsControl x:Name="StartupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:StartupItem}">
                        <Border Style="{StaticResource ListRow}" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. Logo / Monogram -->
                                <Border Width="44" Height="44" CornerRadius="8"
                                        Background="{StaticResource BrushBackground}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        ClipToBounds="True">
                                    <Grid>
                                        <!-- Neutral Loading/Fallback Placeholder: ONLY visible when HasIconImage is False -->
                                        <Border Background="{StaticResource BrushSurface}" CornerRadius="7">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIconImage}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="📦"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Opacity="0.4"/>
                                        </Border>

                                        <!-- Authentic Software Logo: Displayed cleanly with NO text behind it -->
                                        <Image Source="{Binding IconImageSource}"
                                               Width="32" Height="32"
                                               Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- 2. Details -->
                                <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"/>

                                        <Border Background="{StaticResource BrushSurfaceHover}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Source}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Command}"
                                               Style="{StaticResource TextBody}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- 3. Actions: Official Site & Toggle Switch -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ContentControl Loaded="OfficialLinkContainer_Loaded" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <ToggleButton Style="{StaticResource ToggleSwitch}"
                                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                  VerticalAlignment="Center"
                                                  Click="Toggle_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
