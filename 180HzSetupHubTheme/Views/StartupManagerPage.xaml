<UserControl x:Class="SetupHub180Hz.Views.StartupManagerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SetupHub180Hz.Models">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="Startup Manager" Style="{StaticResource TextHeader}"/>
            <TextBlock Text="View, enable, or disable applications configured to launch automatically with Windows."
                       Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SummaryText" Text="Scanning startup entries…"
                       VerticalAlignment="Center" Style="{StaticResource TextBody}" FontWeight="SemiBold"/>

            <Button Grid.Column="1" Content="🔄 Refresh" Style="{StaticResource OutlineButton}"
                    Padding="16,8" Click="Refresh_Click"/>
        </Grid>

        <!-- Startup Items List -->
        <ScrollViewer Grid.Row="2" Style="{StaticResource CleanScrollViewer}">
            <ItemsControl x:Name="StartupList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:StartupItem}">
                        <Border Style="{StaticResource ListRow}" Padding="16,12" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Details -->
                                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Name}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextPrimary}"
                                                   VerticalAlignment="Center"/>

                                        <Border Background="{StaticResource BrushSurfaceHover}"
                                                BorderBrush="{StaticResource BrushBorder}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Source}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Command}"
                                               Style="{StaticResource TextBody}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Toggle Switch -->
                                <ToggleButton Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Click="Toggle_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
