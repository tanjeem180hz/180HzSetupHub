<Window x:Class="WinSetupHub.Setup.UninstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="180Hz Setup Hub Maintenance"
        Height="340"
        Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI, -apple-system, BlinkMacSystemFont, Arial, sans-serif">

    <Window.Resources>
        <!-- Modern Professional Palette -->
        <Color x:Key="AccentColor">#00E676</Color>
        <Color x:Key="AccentHoverColor">#25F58C</Color>
        <Color x:Key="AccentPressedColor">#00C864</Color>
        <Color x:Key="DangerColor">#EF4444</Color>
        <Color x:Key="DangerHoverColor">#F87171</Color>
        <Color x:Key="DangerPressedColor">#DC2626</Color>

        <SolidColorBrush x:Key="WindowsBlueBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="WindowsBlueHoverBrush" Color="{StaticResource AccentHoverColor}" />
        <SolidColorBrush x:Key="WindowsBluePressedBrush" Color="{StaticResource AccentPressedColor}" />
        <SolidColorBrush x:Key="WindowsRedBrush" Color="{StaticResource DangerColor}" />
        <SolidColorBrush x:Key="WindowsRedHoverBrush" Color="{StaticResource DangerHoverColor}" />
        <SolidColorBrush x:Key="WindowsRedPressedBrush" Color="{StaticResource DangerPressedColor}" />

        <!-- Clean Primary Button -->
        <Style x:Key="WinPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WindowsBlueBrush}" />
            <Setter Property="Foreground" Value="#061208" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsBlueHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsBluePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Danger Button (for Uninstall) -->
        <Style x:Key="WinDangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WindowsRedBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="86" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsRedHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsRedPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Secondary Button -->
        <Style x:Key="WinSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#161920" />
            <Setter Property="Foreground" Value="#D0D7DE" />
            <Setter Property="BorderBrush" Value="#2A303C" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Height" Value="32" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#20242D" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#384152" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#12141A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titlebar Controls -->
        <Style x:Key="WinTitlebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#1C212B" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#262D3B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinTitlebarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E53935" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#C62828" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border with Slate Charcoal Background & Soft Ambient Shadow -->
    <Border Background="#0F1115"
            BorderBrush="#23272F"
            BorderThickness="1"
            CornerRadius="12"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="4" Opacity="0.65" />
        </Border.Effect>

        <Grid MouseLeftButtonDown="Window_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="60" />
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="180Hz Setup Hub Maintenance"
                               FontSize="11.5"
                               FontWeight="Medium"
                               Foreground="#8B949E"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnClose" Style="{StaticResource WinCloseBtn}" Content="✕" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>

            <!-- Upper Content Area: Clean App Identity & Details -->
            <Grid Grid.Row="1" Margin="28,10,28,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left App Icon Tile -->
                <Border Grid.Column="0"
                        Width="68"
                        Height="68"
                        Background="#15181F"
                        BorderBrush="#262C37"
                        BorderThickness="1"
                        CornerRadius="14"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                    <Image Source="Assets/AppIcon-1024.png"
                           Width="50"
                           Height="50"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>

                <!-- Right Details -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="180Hz Setup Hub"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,3" />

                    <TextBlock Text="Repair or remove 180Hz Setup Hub from this computer."
                               FontSize="12.5"
                               Foreground="#8B949E"
                               Margin="0,0,0,6" />

                    <TextBlock Text="Version 2.5.0 • Windows 64-bit"
                               FontSize="11"
                               FontWeight="Normal"
                               Foreground="#586069" />
                </StackPanel>
            </Grid>

            <!-- Progress Section -->
            <StackPanel Grid.Row="2" Margin="28,0,28,8">
                <TextBlock x:Name="TxtUninstallStatus"
                           Text="Ready to repair or uninstall"
                           FontSize="11.5"
                           FontWeight="Medium"
                           Foreground="#8B949E"
                           Margin="0,0,0,8" />

                <!-- Sleek Minimal Progress Track -->
                <Border Height="4" Background="#1A1E26" CornerRadius="2" ClipToBounds="True">
                    <ProgressBar x:Name="UninstallProgressBar"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource WindowsBlueBrush}"
                                 BorderThickness="0" />
                </Border>
            </StackPanel>

            <!-- Bottom Row: Buttons (Cancel, Repair, Uninstall) -->
            <Grid Grid.Row="3" Margin="28,0,28,16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCancel"
                            Style="{StaticResource WinSecondaryButton}"
                            Content="Cancel"
                            Margin="0,0,8,0"
                            Click="BtnCancel_Click" />

                    <Button x:Name="BtnRepair"
                            Style="{StaticResource WinSecondaryButton}"
                            Content="Repair"
                            Margin="0,0,8,0"
                            Click="BtnRepair_Click" />

                    <Button x:Name="BtnUninstall"
                            Style="{StaticResource WinDangerButton}"
                            Content="Uninstall"
                            Click="BtnUninstall_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
