<Window x:Class="WinSetupHub.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="180Hz Setup Hub"
        Height="360"
        Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI, Arial, sans-serif">

    <Window.Resources>
        <!-- Windows Fluent Accent Colors -->
        <Color x:Key="WindowsBlueColor">#0078D7</Color>
        <Color x:Key="WindowsBlueHoverColor">#1084E3</Color>
        <Color x:Key="WindowsBluePressedColor">#006CBE</Color>

        <SolidColorBrush x:Key="WindowsBlueBrush" Color="{StaticResource WindowsBlueColor}" />
        <SolidColorBrush x:Key="WindowsBlueHoverBrush" Color="{StaticResource WindowsBlueHoverColor}" />
        <SolidColorBrush x:Key="WindowsBluePressedBrush" Color="{StaticResource WindowsBluePressedColor}" />

        <!-- Windows Standard Primary Button Style -->
        <Style x:Key="WinPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WindowsBlueBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="94" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsBlueHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsBluePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows Standard Secondary Button Style -->
        <Style x:Key="WinSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#E1E1E1" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="BorderBrush" Value="#ADADAD" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Width" Value="94" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#E5E5E5" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#999999" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#CCCCCC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.5" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titlebar Caption Buttons -->
        <Style x:Key="WinTitlebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E5E5E5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CCCCCC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinTitlebarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F1707A" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Windows Native CheckBox -->
        <Style x:Key="WinCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <!-- Outer Window Border with Windows 10/11 Subtle DropShadow -->
    <Border Background="#FFFFFF"
            BorderBrush="#7A7A7A"
            BorderThickness="1"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="2" Opacity="0.22" />
        </Border.Effect>

        <Grid MouseLeftButtonDown="Window_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" Background="#FFFFFF">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMinimize" Style="{StaticResource WinTitlebarBtn}" Content="—" Click="BtnMinimize_Click" />
                    <!-- Disabled Maximize Button (Matches Windows App Installer) -->
                    <Button Style="{StaticResource WinTitlebarBtn}" Content="🗖" Foreground="#CCCCCC" Cursor="Arrow" IsHitTestVisible="False" />
                    <Button x:Name="BtnClose" Style="{StaticResource WinCloseBtn}" Content="✕" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>

            <!-- Upper Content Area: Details on Left, Square Logo Tile on Right -->
            <Grid Grid.Row="1" Margin="32,4,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Details -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <!-- Title -->
                    <TextBlock Text="Install 180Hz Setup Hub?"
                               FontSize="23"
                               FontWeight="Normal"
                               Foreground="#1A1A1A"
                               Margin="0,0,0,6" />

                    <!-- Trusted App Badge -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
                        <!-- Vector Window + Green Checkmark Icon -->
                        <Grid Width="16" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                            <Border BorderBrush="#0078D7" BorderThickness="1.2" CornerRadius="1" Height="12" VerticalAlignment="Top" />
                            <Border Background="#0078D7" Height="2.5" VerticalAlignment="Top" Margin="0,0,0,0" />
                            <Ellipse Width="7" Height="7" Fill="#107C10" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            <TextBlock Text="✓" FontSize="5.5" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,1,0" />
                        </Grid>
                        <TextBlock Text="Trusted App"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#0078D7"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Publisher & Version -->
                    <TextBlock Text="Publisher: 180Hz"
                               FontSize="12"
                               Foreground="#333333"
                               Margin="0,0,0,1" />
                    <TextBlock Text="Version: 1.0.0.0"
                               FontSize="12"
                               Foreground="#333333"
                               Margin="0,0,0,12" />

                    <!-- Capabilities -->
                    <TextBlock Text="Capabilities:"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#222222"
                               Margin="0,0,0,3" />
                    <TextBlock Text="• Uses all system resources"
                               FontSize="11.5"
                               Foreground="#666666"
                               Margin="0,0,0,2" />
                    <TextBlock Text="• Windows Package Manager integration"
                               FontSize="11.5"
                               Foreground="#666666" />
                </StackPanel>

                <!-- Right Square App Tile (100% Matching Screenshot Tile) -->
                <Border Grid.Column="1"
                        Width="86"
                        Height="86"
                        Background="#0078D7"
                        VerticalAlignment="Top"
                        Margin="12,6,0,0">
                    <Grid>
                        <!-- App Icon Image -->
                        <Image Source="Assets/AppIcon-1024.png"
                               Width="62"
                               Height="62"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Middle Progress Section -->
            <StackPanel Grid.Row="2" Margin="32,0,32,10">
                <!-- Status Text (e.g. Installing app package 67%...) -->
                <TextBlock x:Name="TxtStatus"
                           Text="Ready to install"
                           FontSize="12"
                           Foreground="#333333"
                           Margin="0,0,0,6" />

                <!-- Slim Windows Accent Progress Bar -->
                <ProgressBar x:Name="InstallProgressBar"
                             Height="4"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Background="#E6E6E6"
                             Foreground="{StaticResource WindowsBlueBrush}"
                             BorderThickness="0" />
            </StackPanel>

            <!-- Bottom Row: "Launch when ready" Checkbox & Action Buttons -->
            <Grid Grid.Row="3" Margin="32,0,32,16" VerticalAlignment="Center">
                <!-- Left: Launch Checkbox -->
                <CheckBox x:Name="ChkLaunchWhenReady"
                          Style="{StaticResource WinCheckBox}"
                          Content="Launch when ready"
                          IsChecked="False"
                          Visibility="Collapsed"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />

                <!-- Right: Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnInstall"
                            Style="{StaticResource WinPrimaryButton}"
                            Content="Install"
                            Margin="0,0,10,0"
                            Click="BtnInstall_Click" />

                    <Button x:Name="BtnCancel"
                            Style="{StaticResource WinSecondaryButton}"
                            Content="Cancel"
                            Click="BtnCancel_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
