<Window x:Class="WinSetupHub.Setup.UninstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="180Hz Setup Hub"
        Height="360"
        Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI, Arial, sans-serif">

    <Window.Resources>
        <!-- Cyber Carbon, Toxic Neon & Danger Crimson Accent Colors -->
        <Color x:Key="WindowsBlueColor">#00FF66</Color>
        <Color x:Key="WindowsBlueHoverColor">#33FF80</Color>
        <Color x:Key="WindowsBluePressedColor">#00CC52</Color>
        <Color x:Key="WindowsRedColor">#FF2255</Color>
        <Color x:Key="WindowsRedHoverColor">#FF4477</Color>
        <Color x:Key="WindowsRedPressedColor">#CC113F</Color>

        <SolidColorBrush x:Key="WindowsBlueBrush" Color="{StaticResource WindowsBlueColor}" />
        <SolidColorBrush x:Key="WindowsBlueHoverBrush" Color="{StaticResource WindowsBlueHoverColor}" />
        <SolidColorBrush x:Key="WindowsBluePressedBrush" Color="{StaticResource WindowsBluePressedColor}" />
        <SolidColorBrush x:Key="WindowsRedBrush" Color="{StaticResource WindowsRedColor}" />
        <SolidColorBrush x:Key="WindowsRedHoverBrush" Color="{StaticResource WindowsRedHoverColor}" />
        <SolidColorBrush x:Key="WindowsRedPressedBrush" Color="{StaticResource WindowsRedPressedColor}" />

        <!-- Primary Action Button (Toxic Green - for Repair / Launch) -->
        <Style x:Key="WinPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WindowsBlueBrush}" />
            <Setter Property="Foreground" Value="#050B06" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="104" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsBlueHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsBluePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Button (Cyber Crimson - for Uninstall) -->
        <Style x:Key="WinDangerButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WindowsRedBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="104" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsRedHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsRedPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary Button (Cancel / Close) -->
        <Style x:Key="WinSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#161E17" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#212C23" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="104" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#212C23" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#00FF66" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F1410" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Titlebar Buttons -->
        <Style x:Key="WinTitlebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#809283" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#161E17" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#212C23" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinTitlebarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FF2255" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CC113F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#080B08"
            BorderBrush="#212C23"
            BorderThickness="1"
            CornerRadius="8"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.8" />
        </Border.Effect>

        <Grid MouseLeftButtonDown="Window_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" Background="Transparent" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#FF2255" Margin="0,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#FF2255" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="180Hz SETUP HUB // MAINTENANCE &amp; UNINSTALL"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="#B6C9B9"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinTitlebarBtn}" Content="🗖" Foreground="#2A382C" Cursor="Arrow" IsHitTestVisible="False" />
                    <Button x:Name="BtnClose" Style="{StaticResource WinCloseBtn}" Content="✕" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>

            <!-- Upper Content Area -->
            <Grid Grid.Row="1" Margin="32,6,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <TextBlock Text="Modify 180Hz Setup Hub"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Border Background="#0D2E14" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#00FF66" Margin="0,0,4,0"/>
                                <TextBlock Text="VERIFIED SAFE &amp; SECURE" FontSize="10" FontWeight="Bold" Foreground="#00FF66"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="Maintenance Console" FontSize="11" Foreground="#B6C9B9" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Publisher: 180Hz Core Operations" FontSize="12" Foreground="#B6C9B9" Margin="0,0,0,2" />
                    <TextBlock Text="Version: 1.0.0.0 (Production Release)" FontSize="12" Foreground="#B6C9B9" Margin="0,0,0,12" />

                    <TextBlock Text="Available actions:" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,4" />
                    <TextBlock Text="• Repair: Reinstalls fresh files, repairs bugs, restores config and shortcuts" FontSize="11.5" Foreground="#B6C9B9" Margin="0,0,0,2" />
                    <TextBlock Text="• Uninstall: Cleanly removes the application and shortcuts from your PC" FontSize="11.5" Foreground="#B6C9B9" />
                </StackPanel>

                <!-- Right Square App Tile -->
                <Border Grid.Column="1"
                        Width="90"
                        Height="90"
                        Background="#0F1410"
                        BorderBrush="#00FF66"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        VerticalAlignment="Top"
                        Margin="12,4,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#00FF66" BlurRadius="16" ShadowDepth="0" Opacity="0.3" />
                    </Border.Effect>
                    <Image Source="Assets/AppIcon-1024.png"
                           Width="66"
                           Height="66"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
            </Grid>

            <!-- Progress Section -->
            <StackPanel Grid.Row="2" Margin="32,0,32,10">
                <TextBlock x:Name="TxtUninstallStatus"
                           Text="Ready to repair or uninstall"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#B6C9B9"
                           Margin="0,0,0,6" />

                <Border Height="6" Background="#0F1410" BorderBrush="#212C23" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                    <ProgressBar x:Name="UninstallProgressBar"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource WindowsBlueBrush}"
                                 BorderThickness="0" />
                </Border>
            </StackPanel>

            <!-- Bottom Row: Buttons (Repair, Uninstall, Cancel) -->
            <Grid Grid.Row="3" Margin="32,0,32,16" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnRepair"
                            Style="{StaticResource WinPrimaryButton}"
                            Content="Repair"
                            Margin="0,0,10,0"
                            Click="BtnRepair_Click" />

                    <Button x:Name="BtnUninstall"
                            Style="{StaticResource WinDangerButton}"
                            Content="Uninstall"
                            Margin="0,0,10,0"
                            Click="BtnUninstall_Click" />

                    <Button x:Name="BtnCancel"
                            Style="{StaticResource WinSecondaryButton}"
                            Content="Cancel"
                            Click="BtnCancel_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
