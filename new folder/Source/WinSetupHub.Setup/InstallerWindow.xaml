<Window x:Class="WinSetupHub.Setup.InstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="180Hz Setup Hub"
        Height="360"
        Width="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Bahnschrift, Segoe UI Variable Display, Segoe UI, Arial, sans-serif">

    <Window.Resources>
        <!-- Cyber Carbon & Toxic Neon Accent Colors -->
        <Color x:Key="WindowsBlueColor">#00FF66</Color>
        <Color x:Key="WindowsBlueHoverColor">#33FF80</Color>
        <Color x:Key="WindowsBluePressedColor">#00CC52</Color>

        <SolidColorBrush x:Key="WindowsBlueBrush" Color="{StaticResource WindowsBlueColor}" />
        <SolidColorBrush x:Key="WindowsBlueHoverBrush" Color="{StaticResource WindowsBlueHoverColor}" />
        <SolidColorBrush x:Key="WindowsBluePressedBrush" Color="{StaticResource WindowsBluePressedColor}" />

        <!-- Cyber Toxic Primary Action Button -->
        <Style x:Key="WinPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource WindowsBlueBrush}" />
            <Setter Property="Foreground" Value="#050B06" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="104" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsBlueHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource WindowsBluePressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber Dark Secondary Button -->
        <Style x:Key="WinSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#161E17" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#212C23" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="104" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#212C23" />
                                <Setter TargetName="border" Property="BorderBrush" Value="#00FF66" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#0F1410" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Titlebar Caption Buttons -->
        <Style x:Key="WinTitlebarBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#809283" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#161E17" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#212C23" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WinCloseBtn" TargetType="Button" BasedOn="{StaticResource WinTitlebarBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#FF2255" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#CC113F" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cyber High-Contrast CheckBox -->
        <Style x:Key="WinCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="box" Width="16" Height="16" CornerRadius="3"
                                    Background="#0F1410" BorderBrush="#212C23" BorderThickness="1.5"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="chk" Text="✓" FontSize="11" FontWeight="Bold"
                                           Foreground="#050B06" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Margin="0,-1,0,0"
                                           Visibility="Collapsed"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="#00FF66"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="#00FF66"/>
                                <Setter TargetName="chk" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="box" Property="BorderBrush" Value="#00FF66"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Window Border with Cyber Carbon Background & Toxic Ambient Glow -->
    <Border Background="#080B08"
            BorderBrush="#212C23"
            BorderThickness="1"
            CornerRadius="8"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.8" />
        </Border.Effect>

        <Grid MouseLeftButtonDown="Window_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="58" />
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" Background="Transparent" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="7" Height="7" CornerRadius="3.5" Background="#00FF66" Margin="0,0,8,0">
                        <Border.Effect>
                            <DropShadowEffect Color="#00FF66" BlurRadius="6" ShadowDepth="0" Opacity="0.9"/>
                        </Border.Effect>
                    </Border>
                    <TextBlock Text="180Hz SETUP HUB // TACTICAL INSTALLER"
                               FontSize="10.5"
                               FontWeight="Bold"
                               Foreground="#B6C9B9"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMinimize" Style="{StaticResource WinTitlebarBtn}" Content="—" Click="BtnMinimize_Click" />
                    <!-- Disabled Maximize Button -->
                    <Button Style="{StaticResource WinTitlebarBtn}" Content="🗖" Foreground="#2A382C" Cursor="Arrow" IsHitTestVisible="False" />
                    <Button x:Name="BtnClose" Style="{StaticResource WinCloseBtn}" Content="✕" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>

            <!-- Upper Content Area: Details on Left, Square Logo Tile on Right -->
            <Grid Grid.Row="1" Margin="32,6,32,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left Details -->
                <StackPanel Grid.Column="0" VerticalAlignment="Top">
                    <!-- Title -->
                    <TextBlock Text="Install 180Hz Setup Hub?"
                               FontSize="23"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,8" />

                    <!-- Trusted App Badge -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                        <Border Background="#0D2E14" BorderBrush="#00FF66" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="✓" FontSize="11" FontWeight="Bold" Foreground="#00FF66" Margin="0,0,4,0"/>
                                <TextBlock Text="VERIFIED SAFE &amp; SECURE" FontSize="10" FontWeight="Bold" Foreground="#00FF66"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="High-Performance Edition" FontSize="11" Foreground="#B6C9B9" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Publisher & Version -->
                    <TextBlock Text="Publisher: 180Hz Core Operations"
                               FontSize="12"
                               Foreground="#B6C9B9"
                               Margin="0,0,0,2" />
                    <TextBlock Text="Version: 1.0.0.0 (Production Release)"
                               FontSize="12"
                               Foreground="#B6C9B9"
                               Margin="0,0,0,12" />

                    <!-- Capabilities -->
                    <TextBlock Text="Capabilities:"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"
                               Margin="0,0,0,4" />
                    <TextBlock Text="• High-throughput execution &amp; system optimization"
                               FontSize="11.5"
                               Foreground="#B6C9B9"
                               Margin="0,0,0,2" />
                    <TextBlock Text="• Native Windows Package Manager (winget) integration"
                               FontSize="11.5"
                               Foreground="#B6C9B9" />
                </StackPanel>

                <!-- Right Square App Tile (Cyber Surface with Toxic Accent Glow) -->
                <Border Grid.Column="1"
                        Width="90"
                        Height="90"
                        Background="#0F1410"
                        BorderBrush="#00FF66"
                        BorderThickness="1.5"
                        CornerRadius="8"
                        VerticalAlignment="Top"
                        Margin="12,4,0,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#00FF66" BlurRadius="16" ShadowDepth="0" Opacity="0.3" />
                    </Border.Effect>
                    <Grid>
                        <Image Source="Assets/AppIcon-1024.png"
                               Width="66"
                               Height="66"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Middle Progress Section -->
            <StackPanel Grid.Row="2" Margin="32,0,32,10">
                <!-- Status Text -->
                <TextBlock x:Name="TxtStatus"
                           Text="Ready to install"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#B6C9B9"
                           Margin="0,0,0,6" />

                <!-- Slim Toxic Cyber Accent Progress Bar -->
                <Border Height="6" Background="#0F1410" BorderBrush="#212C23" BorderThickness="1" CornerRadius="3" ClipToBounds="True">
                    <ProgressBar x:Name="InstallProgressBar"
                                 Height="4"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 Background="Transparent"
                                 Foreground="#00FF66"
                                 BorderThickness="0" />
                </Border>
            </StackPanel>

            <!-- Bottom Row: "Launch when ready" Checkbox & Action Buttons -->
            <Grid Grid.Row="3" Margin="32,0,32,16" VerticalAlignment="Center">
                <!-- Left: Launch Checkbox -->
                <CheckBox x:Name="ChkLaunchWhenReady"
                          Style="{StaticResource WinCheckBox}"
                          Content="Launch when ready"
                          IsChecked="False"
                          Visibility="Collapsed"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center" />

                <!-- Right: Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnInstall"
                            Style="{StaticResource WinPrimaryButton}"
                            Content="Install"
                            Margin="0,0,10,0"
                            Click="BtnInstall_Click" />

                    <Button x:Name="BtnCancel"
                            Style="{StaticResource WinSecondaryButton}"
                            Content="Cancel"
                            Click="BtnCancel_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
