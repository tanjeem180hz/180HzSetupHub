<UserControl x:Class="SetupHub180Hz.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:services="clr-namespace:SetupHub180Hz.Services">

    <UserControl.Resources>
        <!-- ======================================================== -->
        <!--  1. PROFESSIONAL CYBER-GLASS MODULE TILE STYLE           -->
        <!-- ======================================================== -->
        <Style x:Key="DashboardTile" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="92"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="TileScale" ScaleX="1.0" ScaleY="1.0"/>
                                    <TranslateTransform x:Name="TileTranslate" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <!-- Ambient Cyan Glow Shadow (Blooms on hover) -->
                            <Border x:Name="GlowShadow"
                                    CornerRadius="10"
                                    Margin="2"
                                    Opacity="0"
                                    Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect Color="#00FF66" BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.32"/>
                                </Border.Effect>
                            </Border>

                            <!-- Dark Elevation Depth Shadow -->
                            <Border x:Name="DepthShadow"
                                    CornerRadius="10"
                                    Margin="2"
                                    Opacity="0.4"
                                    Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="4" Direction="270" Opacity="0.55"/>
                                </Border.Effect>
                            </Border>

                            <!-- Main Glass Card Container -->
                            <Border x:Name="TileBorder"
                                    CornerRadius="10"
                                    BorderThickness="1"
                                    Padding="18,16"
                                    SnapsToDevicePixels="True"
                                    ClipToBounds="True"
                                    Background="{DynamicResource BrushSurface}"
                                    BorderBrush="{DynamicResource BrushBorder}">
                                <Grid>
                                    <!-- Ambient Radial Cyber Aura in Top-Right Corner -->
                                    <Ellipse x:Name="RadialAura"
                                             Width="160" Height="160"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,-50,-50,0"
                                             IsHitTestVisible="False"
                                             Opacity="0.05"
                                             Fill="{DynamicResource BrushAccent}"/>

                                    <!-- Top Specular Glass Edge Highlight -->
                                    <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="10,0,10,0" IsHitTestVisible="False"
                                            Background="{DynamicResource BrushAccent}" Opacity="0.25"/>

                                    <!-- Card Content -->
                                    <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!-- MouseOver Hover Pop Up State -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Smooth Elevation Lift (Y: -5) -->
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-5" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- 3D Scale Pop (1.018) -->
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.018" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.018" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Ambient Radial Aura Bloom -->
                                            <DoubleAnimation Storyboard.TargetName="RadialAura"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.38" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Glow Shadow Bloom -->
                                            <DoubleAnimation Storyboard.TargetName="GlowShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1.0" Duration="0:0:0.24">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Depth Shadow -->
                                            <DoubleAnimation Storyboard.TargetName="DepthShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.75" Duration="0:0:0.24"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Return Elevation Lift (Y: 0) -->
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Return Scale (1.0) -->
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuarticEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>

                                            <!-- Dim Radial Aura -->
                                            <DoubleAnimation Storyboard.TargetName="RadialAura"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.05" Duration="0:0:0.22"/>

                                            <!-- Dim Glow Shadow -->
                                            <DoubleAnimation Storyboard.TargetName="GlowShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.0" Duration="0:0:0.22"/>

                                            <!-- Return Depth Shadow -->
                                            <DoubleAnimation Storyboard.TargetName="DepthShadow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0:0:0.22"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Pressed State -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource BrushBorder}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="TileTranslate"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-1" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.992" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetName="TileScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.992" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ======================================================== -->
        <!--  2. INTERACTIVE LIVE SYSTEM STAT CARD STYLE              -->
        <!-- ======================================================== -->
        <Style x:Key="DashboardStatCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="Margin" Value="6,0,6,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                    <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-4" Duration="0:0:0.24">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ======================================================== -->
        <!--  3. HERO COMMAND BANNER STYLE                            -->
        <!-- ======================================================== -->
        <Style x:Key="DashboardHeroCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="26"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-3" Duration="0:0:0.24">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.22">
                                    <DoubleAnimation.EasingFunction>
                                        <QuarticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- ======================================================== -->
    <!--  STAGGERED HIGH-PRECISION ENTRANCE ANIMATIONS            -->
    <!-- ======================================================== -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <!-- 1. Header Block -->
                    <DoubleAnimation Storyboard.TargetName="HeaderBlock"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.32"/>
                    <DoubleAnimation Storyboard.TargetName="HeaderTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="18" To="0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 2. Hero Card -->
                    <DoubleAnimation Storyboard.TargetName="HeroCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.06" Duration="0:0:0.36"/>
                    <DoubleAnimation Storyboard.TargetName="HeroTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="22" To="0" BeginTime="0:0:0.06" Duration="0:0:0.36">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 3. System Stats Section -->
                    <DoubleAnimation Storyboard.TargetName="SystemStatsSection"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.12" Duration="0:0:0.38"/>
                    <DoubleAnimation Storyboard.TargetName="StatsTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="24" To="0" BeginTime="0:0:0.12" Duration="0:0:0.38">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <!-- 4. Command Modules Grid -->
                    <DoubleAnimation Storyboard.TargetName="ModulesSection"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.18" Duration="0:0:0.42"/>
                    <DoubleAnimation Storyboard.TargetName="ModulesTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="28" To="0" BeginTime="0:0:0.18" Duration="0:0:0.42">
                        <DoubleAnimation.EasingFunction>
                            <QuarticEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer Style="{StaticResource CleanScrollViewer}" Padding="32,24,32,32">
        <Grid HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Block with Status -->
            <Grid x:Name="HeaderBlock" Grid.Row="0" Margin="0,0,0,20">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HeaderTransform" Y="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Dashboard" Style="{StaticResource TextHeader}" FontSize="26"/>
                </StackPanel>

                <!-- Engine Status and Refresh Action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnEngineStatus" Tag="180Hz" Style="{StaticResource ExpandableSuccessButton}"
                            ToolTip="Winget Core Engine Active (180Hz Ready) (Click to re-check)" Click="EngineStatus_Click" Margin="0,0,8,0">
                        <Ellipse x:Name="EngineStatusDot" Width="9" Height="9" Fill="{DynamicResource BrushSuccess}" VerticalAlignment="Center"/>
                    </Button>
                    <Button x:Name="RefreshSummaryButton" Tag="Refresh" Style="{StaticResource ExpandableOutlineButton}" Margin="0,0,0,0" Click="RefreshSummary_Click">
                        <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                    services:LottieHelper.AssetName="loading_disc.json"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. Hero Card -->
            <Border x:Name="HeroCard" Grid.Row="1" Style="{StaticResource DashboardHeroCard}">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HeroTransform" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <!-- Ambient Cybernetic Glow Orb in top-right -->
                    <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-140,-100,0" IsHitTestVisible="False" Opacity="0.10"
                             Fill="{DynamicResource BrushAccent}"/>

                    <!-- Top Specular Glass Highlight -->
                    <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="14,0,14,0" IsHitTestVisible="False">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0000FF66" Offset="0.0"/>
                                <GradientStop Color="#00FF66" Offset="0.5"/>
                                <GradientStop Color="#0000FF66" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Grid x:Name="HeroContentGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Tactical Command Overview -->
                        <StackPanel x:Name="HeroOverviewPanel" VerticalAlignment="Center" Margin="0,0,24,0">
                            <!-- Headline with 3 Power Keywords -->
                            <TextBlock FontSize="22" FontWeight="Bold" FontFamily="{StaticResource AppFont}" Margin="0,0,0,16">
                                <Run Text="SETUP" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <Run Text=" • " Foreground="{DynamicResource BrushAccent}"/>
                                <Run Text="OVERDRIVE" Foreground="{DynamicResource BrushAccent}"/>
                                <Run Text=" • " Foreground="{DynamicResource BrushAccent}"/>
                                <Run Text="COMMAND" Foreground="{DynamicResource BrushTextPrimary}"/>
                            </TextBlock>

                            <!-- Interactive Quick Chips -->
                            <WrapPanel Orientation="Horizontal">
                                <!-- Chip 1: Interactive Update Chip (Opens Update Center) -->
                                <Button x:Name="HeroUpdateChip" Style="{StaticResource OutlineButton}" Click="HeroUpdateChip_Click"
                                        Height="34" Padding="12,6" Margin="0,0,10,6"
                                        ToolTip="Click to review and deploy available package updates">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="HeroUpdateIcon" Text="⚡" FontSize="11" Margin="0,0,7,0"
                                                   Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="UpdateSummaryText" Text="Checking for updates…" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushAccent}" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="HeroUpdateArrow" Text=" ➜" FontSize="10"
                                                   Foreground="{DynamicResource BrushAccent}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Chip 2: Interactive Cleanup Shortcut Chip -->
                                <Button x:Name="HeroCleanupChip" Style="{StaticResource OutlineButton}" Click="HeroCleanupChip_Click"
                                        Height="34" Padding="12,6" Margin="0,0,10,6"
                                        ToolTip="Click to open full Disk &amp; Cache Cleanup utility">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <lottie:LottieAnimationView Width="15" Height="15" AutoPlay="True" RepeatCount="-1"
                                                                    services:LottieHelper.AssetName="cleanup_sparkle.json" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Deep Cleanup" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <!-- Chip 3: Architecture Chip -->
                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,0,6"
                                        ToolTip="Native x64 high-performance architecture">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <lottie:LottieAnimationView Width="15" Height="15" AutoPlay="True" RepeatCount="-1"
                                                                    services:LottieHelper.AssetName="windows_logo.json" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Windows 64-bit" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource BrushTextSecondary}" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Right: Tactical Telemetry & Quick Optimizer Pod -->
                        <Border x:Name="HeroTelemetryPod" Grid.Column="1" Width="300" CornerRadius="10" Padding="16,14" VerticalAlignment="Center" SnapsToDevicePixels="True"
                                Background="{DynamicResource BrushBackground}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#00FF66" BlurRadius="16" ShadowDepth="0" Opacity="0.18"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Top Row: Animated Lottie Visual + Active Modules Info -->
                                <Grid Grid.Row="0" Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Animated Radar / Pulse Ring Frame -->
                                    <Border Grid.Column="0" Width="54" Height="54" CornerRadius="27"
                                            Background="{DynamicResource BrushSurfaceHover}"
                                            BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" Margin="0,0,14,0" SnapsToDevicePixels="True">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00FF66" BlurRadius="12" ShadowDepth="0" Opacity="0.3"/>
                                        </Border.Effect>
                                        <lottie:LottieAnimationView Width="38" Height="38" AutoPlay="True" RepeatCount="-1"
                                                                    services:LottieHelper.AssetName="startup_boost.json"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Metrics Column -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="ModuleCountText" Text="8" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"
                                                       FontFamily="{StaticResource AppFont}" Margin="0,0,6,0"/>
                                            <TextBlock Text="MODULES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"
                                                       FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>

                                <!-- Bottom Row: Quick Boost Button -->
                                <Button Grid.Row="1" x:Name="BtnQuickBoost" Style="{StaticResource AccentButton}" Click="BtnQuickBoost_Click"
                                        Height="34" Padding="12,0"
                                        ToolTip="Instantly sweep temporary junk files and refresh telemetry">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock x:Name="BoostIcon" Text="⚡" FontSize="12" FontWeight="Bold" Margin="0,0,6,0"
                                                   Foreground="{DynamicResource BrushAccentForeground}"/>
                                        <TextBlock x:Name="TxtQuickBoostBtn" Text="OPTIMIZE" FontSize="11.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource BrushAccentForeground}" FontFamily="{StaticResource AppFont}"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <!-- 2b. Live System Stats -->
            <UniformGrid x:Name="SystemStatsSection" Grid.Row="2" Columns="3" Margin="-6,0,-6,24">
                <UniformGrid.RenderTransform>
                    <TranslateTransform x:Name="StatsTransform" Y="0"/>
                </UniformGrid.RenderTransform>

                <!-- 1. CPU Usage -->
                <Border Style="{StaticResource DashboardStatCard}">
                    <Grid>
                        <!-- Specular Edge -->
                        <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="6,0,6,0" IsHitTestVisible="False"
                                Background="{DynamicResource BrushAccent}" Opacity="0.25"/>

                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="wave.json"
                                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CPU LOAD" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                                <TextBlock x:Name="CpuPercentText" Text="0.0%" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock Text=" active" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" x:Name="CpuProgressBar" Style="{StaticResource FlatProgressBar}"
                                         Minimum="0" Maximum="100" Value="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 2. Memory Usage -->
                <Border Style="{StaticResource DashboardStatCard}">
                    <Grid>
                        <!-- Specular Edge -->
                        <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="6,0,6,0" IsHitTestVisible="False"
                                Background="{DynamicResource BrushAccent}" Opacity="0.25"/>

                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="gears.json"
                                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MEMORY (RAM)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                                <TextBlock x:Name="RamUsageText" Text="0.0 / 0.0 GB" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="RamPercentText" Text=" (0%)" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" x:Name="RamProgressBar" Style="{StaticResource FlatProgressBar}"
                                         Minimum="0" Maximum="100" Value="0"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 3. Disk Space (C:) -->
                <Border Style="{StaticResource DashboardStatCard}">
                    <Grid>
                        <!-- Specular Edge -->
                        <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch" Margin="6,0,6,0" IsHitTestVisible="False"
                                Background="{DynamicResource BrushAccent}" Opacity="0.25"/>

                        <Grid Margin="0,2,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="scan.json"
                                                            Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="DISK (C:)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                                <TextBlock x:Name="DiskUsageText" Text="0.0 GB Free" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Bottom"/>
                                <TextBlock x:Name="DiskTotalText" Text=" of 0.0 GB" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" x:Name="DiskProgressBar" Style="{StaticResource FlatProgressBar}"
                                         Minimum="0" Maximum="100" Value="0"/>
                        </Grid>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- 3. Modules Section -->
            <StackPanel x:Name="ModulesSection" Grid.Row="3">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ModulesTransform" Y="0"/>
                </StackPanel.RenderTransform>

                <Grid Margin="0,0,0,14">
                    <TextBlock Text="COMMAND MODULES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                </Grid>

                <!-- 8 Responsive Module Tiles in Dynamic UniformGrid -->
                <UniformGrid x:Name="ModulesGrid" Columns="4" Rows="2" Margin="-6,0,-6,0">
                    <!-- 01 Setup Apps -->
                    <Button x:Name="TileSetupApps" Style="{StaticResource DashboardTile}" Margin="6" Click="TileSetupApps_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="01" Foreground="{DynamicResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="gears.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Setup Apps" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,16,0,2" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>

                    <!-- 02 Downloads -->
                    <Button x:Name="TileDownloads" Style="{StaticResource DashboardTile}" Margin="6" Click="TileDownloads_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="02" Foreground="{DynamicResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="download_flow.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Downloads" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,16,0,2" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>

                    <!-- 03 Update Center -->
                    <Button x:Name="TileUpdateCenter" Style="{StaticResource DashboardTile}" Margin="6" Click="TileUpdateCenter_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="03" Foreground="{DynamicResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="update_sync.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Update Center" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,16,0,2" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>

                    <!-- 04 Uninstaller -->
                    <Button x:Name="TileUninstaller" Style="{StaticResource DashboardTile}" Margin="6" Click="TileUninstaller_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="04" Foreground="{DynamicResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="uninstaller_bin.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Uninstaller" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,16,0,2" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>

                    <!-- 05 Startup Apps -->
                    <Button x:Name="TileStartup" Style="{StaticResource DashboardTile}" Margin="6" Click="TileStartup_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="05" Foreground="{DynamicResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="startup_boost.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Startup Apps" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,16,0,2" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>

                    <!-- 06 Cleanup -->
                    <Button x:Name="TileCleanup" Style="{StaticResource DashboardTile}" Margin="6" Click="TileCleanup_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="06" Foreground="{DynamicResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="cleanup_sparkle.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Cleanup" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,16,0,2" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>

                    <!-- 07 Activity -->
                    <Button x:Name="TileActivity" Style="{StaticResource DashboardTile}" Margin="6" Click="TileActivity_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="07" Foreground="{DynamicResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="activity_pulse.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Activity" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,16,0,2" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>

                    <!-- 08 Storage -->
                    <Button x:Name="TileStorage" Style="{StaticResource DashboardTile}" Margin="6" Click="TileStorage_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="08" Foreground="{DynamicResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="scan.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Storage" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,16,0,2" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>

                    <!-- 09 Optimization -->
                    <Button x:Name="TileOptimization" Style="{StaticResource DashboardTile}" Margin="6" Click="TileOptimization_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="09" Foreground="{DynamicResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="rocket.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{DynamicResource BrushAccent}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Optimization" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource BrushTextPrimary}" Margin="0,16,0,2" VerticalAlignment="Bottom"/>
                        </Grid>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
