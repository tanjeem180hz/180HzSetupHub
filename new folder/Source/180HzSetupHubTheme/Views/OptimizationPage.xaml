<UserControl x:Class="SetupHub180Hz.Views.OptimizationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SetupHub180Hz.Models"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:services="clr-namespace:SetupHub180Hz.Services">

    <UserControl.Resources>

        <!-- Category chip radio buttons -->
        <Style x:Key="TweakCategoryChip" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="TweakCategories"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurface}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tweak row toggle switch style -->
        <Style x:Key="TweakToggle" TargetType="{x:Type CheckBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                Background="{StaticResource BrushBorder}" Cursor="Hand">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#6B7280"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tweak card container -->
        <Style x:Key="TweakCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Apply button -->
        <Style x:Key="ApplyButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#0A0E17"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary/Undo button -->
        <Style x:Key="UndoButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ApplyButton}">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Advanced warning badge -->
        <Style x:Key="AdvancedBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#1F1500"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== PAGE HEADER ===== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="24,16,24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Optimization" FontFamily="{StaticResource AppFont}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock x:Name="TxtSubtitle" Margin="0,2,0,0"
                               FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <!-- Select All -->
                    <Button x:Name="BtnSelectAll" Style="{StaticResource UndoButton}"
                            Content="SELECT ALL" Padding="12,7" Margin="0,0,8,0"
                            Click="BtnSelectAll_Click"/>
                    <!-- Deselect All -->
                    <Button x:Name="BtnDeselectAll" Style="{StaticResource UndoButton}"
                            Content="DESELECT ALL" Padding="12,7" Margin="0,0,8,0"
                            Click="BtnDeselectAll_Click"/>
                    <!-- Undo / Restore -->
                    <Button x:Name="BtnUndoSelected" Style="{StaticResource UndoButton}"
                            Content="UNDO SELECTED" Padding="12,7" Margin="0,0,8,0"
                            Click="BtnUndoSelected_Click"/>
                    <!-- Apply -->
                    <Button x:Name="BtnApplySelected" Style="{StaticResource ApplyButton}"
                            Content="APPLY SELECTED" Padding="14,7"
                            Click="BtnApplySelected_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== BODY ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Category Filter Bar -->
                <Border Grid.Row="0" Padding="24,12,24,10"
                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                        Background="{DynamicResource BrushBackground}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal"/>
                    </ScrollViewer>
                </Border>

                <!-- Tweak List -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="24,16,24,24">
                    <StackPanel>

                        <!-- Progress / Status bar -->
                        <Border x:Name="StatusBar" Margin="0,0,0,14"
                                Background="{DynamicResource BrushSurface}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="TxtStatus"
                                           FontFamily="{StaticResource AppFont}" FontSize="13"
                                           Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <lottie:LottieAnimationView x:Name="StatusLottie" Width="22" Height="22"
                                                                AutoPlay="True" RepeatCount="-1"
                                                                services:LottieHelper.AssetName="startup_boost.json"
                                                                VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Advanced Tweaks Warning -->
                        <Border x:Name="AdvancedWarningBanner" Margin="0,0,0,14"
                                Background="#1A0F00" BorderBrush="#92400E" BorderThickness="1"
                                CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠" FontSize="16" Margin="0,0,10,0"
                                           Foreground="#F59E0B" VerticalAlignment="Center"/>
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                           FontFamily="{StaticResource AppFont}" FontSize="12"
                                           Foreground="#F59E0B">
                                    <Run FontWeight="Bold">Advanced Tweaks (Caution):</Run>
                                    <Run> These tweaks modify system-level settings. Create a restore point before applying. Use at your own risk.</Run>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Tweaks ItemsControl -->
                        <ItemsControl x:Name="TweaksItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:TweakItem}">
                                    <Border Style="{StaticResource TweakCard}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontFamily="{StaticResource AppFont}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource BrushTextPrimary}"
                                                               VerticalAlignment="Center"/>
                                                    <!-- Advanced badge -->
                                                    <Border Style="{StaticResource AdvancedBadge}"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="CAUTION" FontSize="9" FontWeight="Bold"
                                                                   Foreground="#F59E0B"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Description}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="11" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource BrushTextSecondary}"
                                                           Margin="0,3,0,0" MaxWidth="700"/>
                                            </StackPanel>

                                            <!-- Toggle -->
                                            <CheckBox Grid.Column="1" Style="{StaticResource TweakToggle}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                    HorizontalAlignment="Center" Margin="0,60,0,0">
                            <TextBlock Text="No tweaks in this category" FontSize="16"
                                       FontFamily="{StaticResource AppFont}"
                                       Foreground="{DynamicResource BrushTextSecondary}"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
