<UserControl x:Class="SetupHub180Hz.Views.OptimizationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SetupHub180Hz.Models"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:services="clr-namespace:SetupHub180Hz.Services">

    <UserControl.Resources>

        <!-- Top Section Tab Switcher (System Tweaks vs Registry Optimization) -->
        <Style x:Key="OptimizationSectionTab" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="OptimizationSectionGroup"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="#0A0E17"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category chip radio buttons -->
        <Style x:Key="TweakCategoryChip" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="TweakCategories"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurface}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tweak row toggle switch style -->
        <Style x:Key="TweakToggle" TargetType="{x:Type CheckBox}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border x:Name="Track" Width="38" Height="20" CornerRadius="10"
                                Background="{StaticResource BrushBorder}" Cursor="Hand">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="#6B7280"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BrushAccent}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="White"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tweak card container -->
        <Style x:Key="TweakCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Apply button (Primary Accent) -->
        <Style x:Key="ApplyButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#0A0E17"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action button -->
        <Style x:Key="UndoButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ApplyButton}">
            <Setter Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Danger / Restore button -->
        <Style x:Key="DangerButton" TargetType="{x:Type Button}" BasedOn="{StaticResource ApplyButton}">
            <Setter Property="Background" Value="#2D1515"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Advanced warning badge -->
        <Style x:Key="AdvancedBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#1F1500"/>
            <Setter Property="BorderBrush" Value="#F59E0B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Recommended badge -->
        <Style x:Key="RecommendedBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Applied badge style -->
        <Style x:Key="AppliedBadge" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#1A00FF66"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== PAGE HEADER ===== -->
        <Border Grid.Row="0" Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                Padding="24,14,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtHeaderTitle" Text="Optimization" FontFamily="{StaticResource AppFont}"
                               FontSize="22" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}"/>
                    <TextBlock x:Name="TxtSubtitle" Margin="0,2,0,0"
                               FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{DynamicResource BrushTextSecondary}"/>
                </StackPanel>

                <!-- Actions WrapPanel -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                    <!-- Create Restore Point Safeguard -->
                    <Button x:Name="BtnCreateRestorePoint" Style="{StaticResource UndoButton}"
                            Content="🛡️ RESTORE POINT" Padding="10,7" Margin="0,0,6,4"
                            Click="BtnCreateRestorePoint_Click" ToolTip="Create a Windows System Restore point before applying changes"/>

                    <!-- Open Backups Folder -->
                    <Button x:Name="BtnOpenBackups" Style="{StaticResource UndoButton}"
                            Content="📁 BACKUPS" Padding="10,7" Margin="0,0,6,4"
                            Click="BtnOpenBackups_Click" ToolTip="Open the folder containing automatic .reg snapshots and pre-state backups"/>

                    <!-- Select All -->
                    <Button x:Name="BtnSelectAll" Style="{StaticResource UndoButton}"
                            Content="✓ SELECT ALL" Padding="10,7" Margin="0,0,6,4"
                            Click="BtnSelectAll_Click" ToolTip="Select all visible tweaks in this section"/>

                    <!-- Deselect All / Clear -->
                    <Button x:Name="BtnDeselectAll" Style="{StaticResource UndoButton}"
                            Content="✕ DESELECT ALL" Padding="10,7" Margin="0,0,6,4"
                            Click="BtnDeselectAll_Click" ToolTip="Deselect all checkboxes in this section"/>

                    <!-- Select Recommended -->
                    <Button x:Name="BtnSelectRecommended" Style="{StaticResource UndoButton}"
                            Content="⭐ RECOMMENDED" Padding="10,7" Margin="0,0,6,4"
                            Click="BtnSelectRecommended_Click" ToolTip="Select recommended safe optimizations"/>

                    <!-- Undo / Restore Selected -->
                    <Button x:Name="BtnUndoSelected" Style="{StaticResource DangerButton}"
                            Content="↩ RESTORE SELECTED" Padding="10,7" Margin="0,0,6,4"
                            Click="BtnUndoSelected_Click" ToolTip="Revert only checked tweaks back to standard Windows defaults"/>

                    <!-- Restore All Default -->
                    <Button x:Name="BtnRestoreDefault" Style="{StaticResource DangerButton}"
                            Content="🔄 RESTORE ALL" Padding="10,7" Margin="0,0,6,4"
                            Click="BtnRestoreDefault_Click" ToolTip="Restore all tweaks in this section back to factory defaults"/>

                    <!-- 🚀 100% EXTREME BOOST (Force 100% PC Performance) -->
                    <Button x:Name="BtnExtremeBoost" Style="{StaticResource ApplyButton}"
                            Background="{DynamicResource BrushAccent}" Foreground="#0A0E17"
                            Content="🚀 100% EXTREME BOOST" Padding="15,7" Margin="0,0,6,4"
                            Click="BtnExtremeBoost_Click" ToolTip="Force 100% PC Performance: One-click deploy all high-impact latency, CPU unparking, GPU overdrive, zero-ping network &amp; bloatware elimination tweaks!"/>

                    <!-- 🔒 LOCK PERMANENT (Survives Reboot) -->
                    <Button x:Name="BtnHeaderLockPermanence" Style="{StaticResource ApplyButton}"
                            Background="#00C853" Foreground="#0A0E17"
                            Content="🔒 LOCK PERMANENT" Padding="14,7" Margin="0,0,6,4"
                            Click="BtnLockPermanence_Click" ToolTip="Lock power unparking, network zero-ping heuristics &amp; scheduling permanently across every PC restart!"/>

                    <!-- 🎮 2X FPS GAMING OVERDRIVE (0.5ms Timer + Max FPS) -->
                    <Button x:Name="Btn2xFpsOverdrive" Style="{StaticResource ApplyButton}"
                            Background="#FF0055" Foreground="#FFFFFF"
                            Content="🎮 2X FPS GAMING OVERDRIVE" Padding="15,7" Margin="0,0,6,4"
                            Click="Btn2xFpsOverdrive_Click" ToolTip="Lock 0.500ms High-Precision Timer, purge Standby RAM, set GPU Priority 8 &amp; activate 180Hz 2X FPS Power Scheme for silky smooth stutter-free gaming!"/>

                    <!-- Apply Selected (Primary Action) -->
                    <Button x:Name="BtnApplySelected" Style="{StaticResource ApplyButton}"
                            Content="⚡ APPLY SELECTED" Padding="14,7" Margin="0,0,6,4"
                            Click="BtnApplySelected_Click" ToolTip="Apply all checked optimizations to your PC"/>

                    <!-- Apply All -->
                    <Button x:Name="BtnApplyAll" Style="{StaticResource UndoButton}"
                            Content="🚀 APPLY ALL" Padding="12,7" Margin="0,0,0,4"
                            Click="BtnApplyAll_Click" ToolTip="Apply all optimizations in this section"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- ===== BODY ===== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Section Switcher & Search Bar -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Category Filter Bar -->
                <RowDefinition Height="*"/>    <!-- Row 2: Tweak List ScrollViewer -->
            </Grid.RowDefinitions>

            <!-- Row 0: Section Switcher (System Tweaks vs Registry Optimization) & Live Search Filter -->
            <Border Grid.Row="0" Padding="24,10,24,10"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource BrushSurface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 4-Section Segmented Pill Switcher -->
                    <Border Grid.Column="0" Background="{DynamicResource BrushBackground}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="3">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="TabPermanent" Style="{StaticResource OptimizationSectionTab}"
                                         Content="🔒 Permanent System (Survives Reboot)" IsChecked="True"
                                         Checked="SectionTab_Checked" Tag="Permanent"
                                         ToolTip="Lock core CPU unparking, power plan, BCD, and network tweaks permanently so they survive every PC restart!"/>
                            <RadioButton x:Name="TabPreGame" Style="{StaticResource OptimizationSectionTab}"
                                         Content="🎮 Pre-Game Booster (1-Click Boost)"
                                         Checked="SectionTab_Checked" Tag="PreGame"
                                         ToolTip="1-Click apply after PC startup or before entering games: 0.5ms Timer, Standby RAM purge, GPU Priority 8 &amp; game priority boost!"/>
                            <RadioButton x:Name="TabSystemTweaks" Style="{StaticResource OptimizationSectionTab}"
                                         Content="⚡ System Tweaks"
                                         Checked="SectionTab_Checked" Tag="System"
                                         ToolTip="Comprehensive Windows system, gaming, and app optimizations"/>
                            <RadioButton x:Name="TabRegistryTweaks" Style="{StaticResource OptimizationSectionTab}"
                                         Content="🗃️ Registry Tweaks"
                                         Checked="SectionTab_Checked" Tag="Registry"
                                         ToolTip="Dedicated Windows Registry tweaks for latency, ping, and hardware speed"/>
                        </StackPanel>
                    </Border>

                    <!-- Section Description Pill -->
                    <Border Grid.Column="1" VerticalAlignment="Center" Margin="16,0,16,0">
                        <TextBlock x:Name="TxtSectionDescription"
                                   Text="System and general Windows environment optimizations."
                                   FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <!-- Search Filter Box -->
                    <Border Grid.Column="2" Background="{DynamicResource BrushBackground}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="6" Width="260" Height="32" Padding="8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                                       VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox x:Name="FilterBox" Grid.Column="1"
                                     Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     CaretBrush="{DynamicResource BrushAccent}"
                                     FontFamily="{StaticResource AppFont}" FontSize="12"
                                     VerticalAlignment="Center"
                                     TextChanged="FilterBox_TextChanged"/>
                            <TextBlock Grid.Column="1" Text="Search tweaks or registry keys…"
                                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                                       Opacity="0.5" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text.IsEmpty, ElementName=FilterBox, Converter={StaticResource BoolToVis}}"/>
                            <Button x:Name="ClearFilterButton" Grid.Column="2" Content="✕"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource BrushTextSecondary}"
                                    Cursor="Hand" FontSize="10" Padding="4,0"
                                    VerticalAlignment="Center" Visibility="Collapsed"
                                    Click="ClearFilter_Click"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Row 1: Category Filter Bar + Quick Select Helpers -->
            <Border Grid.Row="1" Padding="24,10,24,10"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource BrushBackground}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <!-- Quick Select Recommended Helper -->
                    <Button Grid.Column="1" x:Name="BtnCategoryRecommended" Style="{StaticResource UndoButton}"
                            Content="SELECT RECOMMENDED" Padding="10,5" Margin="8,0,0,0"
                            Click="BtnSelectRecommended_Click" ToolTip="Select recommended safe tweaks in this view"/>
                </Grid>
            </Border>

            <!-- Row 2: Tweak List -->
            <ScrollViewer x:Name="TweaksScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="24,16,24,24">
                <StackPanel>

                    <!-- Progress / Status bar -->
                    <Border x:Name="StatusBar" Margin="0,0,0,14"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtStatus"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <lottie:LottieAnimationView x:Name="StatusLottie" Width="22" Height="22"
                                                            AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="rocket.json"
                                                            VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 🔒 PERMANENT BOOT SAFEGUARD BANNER (Survives PC Restart) -->
                    <Border x:Name="PermanentSafeguardBanner" Margin="0,0,0,16"
                            Background="#0B1612" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.5"
                            CornerRadius="10" Padding="18,16" Visibility="Visible">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header Row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔒" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="PERMANENT BOOT SAFEGUARD ENGINE"
                                               FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" x:Name="BadgePermanentStatus" Background="#1A00FF66" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1"
                                        CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtPermanentStatus" Text="STATUS: 🔒 ACTIVE &amp; LOCKED"
                                               FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushAccent}"/>
                                </Border>
                            </Grid>

                            <!-- Description Row -->
                            <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}">
                                Locks 100% Core Unparking, enables dynamic 5.0GHz+ Precision Boost (0ms latency), disables GPU ULPS power throttling, and sets zero-ping network heuristics into a high-privilege Windows Startup Task (<Run FontFamily="Consolas" Foreground="{DynamicResource BrushAccent}">180Hz_Permanence_Guard</Run>).
                                <LineBreak/>
                                <Run FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}">Once locked, these optimizations automatically survive every PC restart or Windows shutdown permanently without ever needing to re-open the app!</Run>
                            </TextBlock>

                            <!-- Actions Row -->
                            <WrapPanel Grid.Row="2" Orientation="Horizontal">
                                <Button x:Name="BtnLockPermanence" Style="{StaticResource ApplyButton}"
                                        Content="🔒 LOCK PERMANENT OPTIMIZATIONS (SURVIVES RESTART)"
                                        Padding="18,9" Margin="0,0,10,6" Click="BtnLockPermanence_Click"
                                        ToolTip="Registers the Windows Boot Safeguard Task and locks all power, network, timer and scheduler optimizations permanently!"/>
                                <Button x:Name="BtnUnlockPermanence" Style="{StaticResource DangerButton}"
                                        Content="🔓 REMOVE BOOT SAFEGUARD"
                                        Padding="14,9" Margin="0,0,10,6" Click="BtnUnlockPermanence_Click"
                                        ToolTip="Removes the automatic boot persistence scheduled task"/>
                                <Button x:Name="BtnTestBootScript" Style="{StaticResource UndoButton}"
                                        Content="⚡ TEST BOOT SCRIPT"
                                        Padding="12,9" Margin="0,0,0,6" Click="BtnTestBootScript_Click"
                                        ToolTip="Runs the boot persistence script immediately to verify 100% core unparking &amp; network locks"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- 🎮 PRE-GAME LAUNCH CONTROL BANNER (1-Click Boost Before Gaming) -->
                    <Border x:Name="PreGameBoosterBanner" Margin="0,0,0,16"
                            Background="#160B14" BorderBrush="#FF0055" BorderThickness="1.5"
                            CornerRadius="10" Padding="18,16" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header Row -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🎮" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="1-CLICK PRE-GAME LAUNCH OVERDRIVE"
                                               FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="#2A0015" BorderBrush="#FF0055" BorderThickness="1"
                                        CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ INSTANT 2X FPS GAMING ENGINE"
                                               FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold"
                                               Foreground="#FF0055"/>
                                </Border>
                            </Grid>

                            <!-- Description Row -->
                            <TextBlock Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap"
                                       FontFamily="{StaticResource AppFont}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}">
                                Just turned on your PC or about to launch a game? Click once below to lock <Run FontWeight="Bold" Foreground="#00FF66">0.500ms high-precision kernel timer resolution</Run>, unlock <Run FontWeight="Bold" Foreground="#00FF66">5.0GHz dynamic CPU Turbo Boost</Run>, release <Run FontWeight="Bold" Foreground="#00FF66">100% GPU utilization (ULPS Off)</Run>, flush <Run FontWeight="Bold" Foreground="#00FF66">Standby RAM stutter cache</Run>, and elevate all games to High Priority.
                            </TextBlock>

                            <!-- Live Telemetry Badges Grid -->
                            <UniformGrid Grid.Row="2" Columns="4" Margin="0,0,0,14">
                                <!-- Badge 1: Timer Res -->
                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="10,10" Margin="0,0,4,0">
                                    <StackPanel>
                                        <TextBlock Text="KERNEL TIMER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtLiveTimerRes" Text="0.500 ms (Locked ✓)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,3,0,0"/>
                                        <TextBlock Text="0.5ms zero frame jitter" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Badge 2: CPU Turbo Boost -->
                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="10,10" Margin="2,0,2,0">
                                    <StackPanel>
                                        <TextBlock Text="CPU TURBO BOOST" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtLiveCpuBoost" Text="5.0 GHz Unlocked ✓" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,3,0,0"/>
                                        <TextBlock Text="Dynamic Precision Scaling" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Badge 3: GPU Utilization -->
                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="10,10" Margin="2,0,2,0">
                                    <StackPanel>
                                        <TextBlock Text="GPU UTILIZATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtLiveGpuMode" Text="100% Max Mode ✓" FontSize="13" FontWeight="Bold" Foreground="#00E5FF" Margin="0,3,0,0"/>
                                        <TextBlock Text="ULPS Off • Max Perf" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Badge 4: Standby RAM & Games -->
                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="8" Padding="10,10" Margin="4,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="MEMORY &amp; GAMES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtLiveDetectedGames" Text="Standby Purged ✓" FontSize="13" FontWeight="Bold" Foreground="#FFD700" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="TxtLiveStandbyRam" Text="Elevated to High Priority" FontSize="9.5" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Actions Row -->
                            <WrapPanel Grid.Row="3" Orientation="Horizontal">
                                <Button x:Name="BtnRunPreGameBoost" Style="{StaticResource ApplyButton}"
                                        Background="#FF0055" Foreground="#FFFFFF"
                                        Content="🚀 1-CLICK PRE-GAME TURBO BOOST (ACTIVATE NOW)"
                                        Padding="18,9" Margin="0,0,10,6" Click="BtnRunPreGameBoost_Click"
                                        ToolTip="Instantly locks 0.500ms kernel timer, clears Standby RAM, activates 180Hz power scheme, and sets game process priority!"/>
                                <Button x:Name="BtnPurgeStandbyRam" Style="{StaticResource UndoButton}"
                                        Content="🧹 PURGE RAM CACHE ONLY"
                                        Padding="14,9" Margin="0,0,10,6" Click="BtnPurgeStandbyRam_Click"
                                        ToolTip="Instantly purges standby list memory and working sets to free up RAM before gaming"/>
                                <Button x:Name="BtnRefreshPreGameStats" Style="{StaticResource UndoButton}"
                                        Content="🔄 REFRESH GAME SCAN"
                                        Padding="12,9" Margin="0,0,0,6" Click="BtnRefreshPreGameStats_Click"
                                        ToolTip="Scan running processes for active games and refresh timer resolution telemetry"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Advanced Tweaks Warning -->
                    <Border x:Name="AdvancedWarningBanner" Margin="0,0,0,14"
                            Background="#1A0F00" BorderBrush="#92400E" BorderThickness="1"
                            CornerRadius="8" Padding="14,10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="16" Margin="0,0,10,0"
                                       Foreground="#F59E0B" VerticalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                       FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="#F59E0B">
                                <Run FontWeight="Bold">Advanced Optimization (Caution):</Run>
                                <Run> These tweaks tune deep Windows scheduling, drivers, or kernel configurations. Use recommended tweaks for safe daily operation.</Run>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Tweaks ItemsControl -->
                    <ItemsControl x:Name="TweaksItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TweakItem}">
                                <Border Style="{StaticResource TweakCard}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}"
                                                           FontFamily="{StaticResource AppFont}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource BrushTextPrimary}"
                                                           VerticalAlignment="Center"/>
                                                <!-- Applied status badge -->
                                                <Border Style="{StaticResource AppliedBadge}"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="✓" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,0,3,0"/>
                                                        <TextBlock Text="APPLIED" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Recommended badge -->
                                                <Border Style="{StaticResource RecommendedBadge}"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="RECOMMENDED" FontSize="9" FontWeight="Bold"
                                                               Foreground="{DynamicResource BrushAccent}"/>
                                                </Border>
                                                <!-- Advanced badge -->
                                                <Border Style="{StaticResource AdvancedBadge}"
                                                        Margin="8,0,0,0"
                                                        Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="CAUTION" FontSize="9" FontWeight="Bold"
                                                               Foreground="#F59E0B"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Description -->
                                            <TextBlock Text="{Binding Description}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource BrushTextSecondary}"
                                                       Margin="0,3,0,0" MaxWidth="720"/>

                                            <!-- Registry target badge (visible when tweak has registry key definitions) -->
                                            <Border Background="{DynamicResource BrushBackground}"
                                                    BorderBrush="{DynamicResource BrushBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    Margin="0,5,0,0"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding HasRegistryTarget, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="🔑" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="{Binding FormattedRegistryTarget}"
                                                               FontFamily="Consolas"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource BrushAccent}"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <!-- Toggle switch -->
                                        <CheckBox Grid.Column="1" Style="{StaticResource TweakToggle}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" Visibility="Collapsed"
                                HorizontalAlignment="Center" Margin="0,60,0,0">
                        <TextBlock Text="No tweaks match your filter" FontSize="15"
                                   FontFamily="{StaticResource AppFont}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
