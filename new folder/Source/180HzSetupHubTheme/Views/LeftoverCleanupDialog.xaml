<Window x:Class="SetupHub180Hz.Views.LeftoverCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deep Clean Leftovers"
        Width="680" Height="580"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        ShowInTaskbar="False">

    <Border Background="{StaticResource BrushBackground}"
            BorderBrush="{StaticResource BrushAccent}"
            BorderThickness="1"
            CornerRadius="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="8" Opacity="0.7"/>
        </Border.Effect>

        <Grid Margin="24,20,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="Auto"/> <!-- Warning Banner -->
                <RowDefinition Height="Auto"/> <!-- Quick Action Bar -->
                <RowDefinition Height="*"/>    <!-- Leftovers List -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- 1. Header / Title Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="DialogTitleText" Text="Leftovers Detected" Style="{StaticResource TextHeader}" FontSize="20"/>
                    <TextBlock x:Name="DialogSubtitleText" Text="Review leftover traces detected after application uninstallation." Style="{StaticResource TextBody}" Margin="0,2,0,0"/>
                </StackPanel>

                <!-- Close Button -->
                <Button x:Name="DialogCloseButton" Grid.Column="1" Content="✕" Width="30" Height="30"
                        Style="{StaticResource CloseCaptionButton}"
                        VerticalAlignment="Top"
                        Click="SkipButton_Click"/>
            </Grid>

            <!-- 2. Warning Banner -->
            <Border Grid.Row="1" Background="#20F5B84C" BorderBrush="{StaticResource BrushWarning}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="⚠️" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="These matches are based on name similarity. Review before deleting — entries can belong to unrelated software that happens to share a word."
                               FontSize="11" LineHeight="16" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            <!-- 3. Toolbar (Counts & Quick Select) -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CountSummaryText" Text="0 items found" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="SelectAllBtn" Content="Select All" Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="SelectAll_Click"/>
                    <Button x:Name="DeselectAllBtn" Content="Deselect All" Style="{StaticResource OutlineButton}" Padding="10,4" FontSize="11" Click="DeselectAll_Click"/>
                </StackPanel>
            </Grid>

            <!-- 4. Leftover Items ListBox -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="6" Margin="0,0,0,16">
                <ListBox x:Name="LeftoversListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="4,3"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,4"
                                    Opacity="{Binding ItemOpacity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Selection CheckBox (Hidden during/after processing) -->
                                    <CheckBox IsChecked="{Binding IsSelected}" Visibility="{Binding CheckBoxVisibility}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- Status indicator icon in place of CheckBox when processing/done -->
                                    <Border Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="{Binding StatusBadgeVisibility}">
                                        <TextBlock Text="{Binding StatusBadgeText, Converter={x:Null}}"
                                                   FontSize="12" FontWeight="Bold"
                                                   Foreground="{Binding BadgeForeground}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="⚡"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDeleted}" Value="True">
                                                            <Setter Property="Text" Value="✓"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                                                            <Setter Property="Text" Value="⚠️"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Details -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Text="{Binding TypeIcon}" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TypeName}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                            <Border Background="{StaticResource BrushBackground}" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding MatchedOn, StringFormat='Matched on: {0}'}" FontSize="10" Foreground="{StaticResource BrushAccent}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                    </StackPanel>

                                    <!-- Right side: Size and Status Badge -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,4,0">
                                        <TextBlock Text="{Binding SizeDisplay}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                        <Border Background="{Binding BadgeBackground}" BorderBrush="{Binding BadgeForeground}" BorderThickness="1"
                                                CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                                Visibility="{Binding StatusBadgeVisibility}">
                                            <TextBlock Text="{Binding StatusBadgeText}" FontSize="10" FontWeight="Bold" Foreground="{Binding BadgeForeground}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 5. Footer Actions & Animated Progress Bar -->
            <Grid Grid.Row="4">
                <!-- A. Normal Action Buttons State -->
                <Grid x:Name="FooterActionsPanel">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="12" Foreground="{StaticResource BrushAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Permanent trace eradication with zero remnants" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="SkipButton" Content="Skip" Style="{StaticResource OutlineButton}" Padding="18,8" Margin="0,0,10,0" Click="SkipButton_Click"/>
                    <Button Grid.Column="2" x:Name="DeleteButton" Content="🗑️ Delete Selected" Style="{StaticResource AccentButton}" Padding="20,8" Click="DeleteSelected_Click"/>
                </Grid>

                <!-- B. Modern Animated Progress State (No Popups!) -->
                <Border x:Name="FooterProgressPanel" Visibility="Collapsed"
                        Background="{StaticResource BrushSurface}"
                        BorderBrush="{StaticResource BrushBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14,10">
                    <StackPanel>
                        <!-- Top Row: Status Title and Percent -->
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="ProgressIconText" Text="⚡" FontSize="12" Margin="0,0,6,0" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ProgressStatusText" Text="Purging residual trace 0 of 0..." FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Column="1" x:Name="ProgressPercentText" Text="0%" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Smooth Animated Cyber ProgressBar -->
                        <ProgressBar x:Name="PurgeProgressBar" Style="{StaticResource FlatProgressBar}" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,6"/>

                        <!-- Bottom Row: Current Trace Path Detail -->
                        <TextBlock x:Name="CurrentTracePathText" Text="Preparing trace purge engine…" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
