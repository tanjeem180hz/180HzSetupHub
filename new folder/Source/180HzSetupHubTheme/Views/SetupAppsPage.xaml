<UserControl x:Class="SetupHub180Hz.Views.SetupAppsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SetupHub180Hz.Models"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:services="clr-namespace:SetupHub180Hz.Services">

    <UserControl.Resources>
        <!-- Category Filter Chip RadioButton -->
        <Style x:Key="CategoryChip" TargetType="{x:Type RadioButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="GroupName" Value="AppCategories"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurface}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Web link button style -->
        <Style x:Key="WebLinkButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource BrushTextSecondary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Setter Property="Foreground" Value="{StaticResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean ListBox Item Style (No default selection highlight, stretch width) -->
        <Style x:Key="CleanListBoxItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ultra-Optimized Virtualized App Row Template -->
        <DataTemplate x:Key="AppCardTemplate">
            <Border Style="{StaticResource ListRow}" Padding="14,10,14,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 0. Multi-Select CheckBox -->
                    <CheckBox Grid.Column="0"
                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                              Style="{StaticResource AppCheckBox}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Cursor="Hand"
                              Click="AppCheckBox_Click"/>

                    <!-- 1. Logo / Monogram -->
                    <Border Grid.Column="1" Width="44" Height="44" CornerRadius="8"
                            Background="{StaticResource BrushBackground}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Neutral Loading/Fallback Placeholder: ONLY visible when HasIconImage is False -->
                            <Border Background="{StaticResource BrushSurface}" CornerRadius="7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIconImage}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="📦"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.4"/>
                            </Border>

                            <!-- Authentic Software Logo: Displayed cleanly with NO text behind it -->
                            <Image Source="{Binding IconImageSource}"
                                   Width="32" Height="32"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 2. Details StackPanel -->
                    <StackPanel Grid.Column="2" Margin="12,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,3">
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>

                            <!-- Source tag (e.g. WINGET / MSSTORE) -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1,6,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SourceTag}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>

                            <!-- Category badge -->
                            <Border Background="#1C2538"
                                    CornerRadius="4"
                                    Padding="6,1,6,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Category}"
                                           FontSize="10"
                                           Foreground="{StaticResource BrushAccent}"/>
                            </Border>
                        </StackPanel>

                        <!-- Description -->
                        <TextBlock Text="{Binding Description}"
                                   Style="{StaticResource TextBody}"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,0,0,5"/>

                        <!-- Meta Row (Exact Version + Exact Size + Web Link) -->
                        <StackPanel Orientation="Horizontal">
                            <!-- Version Pill -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2,8,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormattedVersion}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>

                            <!-- Size Pill -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2,8,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormattedSize}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- 3. Actions Button -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Loaded="OfficialLinkContainer_Loaded" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button Content="{Binding Status}"
                                Click="InstallButton_Click"
                                Padding="18,7,18,7">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                            <Setter Property="Background" Value="#163A29"/>
                                            <Setter Property="Foreground" Value="{DynamicResource BrushSuccess}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushSuccess}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Header -->
            <RowDefinition Height="Auto"/> <!-- 1: Quick Bundles -->
            <RowDefinition Height="Auto"/> <!-- 2: Search & Controls -->
            <RowDefinition Height="Auto"/> <!-- 3: Batch Selection Bar -->
            <RowDefinition Height="Auto"/> <!-- 4: Categories -->
            <RowDefinition Height="*"/>    <!-- 5: Apps List & Download Popup -->
        </Grid.RowDefinitions>

        <!-- 1. Header Block (No badge text) -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Setup Apps" Style="{StaticResource TextHeader}" FontSize="26"/>
                <TextBlock Text="Explore 420+ curated packages with exact verified versions, genuine sizes, and instant deployment." Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Stats Badge -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="14,8">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource BrushSuccess}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="CatalogCountText" Text="421 Packages Ready" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- 2. Curated Quick-Deploy Bundles (No scroll line, mouse wheel scrollable) -->
        <Border Grid.Row="1" Margin="0,0,0,16">
            <ScrollViewer x:Name="BundlesScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Style="{StaticResource CleanScrollViewer}">
                <ItemsControl x:Name="BundlesItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Width="280" Margin="0,0,12,0" Padding="14,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Bundle Title & Icon -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="{Binding IconEmoji}" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Bundle Description -->
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" LineHeight="16"/>

                                    <!-- Progress indicator -->
                                    <TextBlock Grid.Row="2" Text="{Binding ProgressText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource BrushAccent}" TextTrimming="CharacterEllipsis"
                                               Margin="0,0,0,6" Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}"/>

                                    <!-- Install All Button -->
                                    <Button Grid.Row="3" Content="{Binding ButtonContent}" Style="{StaticResource AccentButton}"
                                            Padding="14,6" FontSize="11" FontWeight="Bold"
                                            IsEnabled="{Binding IsNotInstalling}"
                                            Click="BundleInstall_Click"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 3. Search & Toolbar -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search Input Container -->
            <Grid Grid.Column="0">
                <Border x:Name="SearchBorder" Background="{StaticResource BrushSurface}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource BrushTextSecondary}"/>

                        <!-- Search Box & Ghost Autocomplete Overlay -->
                        <Grid Grid.Column="1">
                            <!-- Ghost suggestion for Tab completion -->
                            <TextBlock x:Name="SearchGhostText"
                                       Background="Transparent"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       Opacity="0.4"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Padding="10,10"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>

                            <!-- Editable Input -->
                            <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource BrushTextPrimary}" CaretBrush="{StaticResource BrushAccent}"
                                     FontFamily="{StaticResource AppFont}" FontSize="13" Padding="10,10"
                                     VerticalContentAlignment="Center"
                                     KeyDown="SearchBox_KeyDown"
                                     PreviewKeyDown="SearchBox_PreviewKeyDown"
                                     TextChanged="SearchBox_TextChanged"/>
                        </Grid>

                        <!-- Tab Completion Hint Pill -->
                        <Border x:Name="TabHintBadge" Grid.Column="2"
                                Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}"
                                BorderThickness="1" CornerRadius="4"
                                Padding="6,2" Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed"
                                Cursor="Hand"
                                MouseLeftButtonDown="TabHintBadge_MouseLeftButtonDown"
                                ToolTip="Press Tab key to auto-complete">
                            <TextBlock Text="⇥ Tab" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>

                        <Button x:Name="ClearSearchButton" Grid.Column="3" Content="✕"
                                Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrushTextSecondary}"
                                Padding="10,0" Cursor="Hand" Visibility="Collapsed" Click="ClearSearch_Click"/>
                    </Grid>
                </Border>

                <!-- Search Suggestions Dropdown Popup -->
                <Popup x:Name="SearchSuggestionsPopup"
                       PlacementTarget="{Binding ElementName=SearchBorder}"
                       Placement="Bottom"
                       VerticalOffset="4"
                       IsOpen="False"
                       StaysOpen="False"
                       AllowsTransparency="True">
                    <Border Width="{Binding ElementName=SearchBorder, Path=ActualWidth}"
                            Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="6"
                            SnapsToDevicePixels="True">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.45" Color="Black"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="8,4,8,6">
                                <TextBlock Text="SUGGESTIONS (Press Tab or click to complete)"
                                           FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource BrushTextSecondary}" Opacity="0.75"/>
                            </Grid>

                            <ListBox x:Name="SuggestionsListBox" Grid.Row="1"
                                     Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MaxHeight="260"
                                     PreviewKeyDown="SuggestionsListBox_PreviewKeyDown"
                                     SelectionChanged="SuggestionsListBox_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="6" Padding="8,6" Margin="0,1" Cursor="Hand">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#182436"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="ItemBorder" Property="Background" Value="#1C2E46"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="22" Height="22" CornerRadius="4"
                                                    Background="{StaticResource BrushBackground}"
                                                    BorderBrush="{StaticResource BrushBorder}"
                                                    BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="📦" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                                    <Image Source="{Binding IconImageSource}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushTextPrimary}"/>
                                                <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" Background="#162536" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" Foreground="{StaticResource BrushAccent}"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Deep Web Search Action Row -->
                            <Border Grid.Row="2" Margin="0,4,0,0" Padding="8,8"
                                    Background="#142234" BorderBrush="{StaticResource BrushAccent}"
                                    BorderThickness="1" CornerRadius="6" Cursor="Hand"
                                    MouseLeftButtonDown="PopupDeepWebSearch_Click">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="🌐" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="PopupDeepSearchText" Text="Deep Web Search for '...'"
                                                   FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource BrushAccent}"/>
                                        <TextBlock Text="Query Winget repository for all matching packages online"
                                                   FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="↵ Enter" FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>

            <!-- Search Catalog Action -->
            <Button Grid.Column="1" Content="🔍" Tag="Filter" Style="{StaticResource ExpandableAccentButton}" Margin="8,0,0,0" Click="Search_Click"/>

            <!-- Winget Live Web Search Action -->
            <Button x:Name="WingetSearchButton" Grid.Column="2" Tag="Deep Web Search"
                    Style="{StaticResource ExpandableOutlineButton}" Margin="8,0,0,0"
                    ToolTip="Search winget's full online repository for any software outside preset list"
                    Click="WingetSearch_Click">
                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                            services:LottieHelper.AssetName="scan.json"/>
            </Button>

            <!-- Import & Install Action -->
            <Button Grid.Column="3" Tag="Import &amp; Install"
                    Style="{StaticResource ExpandableOutlineButton}" Margin="8,0,0,0"
                    ToolTip="Import software list from JSON and sequentially install missing apps"
                    Click="ImportInstall_Click">
                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                            services:LottieHelper.AssetName="download_flow.json"/>
            </Button>

            <!-- Refresh Catalog & Status Action -->
            <Button Grid.Column="4" Tag="Refresh Status"
                    Style="{StaticResource ExpandableOutlineButton}" Margin="8,0,0,0"
                    ToolTip="Refresh installed status and reload application catalog"
                    Click="Refresh_Click">
                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                            services:LottieHelper.AssetName="refresh.json"/>
            </Button>
        </Grid>

        <!-- 4. Batch Selection Action Bar (Shown when 1+ apps selected) -->
        <Border x:Name="BatchActionBar"
                Grid.Row="3"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushAccent}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,8"
                Margin="0,0,0,12"
                Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedAppsCountText" Text="0 apps selected" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    <Button Content="✔" Tag="Select All" Style="{StaticResource ExpandableOutlineButton}" Margin="14,0,0,0" Click="SelectAll_Click"/>
                    <Button Content="✕" Tag="Clear Selection" Style="{StaticResource ExpandableOutlineButton}" Margin="8,0,0,0" Click="ClearSelection_Click"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="InstallSelectedButton" Tag="Install Selected" Style="{StaticResource ExpandableAccentButton}" Click="InstallSelected_Click">
                        <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                    services:LottieHelper.AssetName="rocket.json"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. Novelty Category Filter Tabs (Horizontal Scrollable with NO line, supports mouse wheel & drag) -->
        <Border Grid.Row="4" Margin="0,0,0,16">
            <ScrollViewer x:Name="CategoryScrollViewer"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Style="{StaticResource CleanScrollViewer}"
                          PreviewMouseDown="CategoryScrollViewer_PreviewMouseDown"
                          PreviewMouseMove="CategoryScrollViewer_PreviewMouseMove"
                          PreviewMouseUp="CategoryScrollViewer_PreviewMouseUp">
                <StackPanel x:Name="CategoryChipsPanel" Orientation="Horizontal" Margin="0,2,0,4">
                    <!-- Populated dynamically in code-behind with counts -->
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 6. Applications List & Bottom Floating Download Popup -->
        <Grid Grid.Row="5">
            <TextBlock x:Name="StatusText" Text="Loading software catalog…" Style="{StaticResource TextBody}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0"/>

            <ListBox x:Name="AppsListBox"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.CanContentScroll="True"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0,0,6,0"
                     ItemContainerStyle="{StaticResource CleanListBoxItem}"
                     ItemTemplate="{StaticResource AppCardTemplate}"/>

            <!-- Bottom Floating / Docked Download Popup Panel -->
            <Border x:Name="DownloadPopupPanel"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    Background="{StaticResource BrushSurface}"
                    BorderBrush="{StaticResource BrushAccent}"
                    BorderThickness="1.5"
                    CornerRadius="10"
                    Padding="16,12"
                    Panel.ZIndex="100"
                    Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.65"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 0: App info, Status Badge, Queue info, Close button -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App Icon -->
                        <Border Width="34" Height="34" CornerRadius="6"
                                Background="{StaticResource BrushBackground}"
                                BorderBrush="{StaticResource BrushBorder}"
                                BorderThickness="1" Margin="0,0,10,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                <Image x:Name="PopupAppIcon" Width="26" Height="26" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <!-- App Name & Live Status Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="PopupAppName" Text="Application" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <Border x:Name="PopupStateBadge" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="PopupStateText" Text="DOWNLOADING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="PopupStatusDetail" Text="Initializing…" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Queue Counter Badge -->
                        <Border Grid.Column="2" Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="PopupQueueText" Text="App 1 of 1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </Border>

                        <!-- Dismiss Button -->
                        <Button x:Name="PopupDismissButton" Grid.Column="3" Content="✕"
                                Style="{StaticResource CaptionButton}" Width="26" Height="26"
                                Margin="6,0,0,0" ToolTip="Dismiss"
                                Click="PopupDismiss_Click" Visibility="Collapsed"/>
                    </Grid>

                    <!-- Row 1: Flat Accent Progress Bar -->
                    <ProgressBar x:Name="PopupProgressBar" Grid.Row="1"
                                 Style="{StaticResource FlatProgressBar}"
                                 Height="6" Margin="0,0,0,8"
                                 Minimum="0" Maximum="100" Value="0"/>

                    <!-- Row 2: Live Metrics & Controls -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Download Metrics: Percentage, Speed, ETA, Size -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="PopupPercentageText" Text="0%" FontWeight="Bold" FontSize="12" Foreground="{DynamicResource BrushAccent}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="PopupSpeedText" Text="0 MB/s" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="PopupEtaText" Text="ETA: Calculating…" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,12,0"/>
                            <TextBlock x:Name="PopupSizeText" Text="" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                        </StackPanel>

                        <!-- Action Buttons: Pause/Resume, Skip, Cancel All, Queue List Toggle, Open Downloads -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="PopupPauseResumeButton" Content="⏸" Tag="Pause"
                                    Style="{StaticResource ExpandableAccentButton}"
                                    Click="PopupPauseResume_Click"/>

                            <Button x:Name="PopupSkipButton" Content="⏭" Tag="Skip"
                                    Style="{StaticResource ExpandableOutlineButton}"
                                    Margin="6,0,0,0"
                                    Click="PopupSkip_Click"/>

                            <Button x:Name="PopupToggleQueueButton" Content="📋" Tag="Queue List"
                                    Style="{StaticResource ExpandableOutlineButton}"
                                    Margin="6,0,0,0"
                                    Click="PopupToggleQueue_Click"/>

                            <Button x:Name="PopupViewDownloadsButton" Content="📊" Tag="Downloads &amp; Graph"
                                    Style="{StaticResource ExpandableOutlineButton}"
                                    Foreground="{DynamicResource BrushAccent}"
                                    Margin="6,0,0,0"
                                    Click="PopupViewDownloads_Click"/>

                            <Button x:Name="PopupCancelButton" Content="✕" Tag="Cancel All"
                                    Style="{StaticResource ExpandableDangerButton}"
                                    Margin="6,0,0,0"
                                    Click="PopupCancel_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Row 3: Expandable Queue Drawer List -->
                    <Border x:Name="PopupQueueDrawer" Grid.Row="3" Margin="0,10,0,0"
                            BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushBorder}"
                            Visibility="Collapsed" MaxHeight="140">
                        <ScrollViewer Style="{StaticResource CleanScrollViewer}" Margin="0,6,0,0">
                            <StackPanel>
                                <TextBlock Text="UP NEXT IN DOWNLOAD QUEUE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,6"/>
                                <ItemsControl x:Name="PopupQueueItemsControl">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Image Source="{Binding IconImageSource}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,6,0"/>
                                                        <TextBlock Text="{Binding FormattedVersion}" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Content="⬆ Priority" Style="{StaticResource OutlineButton}" Padding="6,2" FontSize="10" Margin="0,0,4,0" ToolTip="Move to Top" Click="PopupQueueMoveToTop_Click"/>
                                                        <Button Content="✕" Style="{StaticResource OutlineButton}" Padding="6,2" FontSize="10" Foreground="{StaticResource BrushError}" ToolTip="Remove from Queue" Click="PopupQueueRemove_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="PopupNoRemainingQueueText" Text="No other apps currently in queue." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Visibility="Collapsed" Margin="0,4,0,4"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ==================== ALREADY INSTALLED POPUP MODAL ==================== -->
        <Grid x:Name="AlreadyInstalledOverlay"
              Grid.Row="0" Grid.RowSpan="6"
              Margin="-32,-24,-32,-28"
              Panel.ZIndex="300"
              Visibility="Collapsed"
              Background="#99000000"
              MouseLeftButtonDown="AlreadyInstalledOverlay_BackdropClick">
            <Border Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource BrushSurface}"
                    BorderBrush="{DynamicResource BrushSuccess}"
                    BorderThickness="1.5"
                    CornerRadius="14"
                    Padding="24"
                    MouseLeftButtonDown="AlreadyInstalledCard_Click">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="6" Opacity="0.75"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header: Icon, Name, Close -->
                        <RowDefinition Height="Auto"/> <!-- Status Banner: Already Installed -->
                        <RowDefinition Height="Auto"/> <!-- Metadata details: Version, Location, Size -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Row 0: App Info & Dismiss '✕' -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App Icon -->
                        <Border Width="52" Height="52" CornerRadius="10"
                                Background="{DynamicResource BrushBackground}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="📦" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                <Image x:Name="ModalAppIcon" Width="40" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <!-- Name, Badge & Version -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="ModalAppName" Text="Application Name" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                                <Border Background="#163A29" BorderBrush="{DynamicResource BrushSuccess}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock Text="INSTALLED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}"/>
                                </Border>
                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                    <TextBlock x:Name="ModalAppVersion" Text="v1.0.0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                                <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="ModalAppSize" Text="120 MB" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Content="✕"
                                Style="{StaticResource CaptionButton}" Width="28" Height="28"
                                ToolTip="Close" Click="ModalClose_Click" VerticalAlignment="Top"/>
                    </Grid>

                    <!-- Row 1: Status Alert Banner -->
                    <Border Grid.Row="1" Background="#142C20" BorderBrush="{DynamicResource BrushSuccess}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="✅" FontSize="18" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Application Already Installed" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <TextBlock x:Name="ModalStatusMessage" Text="This software is verified and active on your system." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 2: Metadata / Path Information -->
                    <Border Grid.Row="2" Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Package ID:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,8,4"/>
                            <TextBlock x:Name="ModalPackageId" Grid.Column="1" Text="Publisher.App" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,4" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Row="1" Text="Category:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,8,0"/>
                            <TextBlock x:Name="ModalCategory" Grid.Row="1" Grid.Column="1" Text="Browsers &amp; Web" FontSize="11" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </Grid>
                    </Border>

                    <!-- Row 3: Action Buttons (Launch App, Reinstall, Close) -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="ModalLaunchButton" Grid.Column="0" Content="🚀 Open Application"
                                Style="{StaticResource AccentButton}" Padding="16,8" Margin="0,0,8,0"
                                Click="ModalLaunch_Click"/>

                        <Button x:Name="ModalReinstallButton" Grid.Column="1" Content="🔄 Reinstall Anyway"
                                Style="{StaticResource OutlineButton}" Padding="14,8" Margin="0,0,8,0"
                                Click="ModalReinstall_Click" ToolTip="Force download and clean reinstallation"/>

                        <Button Grid.Column="2" Content="Close"
                                Style="{StaticResource OutlineButton}" Padding="14,8"
                                Click="ModalClose_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
