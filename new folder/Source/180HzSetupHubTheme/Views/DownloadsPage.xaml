<UserControl x:Class="SetupHub180Hz.Views.DownloadsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SetupHub180Hz.Views"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
        xmlns:services="clr-namespace:SetupHub180Hz.Services"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1100">

    <Grid Margin="32,24,32,28">
        <ScrollViewer Style="{StaticResource CleanScrollViewer}">
            <StackPanel Margin="0,0,16,0">

                <!-- 1. Header Section: Title, Pulse status, and Global Control Buttons -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <lottie:LottieAnimationView Width="24" Height="24" AutoPlay="True" RepeatCount="-1"
                                                        services:LottieHelper.AssetName="download_flow.json" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DOWNLOADS &amp; BANDWIDTH" Style="{StaticResource TextHeader}" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                            <!-- Live Status Indicator Pill -->
                            <Border x:Name="LiveStatusBadge" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="12" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse x:Name="LiveStatusDot" Width="8" Height="8" Fill="{DynamicResource BrushAccent}" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="LiveStatusText" Text="IDLE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Real-time network throughput, active deployment pipeline, and queue prioritization."
                                   Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Top Action Controls -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPauseAll" Content="⏸" Tag="Pause All" Style="{StaticResource ExpandableOutlineButton}"
                                Margin="0,0,8,0" Click="BtnPauseAll_Click"/>
                        <Button x:Name="BtnClearCompleted" Content="🧹" Tag="Clear Completed" Style="{StaticResource ExpandableOutlineButton}"
                                Margin="0,0,8,0" Click="BtnClearCompleted_Click"/>
                        <Button x:Name="BtnCancelAll" Content="✕" Tag="Cancel Queue" Style="{StaticResource ExpandableDangerButton}"
                                Margin="0,0,8,0" Click="BtnCancelAll_Click"/>
                        <Button x:Name="BtnBrowseApps" Content="⚡" Tag="Browse Apps" Style="{StaticResource ExpandableAccentButton}"
                                Click="BtnBrowseApps_Click"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Bandwidth & Telemetry Metrics Cards (4 Columns) -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Current Speed -->
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16" Margin="0,0,8,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="wave.json" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="CURRENT SPEED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MetricCurrentSpeed" Text="0.0 MB/s" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}" Margin="0,6,0,2"/>
                            <TextBlock Text="Live download throughput" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Peak Speed -->
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="rocket.json" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PEAK SPEED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MetricPeakSpeed" Text="0.0 MB/s" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,2"/>
                            <TextBlock Text="Highest recorded session speed" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Session Downloaded -->
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Margin="4,0,4,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="download_flow.json" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="SESSION TRANSFERRED" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MetricTotalDownloaded" Text="0.0 MB" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,2"/>
                            <TextBlock Text="Payload data received" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Border>

                    <!-- Queue Remaining -->
                    <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16" Margin="8,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="gears.json" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="QUEUE PIPELINE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="MetricQueueRemaining" Text="0 Items" FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,6,0,2"/>
                            <TextBlock x:Name="MetricQueueSubtext" Text="0 completed this session" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Epic Games Style Real-Time Bandwidth Speed Graph -->
                <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="160"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Graph Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="BANDWIDTH MONITOR" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                                    <TextBlock Text="60-Second Real-Time Curve" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <TextBlock x:Name="GraphPeakLabel" Text="Peak: 0.0 MB/s" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                     <TextBlock x:Name="GraphCurrentLabel" Text="Now: 0.0 MB/s" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                 </Border>
                                 <Button x:Name="BtnResetBandwidth" Tag="Reset" Style="{StaticResource ExpandableOutlineButton}" ToolTip="Reset bandwidth history and peak metrics" VerticalAlignment="Center" Click="BtnResetBandwidth_Click">
                                     <lottie:LottieAnimationView Width="14" Height="14" AutoPlay="True" RepeatCount="-1"
                                                                 services:LottieHelper.AssetName="loading_disc.json"/>
                                 </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Graph Canvas Area with Grid Lines -->
                        <Border Grid.Row="1" Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <!-- Horizontal Background Gridlines & Speed Markers -->
                                <Canvas x:Name="GridCanvas" IsHitTestVisible="False">
                                    <!-- 75% Line -->
                                    <Line x:Name="GridLine75" X1="0" Y1="40" X2="2000" Y2="40" Stroke="{DynamicResource BrushBorder}" StrokeDashArray="4,4" StrokeThickness="1"/>
                                    <!-- 50% Line -->
                                    <Line x:Name="GridLine50" X1="0" Y1="80" X2="2000" Y2="80" Stroke="{DynamicResource BrushBorder}" StrokeDashArray="4,4" StrokeThickness="1"/>
                                    <!-- 25% Line -->
                                    <Line x:Name="GridLine25" X1="0" Y1="120" X2="2000" Y2="120" Stroke="{DynamicResource BrushBorder}" StrokeDashArray="4,4" StrokeThickness="1"/>
                                </Canvas>

                                <!-- Y-Axis Speed Labels on right margin -->
                                <Grid HorizontalAlignment="Right" Margin="0,4,10,4" IsHitTestVisible="False">
                                    <TextBlock x:Name="YAxisMaxLabel" Text="30 MB/s" VerticalAlignment="Top" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock x:Name="YAxisHalfLabel" Text="15 MB/s" VerticalAlignment="Center" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock Text="0 B/s" VerticalAlignment="Bottom" FontSize="9" Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Grid>

                                <!-- Dynamic Graph Area and Polyline -->
                                <Canvas x:Name="GraphCanvas" SizeChanged="GraphCanvas_SizeChanged">
                                    <!-- Area Fill below line -->
                                    <Polygon x:Name="GraphAreaPolygon">
                                        <Polygon.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#4000FF66" Offset="0.0"/>
                                                <GradientStop Color="#0000FF66" Offset="1.0"/>
                                            </LinearGradientBrush>
                                        </Polygon.Fill>
                                    </Polygon>

                                    <!-- Main Speed Line -->
                                    <Polyline x:Name="GraphLine"
                                              Stroke="{DynamicResource BrushAccent}"
                                              StrokeThickness="2.5"
                                              StrokeLineJoin="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>

                                    <!-- Current Point Indicator Dot -->
                                    <Ellipse x:Name="GraphDot" Width="8" Height="8"
                                             Fill="{DynamicResource BrushAccent}" Stroke="#FFFFFF" StrokeThickness="1.5"
                                             Canvas.Left="0" Canvas.Top="0" Visibility="Collapsed"/>
                                </Canvas>
                            </Grid>
                        </Border>

                        <!-- Timeline Labels Below Graph -->
                        <Grid Grid.Row="2" Margin="8,6,8,0">
                            <TextBlock Text="60s ago" HorizontalAlignment="Left" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="45s ago" HorizontalAlignment="Left" Margin="140,0,0,0" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="30s ago" HorizontalAlignment="Center" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="15s ago" HorizontalAlignment="Right" Margin="0,0,140,0" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock Text="Now" HorizontalAlignment="Right" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 4. Active Download Hero Card -->
                <TextBlock Text="CURRENT ACTIVE DEPLOYMENT" FontSize="12" FontWeight="Bold"
                           Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,8"/>

                <Border x:Name="ActiveDownloadCard" Style="{StaticResource Card}" Padding="20" Margin="0,0,0,24"
                        BorderBrush="{StaticResource BrushAccent}">
                    <Grid>
                        <!-- Active Download State -->
                        <Grid x:Name="ActiveContentGrid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 0: App info, Status Badge, and Action Buttons -->
                            <Grid Grid.Row="0" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- App Logo -->
                                <Border Width="48" Height="48" CornerRadius="8"
                                        Background="{StaticResource BrushBackground}"
                                        BorderBrush="{StaticResource BrushBorder}"
                                        BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                                    <Grid>
                                        <lottie:LottieAnimationView Width="32" Height="32" AutoPlay="True" RepeatCount="-1"
                                                                    services:LottieHelper.AssetName="download_flow.json"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.85"/>
                                        <Image x:Name="ActiveAppIcon" Width="36" Height="36" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Grid>
                                </Border>

                                <!-- Title, Category, Version, Live State -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock x:Name="ActiveAppName" Text="Application Name" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"
                                                   Cursor="Hand" ToolTip="Click to visit official website" MouseLeftButtonUp="ActiveAppName_Click"/>
                                        <Border x:Name="ActiveStateBadge" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="ActiveStateText" Text="DOWNLOADING" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,6,0">
                                            <TextBlock x:Name="ActiveCategoryText" Text="Category" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Border>
                                        <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0">
                                            <TextBlock x:Name="ActiveVersionText" Text="v1.0" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </Border>
                                        <TextBlock x:Name="ActiveStatusDetail" Text="Connecting to repository payload server…" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Hero Controls -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnActivePauseResume" Content="⏸" Tag="Pause" Style="{StaticResource ExpandableAccentButton}"
                                            Margin="0,0,6,0" Click="BtnActivePauseResume_Click"/>
                                    <Button x:Name="BtnActiveSkip" Content="⏭" Tag="Skip" Style="{StaticResource ExpandableOutlineButton}"
                                            Margin="0,0,6,0" Click="BtnActiveSkip_Click"/>
                                    <Button x:Name="BtnActiveCancel" Content="✕" Tag="Cancel" Style="{StaticResource ExpandableDangerButton}"
                                            Margin="0,0,6,0" Click="BtnActiveCancel_Click"/>
                                    <Button x:Name="BtnActiveWebsite" Content="🌐" Tag="Website" Style="{StaticResource ExpandableOutlineButton}"
                                            Click="BtnActiveWebsite_Click"/>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Large Glowing Progress Bar -->
                            <Grid Grid.Row="1" Margin="0,0,0,12">
                                <ProgressBar x:Name="ActiveProgressBar" Style="{StaticResource FlatProgressBar}"
                                             Height="8" Minimum="0" Maximum="100" Value="0"/>
                            </Grid>

                            <!-- Row 2: Live Download Metrics Details -->
                            <Grid Grid.Row="2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ActiveProgressPercent" Text="0%" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}" Margin="0,0,16,0"/>
                                    <TextBlock x:Name="ActiveTransferredText" Text="0 MB / 0 MB" FontSize="12" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,16,0"/>
                                    <TextBlock x:Name="ActiveSpeedText" Text="0.0 MB/s" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,16,0"/>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                                    services:LottieHelper.AssetName="clock.json"
                                                                    Margin="0,0,6,0" VerticalAlignment="Center"
                                                                    ToolTip="Estimated time remaining"/>
                                        <TextBlock x:Name="ActiveEtaText" Text="Calculating…" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock x:Name="ActiveQueueCountText" Text="Item 1 of 1" HorizontalAlignment="Right"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>

                        <!-- Idle State Placeholder (visible when nothing is downloading) -->
                        <Grid x:Name="IdlePlaceholderGrid" Visibility="Collapsed" Margin="20">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <lottie:LottieAnimationView Width="80" Height="80" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="loading_disc.json"
                                                            HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="No active downloads in progress" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                                <TextBlock Text="Head over to Setup Apps or search software to install packages with one-click deployment."
                                           FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,4,0,14"/>
                                <Button Content="⚡" Tag="Open Setup Apps" Style="{StaticResource ExpandableAccentButton}" HorizontalAlignment="Center"
                                        Click="BtnBrowseApps_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 5. Up Next in Queue Section -->
                <Grid Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="UP NEXT IN QUEUE" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}"/>
                        <Border Background="{StaticResource BrushBorder}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock x:Name="QueueCountBadge" Text="0" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Empty Queue Message -->
                <Border x:Name="EmptyQueueBorder" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,24" Visibility="Collapsed">
                    <TextBlock Text="No apps currently queued for download." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                </Border>

                <!-- Queue Items List -->
                <ItemsControl x:Name="QueueItemsList" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRow}" Padding="12,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Priority / Index Badge -->
                                        <ColumnDefinition Width="Auto"/> <!-- Icon -->
                                        <ColumnDefinition Width="*"/>    <!-- Name, Category, Version -->
                                        <ColumnDefinition Width="Auto"/> <!-- Status -->
                                        <ColumnDefinition Width="Auto"/> <!-- Actions -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Queue Pill -->
                                    <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource BrushBackground}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="⏳" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- App Icon -->
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="6"
                                            Background="{StaticResource BrushBackground}"
                                            BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            Margin="0,0,12,0" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                            <Image Source="{Binding IconImageSource}" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>

                                    <!-- App Details -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}"/>
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="{Binding FormattedVersion}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding FormattedSize}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Status Badge -->
                                    <Border Grid.Column="3" Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                            CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="Waiting in queue" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                    </Border>

                                    <!-- Actions: Move To Top / Priority, Remove -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="⬆" Tag="Priority" Style="{StaticResource ExpandableOutlineButton}"
                                                Margin="0,0,6,0" ToolTip="Move to top of queue"
                                                Click="QueueItemMoveToTop_Click"/>
                                        <Button Content="✕" Tag="Remove" Style="{StaticResource ExpandableDangerButton}"
                                                ToolTip="Remove from queue"
                                                Click="QueueItemRemove_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 6. Completed History Section -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="COMPLETED THIS SESSION" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}"/>
                        <Border Background="{DynamicResource BrushBorder}" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                            <TextBlock x:Name="HistoryCountBadge" Text="0" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Empty History Message -->
                <Border x:Name="EmptyHistoryBorder" Style="{StaticResource Card}" Padding="16" Margin="0,0,0,24" Visibility="Collapsed">
                    <TextBlock Text="No software installed in this session yet." FontSize="12" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                </Border>

                <!-- History Items List -->
                <ItemsControl x:Name="HistoryItemsList" Margin="0,0,0,24">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ListRow}" Padding="12,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/> <!-- Result Glyph -->
                                        <ColumnDefinition Width="Auto"/> <!-- App Icon -->
                                        <ColumnDefinition Width="*"/>    <!-- Name, Category, Completion Time -->
                                        <ColumnDefinition Width="Auto"/> <!-- Result Status Badge -->
                                        <ColumnDefinition Width="Auto"/> <!-- Actions -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Status Icon Pill -->
                                    <Border Width="26" Height="26" CornerRadius="13" Background="{DynamicResource BrushBackground}"
                                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                            VerticalAlignment="Center" Margin="0,0,12,0">
                                        <lottie:LottieAnimationView Width="18" Height="18" AutoPlay="True" RepeatCount="1"
                                                                    services:LottieHelper.AssetName="check_pop.json"
                                                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- App Icon -->
                                    <Border Grid.Column="1" Width="36" Height="36" CornerRadius="6"
                                            Background="{DynamicResource BrushBackground}"
                                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                            Margin="0,0,12,0" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="📦" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.4"/>
                                            <Image Source="{Binding App.IconImageSource}" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </Grid>
                                    </Border>

                                    <!-- App Details -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding App.Name}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding App.Category}" FontSize="10" Foreground="{DynamicResource BrushAccent}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding FormattedTime, StringFormat='Completed at {0}'}" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Result Badge -->
                                    <Border Grid.Column="3" Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushSuccess}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="✓ Installed" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushSuccess}"/>
                                    </Border>

                                    <!-- Actions: Official Site, Remove -->
                                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="🌐" Tag="Website" Style="{StaticResource ExpandableOutlineButton}"
                                                Margin="0,0,6,0" Click="HistoryItemWebsite_Click"/>
                                        <Button Content="✕" Tag="Dismiss" Style="{StaticResource ExpandableOutlineButton}"
                                                ToolTip="Dismiss from history"
                                                Click="HistoryItemRemove_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
