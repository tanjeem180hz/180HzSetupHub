<UserControl x:Class="SetupHub180Hz.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:services="clr-namespace:SetupHub180Hz.Services">

    <UserControl.Resources>
        <!-- ToggleButton Template for ComboBox Chrome -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 3.5 3.5 L 7 0"
                          Stroke="{DynamicResource BrushTextSecondary}"
                          StrokeThickness="1.5"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource BrushAccent}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource BrushAccent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style -->
        <Style x:Key="SettingComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full Cyber-Styled ComboBox -->
        <Style x:Key="SettingComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,28,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Opacity="0.6"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="40"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interactive Animated Card Style -->
        <Style x:Key="InteractiveSettingCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,16"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#4500FF66"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Animated Entrance Container -->
    <Grid Margin="28" RenderTransformOrigin="0.5,0.5">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="PageEntranceTransform" Y="10"/>
        </Grid.RenderTransform>
        <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetName="PageEntranceTransform"
                                         Storyboard.TargetProperty="Y"
                                         From="10" To="0"
                                         Duration="0:0:0.25"
                                         DecelerationRatio="0.8"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Simple Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18" Orientation="Horizontal" VerticalAlignment="Center">
            <lottie:LottieAnimationView Width="22" Height="22" AutoPlay="True" RepeatCount="-1"
                                        services:LottieHelper.AssetName="settings_dial.json" Margin="0,0,10,0" VerticalAlignment="Center"/>
            <TextBlock Text="Settings" Style="{StaticResource TextHeader}" FontSize="22" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Settings Cards -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- 1. Startup Card -->
                <Border Style="{StaticResource InteractiveSettingCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Startup" Style="{StaticResource TextSubHeader}" FontSize="15" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkAutoStart"
                                  Style="{StaticResource AppCheckBox}"
                                  Content="Launch 180Hz Setup Hub when Windows starts"
                                  Checked="ChkAutoStart_Changed"
                                  Unchecked="ChkAutoStart_Changed"/>
                    </StackPanel>
                </Border>

                <!-- 2. Notifications & Updates Card -->
                <Border Style="{StaticResource InteractiveSettingCard}" Margin="0,0,0,12">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="Notifications &amp; Updates" Style="{StaticResource TextSubHeader}" FontSize="15" VerticalAlignment="Center"/>
                            <Border HorizontalAlignment="Right" Background="#1400FF66" BorderBrush="#3500FF66" BorderThickness="1" CornerRadius="4" Padding="7,2">
                                <TextBlock Text="⚡ GitHub Sync" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                            </Border>
                        </Grid>

                        <!-- Compact EXE Auto-Updater Bar -->
                        <Border Background="{DynamicResource BrushSurfaceHover}"
                                BorderBrush="{DynamicResource BrushBorder}"
                                BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Version & Action Buttons -->
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Version & Status -->
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="180Hz Setup Hub" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <Border Background="#1800FF66" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock x:Name="TxtSettingsAppVersion" Text="v2.5.0" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource BrushAccent}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSettingsAppUpdateStatus" Text="Ready to check for updates." FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <!-- Quick Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnSettingsCheckUpdate" Content="Check Updates"
                                                Style="{StaticResource OutlineButton}"
                                                Padding="10,4" Height="28" FontSize="11"
                                                Click="BtnSettingsCheckUpdate_Click" ToolTip="Check GitHub for newer version"/>

                                        <Button x:Name="BtnSettingsUpdateNow" Content="🚀 Update Now"
                                                Style="{StaticResource AccentButton}"
                                                Margin="6,0,0,0" Padding="12,4" Height="28" FontSize="11"
                                                Click="BtnSettingsUpdateNow_Click" ToolTip="Download and apply update"/>

                                        <Button x:Name="BtnSettingsForceUpdate" Content="Force"
                                                Style="{StaticResource OutlineButton}"
                                                Margin="6,0,0,0" Padding="8,4" Height="28" FontSize="11"
                                                Click="BtnSettingsForceUpdate_Click" ToolTip="Force re-download latest EXE"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Live Download Progress Panel -->
                                <StackPanel x:Name="PnlSettingsDownloadProgress" Grid.Row="1" Margin="0,8,0,2" Visibility="Collapsed">
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock x:Name="TxtSettingsDownloadBytes" Text="Downloading…" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock x:Name="TxtSettingsDownloadSpeed" Text="0 KB/s" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                    </Grid>
                                    <ProgressBar x:Name="PrgSettingsDownload" Height="4" Maximum="100" Value="0"
                                                 Foreground="{DynamicResource BrushAccent}" Background="{DynamicResource BrushSurface}" BorderThickness="0"/>
                                </StackPanel>

                                <!-- Release Notes Panel -->
                                <Border x:Name="PnlSettingsReleaseNotes" Grid.Row="2" Margin="0,8,0,0"
                                        Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        CornerRadius="5" Padding="10,6" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtSettingsReleaseNotes" Text="" FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" TextWrapping="Wrap"/>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Compact Options -->
                        <CheckBox x:Name="ChkAutoCheckAppUpdates"
                                  Style="{StaticResource AppCheckBox}"
                                  Content="Automatically check for updates on launch"
                                  Margin="0,0,0,10"
                                  Checked="ChkAutoCheckAppUpdates_Changed"
                                  Unchecked="ChkAutoCheckAppUpdates_Changed"/>

                        <CheckBox x:Name="ChkNotifications"
                                  Style="{StaticResource AppCheckBox}"
                                  Content="Show Windows toast notifications"
                                  Margin="0,0,0,12"
                                  Checked="ChkNotifications_Changed"
                                  Unchecked="ChkNotifications_Changed"/>

                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Update check interval" FontSize="13" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                            <ComboBox x:Name="CmbUpdateFrequency"
                                      Grid.Column="1"
                                      Style="{StaticResource SettingComboBox}"
                                      Width="180"
                                      HorizontalAlignment="Left"
                                      SelectionChanged="CmbUpdateFrequency_SelectionChanged">
                                <ComboBoxItem Content="Never" Tag="0"/>
                                <ComboBoxItem Content="Every 6 hours" Tag="6"/>
                                <ComboBoxItem Content="Every 12 hours" Tag="12"/>
                                <ComboBoxItem Content="Daily" Tag="24"/>
                                <ComboBoxItem Content="Weekly" Tag="168"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 3. Safety Card -->
                <Border Style="{StaticResource InteractiveSettingCard}">
                    <StackPanel>
                        <TextBlock Text="Safety" Style="{StaticResource TextSubHeader}" FontSize="15" Margin="0,0,0,12"/>
                        <CheckBox x:Name="ChkRequireAdmin"
                                  Style="{StaticResource AppCheckBox}"
                                  Content="Require Administrator privileges for cleanup &amp; uninstall"
                                  Checked="ChkRequireAdmin_Changed"
                                  Unchecked="ChkRequireAdmin_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
