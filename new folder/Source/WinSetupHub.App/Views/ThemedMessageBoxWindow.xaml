<Window x:Class="SetupHub180Hz.Views.ThemedMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="180Hz Setup Hub"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource AppFont}"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        MinWidth="380"
        MaxWidth="520"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource BrushSurface}"
            BorderBrush="{DynamicResource BrushBorder}"
            BorderThickness="1.5"
            CornerRadius="10"
            Margin="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="6" Opacity="0.75"/>
        </Border.Effect>

        <Grid MouseLeftButtonDown="Header_MouseDown">
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>  <!-- Titlebar -->
                <RowDefinition Height="*"/>   <!-- Content (Icon + Message) -->
                <RowDefinition Height="Auto"/> <!-- Buttons Row -->
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" Background="{DynamicResource BrushSurfaceHover}" Margin="1,1,1,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="18" Height="18" CornerRadius="4" Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" Margin="0,0,8,0">
                        <Image Source="pack://application:,,,/Assets/AppIcon-1024.png" Width="14" Height="14"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock x:Name="TitleTextBlock" Text="180Hz Setup Hub" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Column="1" x:Name="CloseButton" Content="✕" Width="38" Height="38"
                        Style="{StaticResource TitleBarCloseButton}" Click="CloseButton_Click"/>
            </Grid>

            <!-- Content: Icon Badge on Left + Message on Right -->
            <Grid Grid.Row="1" Margin="22,20,22,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Icon Badge -->
                <Border x:Name="IconBadge" Width="44" Height="44" CornerRadius="22"
                        Background="{DynamicResource BrushSurfaceHover}"
                        BorderBrush="{DynamicResource BrushAccent}"
                        BorderThickness="1.5"
                        Margin="0,0,16,0"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconGlyph" Text="⚡" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource BrushAccent}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <!-- Message Text -->
                <TextBlock x:Name="MessageTextBlock" Grid.Column="1"
                           Text="Message content goes here."
                           FontSize="13"
                           LineHeight="19"
                           Foreground="{DynamicResource BrushTextPrimary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Buttons Row -->
            <Border Grid.Row="2" Background="{DynamicResource BrushBackground}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,1,0,0"
                    Padding="18,12" CornerRadius="0,0,9,9">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="Btn1" Style="{StaticResource OutlineButton}" MinWidth="85" Height="32" Margin="0,0,8,0" Click="Btn1_Click"/>
                    <Button x:Name="Btn2" Style="{StaticResource OutlineButton}" MinWidth="85" Height="32" Margin="0,0,8,0" Click="Btn2_Click"/>
                    <Button x:Name="Btn3" Style="{StaticResource AccentButton}" MinWidth="85" Height="32" Click="Btn3_Click"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
