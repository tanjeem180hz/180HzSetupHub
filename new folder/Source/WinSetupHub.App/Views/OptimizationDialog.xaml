<Window x:Class="SetupHub180Hz.Views.OptimizationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:SetupHub180Hz.Models"
        Title="180Hz Optimization"
        Width="520"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{StaticResource AppFont}"
        ShowInTaskbar="False"
        SizeToContent="Height">

    <Window.Resources>
        <!-- Button styles -->
        <Style x:Key="DlgApplyButton" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{DynamicResource BrushAccent}"/>
            <Setter Property="Foreground" Value="#0A0E17"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="22,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DlgCancelButton" TargetType="{x:Type Button}" BasedOn="{StaticResource DlgApplyButton}">
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
        </Style>

        <Style x:Key="DlgCloseBtn" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2D1515"/>
                                <Setter Property="Foreground" Value="#FF4D4D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer Cyber Container -->
    <Border Background="{DynamicResource BrushBackground}"
            BorderBrush="{DynamicResource BrushAccent}"
            BorderThickness="1"
            CornerRadius="12"
            Margin="16">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="32" ShadowDepth="8" Opacity="0.85"/>
        </Border.Effect>

        <Grid Margin="22,18,22,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/>    <!-- Content (Confirm OR Progress) -->
            </Grid.RowDefinitions>

            <!-- 1. Header Bar -->
            <Grid Grid.Row="0" Margin="0,0,0,14" MouseDown="Header_MouseDown" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}"
                            BorderThickness="1" CornerRadius="6" Width="26" Height="26" Margin="0,0,10,0">
                        <TextBlock x:Name="TxtHeaderIcon" Text="⚡" FontSize="13" Foreground="{DynamicResource BrushAccent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="TxtDialogTitle" Text="Apply Recommended Optimizations"
                               FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="BtnDialogClose" Grid.Column="1" Style="{StaticResource DlgCloseBtn}"
                        Click="BtnCancel_Click" ToolTip="Close">
                    <TextBlock Text="✕" FontSize="12"/>
                </Button>
            </Grid>

            <!-- 2. Body -->
            <Grid Grid.Row="1">

                <!-- 2A. Confirmation View -->
                <Grid x:Name="ConfirmPanel" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" x:Name="TxtDialogSubtitle"
                               Text="This will apply recommended optimizations for peak desktop velocity &amp; system cleanliness:"
                               FontFamily="{StaticResource AppFont}" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource BrushTextSecondary}" Margin="0,0,0,12"/>

                    <!-- Tweak List Card -->
                    <Border Grid.Row="1" Background="{DynamicResource BrushSurface}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="8" MaxHeight="220" Padding="12,8" Margin="0,0,0,12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TweakItemsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TweakItem}">
                                        <StackPanel Orientation="Horizontal" Margin="0,3">
                                            <TextBlock Text="•" Foreground="{DynamicResource BrushAccent}" FontWeight="Bold" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource BrushTextPrimary}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Advanced warning if caution tweaks exist -->
                    <Border Grid.Row="2" x:Name="CautionWarningBox" Visibility="Collapsed"
                            Background="#1A0F00" BorderBrush="#92400E" BorderThickness="1"
                            CornerRadius="6" Padding="10,8" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="14" Margin="0,0,8,0" Foreground="#F59E0B" VerticalAlignment="Center"/>
                            <TextBlock Text="Caution: Some selected tweaks modify system-level configurations."
                                       FontSize="11" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Confirmation Question & Buttons -->
                    <Grid Grid.Row="3" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtConfirmPrompt" Text="Apply these optimizations now?"
                                   FontFamily="{StaticResource AppFont}" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnCancel" Style="{StaticResource DlgCancelButton}"
                                    Content="CANCEL" Margin="0,0,10,0" Click="BtnCancel_Click"/>
                            <Button x:Name="BtnProceed" Style="{StaticResource DlgApplyButton}"
                                    Content="APPLY NOW" Click="BtnProceed_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 2B. Circular Progress View (Round Animation) -->
                <Grid x:Name="ProgressPanel" Visibility="Collapsed" MinHeight="260">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">

                        <!-- Circular Gauge -->
                        <Grid Width="140" Height="140" HorizontalAlignment="Center" Margin="0,6,0,16">
                            <!-- Background Track Ring -->
                            <Ellipse Stroke="{DynamicResource BrushBorder}" StrokeThickness="8" Width="130" Height="130"/>
                            <!-- Animated Progress Arc -->
                            <Path x:Name="ProgressArc" Stroke="{DynamicResource BrushAccent}" StrokeThickness="8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>

                            <!-- Center percentage & counts -->
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock x:Name="TxtPercent" Text="0%" FontFamily="{StaticResource AppFont}"
                                           FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock x:Name="TxtStepCounter" Text="0 / 12" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                                           HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Action Status Headline -->
                        <TextBlock x:Name="TxtActionTitle" Text="Applying Optimizations..."
                                   FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center"
                                   Margin="0,0,0,6"/>

                        <!-- Current Tweak Subtext -->
                        <TextBlock x:Name="TxtCurrentTweakName" Text="Starting..."
                                   FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" MaxWidth="440"/>
                    </StackPanel>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
