<UserControl x:Class="SetupHub180Hz.Views.UpdateCenterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SetupHub180Hz.Models"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:services="clr-namespace:SetupHub180Hz.Services">

    <UserControl.Resources>
        <!-- Clean ListBox Item Style -->
        <Style x:Key="CleanListBoxItem" TargetType="{x:Type ListBoxItem}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,0,0,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Upgradable App Card Template -->
        <DataTemplate x:Key="UpgradableAppTemplate">
            <Border Style="{StaticResource ListRow}" Padding="14,10,14,10" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- 1. Logo / Monogram -->
                    <Border Width="44" Height="44" CornerRadius="8"
                            Background="{StaticResource BrushBackground}"
                            BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Left" VerticalAlignment="Center"
                            ClipToBounds="True">
                        <Grid>
                            <!-- Neutral Loading/Fallback Placeholder: ONLY visible when HasIconImage is False -->
                            <Border Background="{StaticResource BrushSurface}" CornerRadius="7">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasIconImage}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="📦"
                                           FontSize="16"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0.4"/>
                            </Border>

                            <!-- Authentic Software Logo: Displayed cleanly with NO text behind it -->
                            <Image Source="{Binding IconImageSource}"
                                   Width="32" Height="32"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- 2. Details -->
                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="{Binding Name}"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>

                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,1,6,1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding SourceTag}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>
                        </StackPanel>

                        <!-- Meta Row -->
                        <StackPanel Orientation="Horizontal">
                            <!-- Version Transition Pill -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushAccent}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2,8,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏷️ " FontSize="11" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Text="{Binding Version}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}"/>
                                    <TextBlock Text="  ➜  " FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                                    <TextBlock Text="{Binding AvailableVersion}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                                </StackPanel>
                            </Border>

                            <!-- Size Pill -->
                            <Border Background="{StaticResource BrushBackground}"
                                    BorderBrush="{StaticResource BrushBorder}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="8,2,8,2"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding FormattedSize}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushTextSecondary}"/>
                            </Border>

                            <!-- Official Website Link Tag Pill -->
                            <Button Click="WebLink_Click"
                                    ToolTip="{Binding EffectiveWebUrl}"
                                    Cursor="Hand"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TagBorder"
                                                Background="#1438BDF8"
                                                BorderBrush="#4538BDF8"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="8,2,8,2">
                                            <TextBlock x:Name="TagText"
                                                       Text="{Binding OfficialDomainTag}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#38BDF8"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TagBorder" Property="Background" Value="#2838BDF8"/>
                                                <Setter TargetName="TagBorder" Property="BorderBrush" Value="#38BDF8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- ID Text -->
                            <TextBlock Text="{Binding Id}"
                                       Style="{StaticResource TextBody}"
                                       FontSize="11"
                                       Foreground="{StaticResource BrushTextSecondary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 3. Upgrade Button & Official Link -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <ContentControl Loaded="OfficialLinkContainer_Loaded" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <Button Content="⬆" Tag="Upgrade"
                                Style="{StaticResource ExpandableAccentButton}"
                                VerticalAlignment="Center"
                                Click="UpgradeButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <lottie:LottieAnimationView Width="26" Height="26" AutoPlay="True" RepeatCount="-1"
                                            services:LottieHelper.AssetName="update_sync.json" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Update Center" Style="{StaticResource TextHeader}" FontSize="26" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Keep 180Hz Setup Hub and your installed PC applications up to date with the latest versions and patches."
                       Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ======================================================== -->
        <!--  180Hz Setup Hub Native App Self-Updater (GitHub Live)   -->
        <!-- ======================================================== -->
        <Border Grid.Row="1" Margin="0,0,0,20" CornerRadius="10"
                Background="{DynamicResource BrushSurface}"
                BorderBrush="{DynamicResource BrushAccent}"
                BorderThickness="1"
                Padding="18,16"
                ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.45"/>
            </Border.Effect>
            <Grid>
                <!-- Top Edge Highlight Glow -->
                <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                        Background="{DynamicResource BrushAccent}" Opacity="0.4"/>

                <Grid Margin="0,4,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Row: Icon, Title, Version Pills & Action Buttons -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- App Icon -->
                        <Border Grid.Column="0" Width="44" Height="44" CornerRadius="8"
                                Background="{DynamicResource BrushBackground}"
                                BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                Margin="0,0,14,0" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/AppIcon-1024.png"
                                   Width="30" Height="30" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <!-- Title & Version Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="180Hz Setup Hub"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="{DynamicResource BrushTextPrimary}"
                                           VerticalAlignment="Center"/>

                                <!-- Installed Version Badge -->
                                <Border Background="{DynamicResource BrushBackground}"
                                        BorderBrush="{DynamicResource BrushBorder}"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtAppCurrentVersion" Text="Installed: v2.5.0"
                                               FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource BrushTextSecondary}"/>
                                </Border>

                                <!-- GitHub Branch Tag -->
                                <Border Background="#1400FF66"
                                        BorderBrush="#4000FF66"
                                        BorderThickness="1" CornerRadius="4"
                                        Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="⚡ GitHub: main" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                </Border>
                            </StackPanel>

                            <!-- Status Description -->
                            <TextBlock x:Name="TxtAppUpdateStatus"
                                       Text="Check GitHub to verify if a newer application executable or tweak update is available."
                                       Style="{StaticResource TextBody}"
                                       FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnCheckAppUpdate" Content="Check GitHub"
                                    Style="{StaticResource ExpandableOutlineButton}"
                                    Margin="0,0,8,0" Padding="12,6" Height="34"
                                    Click="BtnCheckAppUpdate_Click" ToolTip="Check GitHub repository for newer version"/>

                            <Button x:Name="BtnApplyAppUpdate" Content="🚀 Update App Now"
                                    Style="{StaticResource ExpandableAccentButton}"
                                    Padding="14,6" Height="34"
                                    Click="BtnApplyAppUpdate_Click" ToolTip="Download and install update from GitHub"/>

                            <Button x:Name="BtnForceAppUpdate" Content="Force Sync"
                                    Style="{StaticResource ExpandableOutlineButton}"
                                    Margin="8,0,0,0" Padding="10,6" Height="34"
                                    Click="BtnForceAppUpdate_Click" ToolTip="Force download and replace with latest GitHub exe"/>
                        </StackPanel>
                    </Grid>

                    <!-- Progress Bar Row (Shown when downloading) -->
                    <StackPanel x:Name="PnlAppDownloadProgress" Grid.Row="1" Margin="0,14,0,4" Visibility="Collapsed">
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="TxtAppDownloadBytes" Text="Downloading: 0 MB / 0 MB"
                                       FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                            <TextBlock x:Name="TxtAppDownloadSpeed" Text="0 KB/s" HorizontalAlignment="Right"
                                       FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Grid>
                        <ProgressBar x:Name="PrgAppDownload" Height="6" Maximum="100" Value="0"
                                     Foreground="{DynamicResource BrushAccent}"
                                     Background="{DynamicResource BrushBackground}"
                                     BorderThickness="0"/>
                    </StackPanel>

                    <!-- Release Notes Panel (Collapsible) -->
                    <Border x:Name="PnlAppReleaseNotes" Grid.Row="2" Margin="0,10,0,0"
                            Background="{DynamicResource BrushBackground}"
                            BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                            CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Release Notes &amp; Changes:" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtAppReleaseNotes" Text=""
                                       FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 3rd-Party Applications Section Header -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="SummaryText" Text="Checking for updates…" VerticalAlignment="Center"
                       Style="{StaticResource TextBody}" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Tag="Refresh" Style="{StaticResource ExpandableOutlineButton}" Margin="0,0,8,0" Click="Refresh_Click">
                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                            services:LottieHelper.AssetName="update_sync.json"/>
            </Button>
            <Button x:Name="UpgradeAllButton" Grid.Column="2" Tag="Upgrade All" Style="{StaticResource ExpandableAccentButton}" Click="UpgradeAll_Click">
                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                            services:LottieHelper.AssetName="rocket.json"/>
            </Button>
        </Grid>

        <!-- 3rd-Party Applications List -->
        <ListBox Grid.Row="3"
                 x:Name="UpdatesListBox"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.CanContentScroll="True"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemContainerStyle="{StaticResource CleanListBoxItem}"
                 ItemTemplate="{StaticResource UpgradableAppTemplate}"/>
    </Grid>
</UserControl>
