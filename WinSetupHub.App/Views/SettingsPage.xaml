<UserControl x:Class="SetupHub180Hz.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:services="clr-namespace:SetupHub180Hz.Services">

    <UserControl.Resources>
        <!-- ToggleButton Template for ComboBox Chrome -->
        <ControlTemplate x:Key="ComboBoxToggleButtonTemplate" TargetType="{x:Type ToggleButton}">
            <Border x:Name="Border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="32"/>
                    </Grid.ColumnDefinitions>
                    <Path x:Name="Arrow"
                          Grid.Column="1"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0"
                          Stroke="{DynamicResource BrushTextSecondary}"
                          StrokeThickness="1.8"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource BrushAccent}"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                    <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource BrushAccent}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ComboBoxItem Style (Cyber Dark Hover & Selection) -->
        <Style x:Key="SettingComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderThickness="0"
                                CornerRadius="4"
                                Margin="2,1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushAccent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full Cyber-Styled ComboBox -->
        <Style x:Key="SettingComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="Background" Value="{DynamicResource BrushSurfaceHover}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"/>

                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="12,0,32,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade"
                                   VerticalOffset="4">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="{DynamicResource BrushSurface}"
                                            BorderBrush="{DynamicResource BrushBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="6" Opacity="0.75"/>
                                        </Border.Effect>
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="DropDownBorder" Property="MinHeight" Value="50"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleButton" Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <lottie:LottieAnimationView Width="24" Height="24" AutoPlay="True" RepeatCount="-1"
                                            services:LottieHelper.AssetName="settings_dial.json" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Settings" Style="{StaticResource TextHeader}" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Configure 180Hz Setup Hub executable auto-updates, system startup, notifications, and preferences."
                       Style="{StaticResource TextBody}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Settings Cards ScrollViewer -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource CleanScrollViewer}">
            <StackPanel MaxWidth="1100" HorizontalAlignment="Stretch">

                <!-- ======================================================== -->
                <!--  1. 180Hz Setup Hub EXE Auto-Update Card (GitHub Live)   -->
                <!-- ======================================================== -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1.2">
                    <Grid>
                        <!-- Top Accent Highlight -->
                        <Border Height="1" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                                Background="{DynamicResource BrushAccent}" Opacity="0.5"/>

                        <StackPanel Margin="2,4,2,0">
                            <!-- Card Header -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8"
                                        Background="{DynamicResource BrushBackground}"
                                        BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                        Margin="0,0,12,0" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/AppIcon-1024.png"
                                           Width="26" Height="26" Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="180Hz Setup Hub .EXE Direct Auto-Updater" Style="{StaticResource TextSubHeader}" VerticalAlignment="Center"/>
                                        <Border Background="#1400FF66" BorderBrush="#4000FF66" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="10,0,0,0">
                                            <TextBlock Text="⚡ GitHub Live Sync" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Update the application executable directly from GitHub with 1-click in-place binary swap. No manual browser downloads or reinstalling needed."
                                               Style="{StaticResource TextBody}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox x:Name="ChkAutoCheckAppUpdates"
                                      Style="{StaticResource AppCheckBox}"
                                      Content="Automatically check GitHub for newer 180Hz Setup Hub builds when application starts"
                                      Margin="0,0,0,14"
                                      Checked="ChkAutoCheckAppUpdates_Changed"
                                      Unchecked="ChkAutoCheckAppUpdates_Changed"/>

                            <!-- Version Details & Action Buttons -->
                            <Border Background="{DynamicResource BrushBackground}"
                                    BorderBrush="{DynamicResource BrushBorder}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Version & Status -->
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Installed EXE Version: " Style="{StaticResource TextBody}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}"/>
                                            <TextBlock x:Name="TxtSettingsAppVersion" Text="v2.5.0" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                            <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="8,0,0,0">
                                                <TextBlock Text="GitHub: main" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSettingsAppUpdateStatus" Text="Ready to check for updates from GitHub." Style="{StaticResource TextBody}" FontSize="12" Margin="0,6,0,0"/>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="BtnSettingsCheckUpdate" Content="Check GitHub"
                                                Style="{StaticResource ExpandableOutlineButton}"
                                                Margin="0,0,8,0" Padding="12,6" Height="34"
                                                Click="BtnSettingsCheckUpdate_Click" ToolTip="Check GitHub repository for newer version"/>

                                        <Button x:Name="BtnSettingsUpdateNow" Content="🚀 Update EXE Now"
                                                Style="{StaticResource ExpandableAccentButton}"
                                                Padding="14,6" Height="34"
                                                Click="BtnSettingsUpdateNow_Click" ToolTip="Download and apply update from GitHub immediately"/>

                                        <Button x:Name="BtnSettingsForceUpdate" Content="Force Re-download"
                                                Style="{StaticResource ExpandableOutlineButton}"
                                                Margin="8,0,0,0" Padding="10,6" Height="34"
                                                Click="BtnSettingsForceUpdate_Click" ToolTip="Directly re-download latest executable from GitHub and swap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Live Download Progress Panel -->
                            <StackPanel x:Name="PnlSettingsDownloadProgress" Margin="0,6,0,4" Visibility="Collapsed">
                                <Grid Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtSettingsDownloadBytes" Text="Downloading: 0 MB / 0 MB"
                                               FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}"/>
                                    <TextBlock x:Name="TxtSettingsDownloadSpeed" Text="0 KB/s" HorizontalAlignment="Right"
                                               FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                                </Grid>
                                <ProgressBar x:Name="PrgSettingsDownload" Height="6" Maximum="100" Value="0"
                                             Foreground="{DynamicResource BrushAccent}"
                                             Background="{DynamicResource BrushBackground}"
                                             BorderThickness="0"/>
                            </StackPanel>

                            <!-- Release Notes Panel -->
                            <Border x:Name="PnlSettingsReleaseNotes" Margin="0,4,0,0"
                                    Background="{DynamicResource BrushBackground}"
                                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1"
                                    CornerRadius="6" Padding="12,8" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="What's New in Latest GitHub Release:" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource BrushAccent}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="TxtSettingsReleaseNotes" Text=""
                                               FontSize="11" Foreground="{DynamicResource BrushTextSecondary}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Startup Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Startup" Style="{StaticResource TextSubHeader}" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure how 180Hz Setup Hub integrates with Windows launch."
                                   Style="{StaticResource TextBody}" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ChkAutoStart"
                                  Style="{StaticResource AppCheckBox}"
                                  Content="Launch 180Hz Setup Hub when Windows starts"
                                  Checked="ChkAutoStart_Changed"
                                  Unchecked="ChkAutoStart_Changed"/>
                    </StackPanel>
                </Border>

                <!-- 3. Notifications Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Notifications &amp; Updates" Style="{StaticResource TextSubHeader}" Margin="0,0,0,4"/>
                        <TextBlock Text="Manage background notifications and automated update check frequency."
                                   Style="{StaticResource TextBody}" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ChkNotifications"
                                  Style="{StaticResource AppCheckBox}"
                                  Content="Show Windows toast notifications for completed actions"
                                  Margin="0,0,0,16"
                                  Checked="ChkNotifications_Changed"
                                  Unchecked="ChkNotifications_Changed"/>

                        <TextBlock Text="Automated Update Check Frequency" Style="{StaticResource TextBody}"
                                   FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,0,8"/>

                        <ComboBox x:Name="CmbUpdateFrequency"
                                  Style="{StaticResource SettingComboBox}"
                                  Width="240"
                                  HorizontalAlignment="Left"
                                  SelectionChanged="CmbUpdateFrequency_SelectionChanged">
                            <ComboBoxItem Content="Never" Tag="0"/>
                            <ComboBoxItem Content="Every 6 hours" Tag="6"/>
                            <ComboBoxItem Content="Every 12 hours" Tag="12"/>
                            <ComboBoxItem Content="Daily" Tag="24"/>
                            <ComboBoxItem Content="Weekly" Tag="168"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- 4. Safety Card -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Safety" Style="{StaticResource TextSubHeader}" Margin="0,0,0,4"/>
                        <TextBlock Text="Safety controls for system-wide cleanup and application uninstallation."
                                   Style="{StaticResource TextBody}" Margin="0,0,0,14"/>

                        <CheckBox x:Name="ChkRequireAdmin"
                                  Style="{StaticResource AppCheckBox}"
                                  Content="Require Administrator privileges for cleanup and uninstallation (re-elevates if needed)"
                                  Checked="ChkRequireAdmin_Changed"
                                  Unchecked="ChkRequireAdmin_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
