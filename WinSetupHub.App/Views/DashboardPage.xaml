<UserControl x:Class="SetupHub180Hz.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp">

    <UserControl.Resources>
        <!-- Interactive Animated Module Card Style -->
        <Style x:Key="DashboardTile" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource BrushSurface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinHeight" Value="124"/>
            <Setter Property="Padding" Value="18,16"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{StaticResource BrushSurfaceHover}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource BrushAccent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="-3" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{StaticResource BrushSurface}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="{StaticResource BrushAccentPressed}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                             To="0" Duration="0:0:0.06"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Staggered Entrance Animations -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeaderBlock"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.2"/>
                    <DoubleAnimation Storyboard.TargetName="HeaderTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="10" To="0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="HeroCard"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.06" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="HeroTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="12" To="0" BeginTime="0:0:0.06" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="SystemStatsSection"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.09" Duration="0:0:0.22"/>
                    <DoubleAnimation Storyboard.TargetName="StatsTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="13" To="0" BeginTime="0:0:0.09" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="ModulesSection"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" BeginTime="0:0:0.14" Duration="0:0:0.24"/>
                    <DoubleAnimation Storyboard.TargetName="ModulesTransform"
                                     Storyboard.TargetProperty="Y"
                                     From="14" To="0" BeginTime="0:0:0.14" Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer Style="{StaticResource CleanScrollViewer}" Padding="32,24,32,32">
        <Grid MaxWidth="1160" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. Header Block with Status -->
            <Grid x:Name="HeaderBlock" Grid.Row="0" Margin="0,0,0,20">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="HeaderTransform" Y="0"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,10,0">
                            <TextBlock Text="⚡ 180Hz PRO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                        </Border>
                        <TextBlock Text="COMMAND CENTER" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushAccent}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Dashboard" Style="{StaticResource TextHeader}" FontSize="26"/>
                    <TextBlock Text="System status, feature flow, and quick actions." Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Engine Status and Refresh Action -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{DynamicResource BrushSurface}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrushSuccess}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="EngineStatusText" Text="ENGINE READY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushSuccess}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="RefreshSummaryButton" Content="🔄" Tag="Refresh" Style="{StaticResource ExpandableOutlineButton}" Margin="8,0,0,0" Click="RefreshSummary_Click"/>
                </StackPanel>
            </Grid>

            <!-- 2. Hero Card -->
            <Border x:Name="HeroCard" Grid.Row="1" Style="{StaticResource Card}" CornerRadius="10" Padding="26" Margin="0,0,0,24">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="HeroTransform" Y="0"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="220"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OPTIMIZE. MONITOR. DEPLOY." FontSize="22" FontWeight="Bold"
                                   Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"/>
                        <TextBlock Text="Automated app setup, update tracking, and junk cleanup — all in one place."
                                   Style="{StaticResource TextBody}" FontSize="13" Margin="0,8,0,18" MaxWidth="620" HorizontalAlignment="Left"/>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,7" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔔" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="UpdateSummaryText" Text="Checking for updates…" Style="{StaticResource TextBody}"
                                               Foreground="{DynamicResource BrushAccent}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="6" Padding="12,7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛡️" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Windows 64-bit Ready" Style="{StaticResource TextBody}"
                                               Foreground="{DynamicResource BrushTextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Right Module Counter Card -->
                    <Border Grid.Column="1" Background="{DynamicResource BrushBackground}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="10" Padding="18" VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource BrushAccent}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="180Hz HUB" Foreground="{DynamicResource BrushAccent}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource AppFont}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="ModuleCountText" Text="7" FontSize="36" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,-2,0,0"/>
                            <TextBlock Text="MODULES ACTIVE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 2b. Live System Stats -->
            <UniformGrid x:Name="SystemStatsSection" Grid.Row="2" Columns="3" Margin="0,0,0,24">
                <UniformGrid.RenderTransform>
                    <TranslateTransform x:Name="StatsTransform" Y="0"/>
                </UniformGrid.RenderTransform>

                <!-- 1. CPU Usage -->
                <Border Style="{StaticResource Card}" CornerRadius="10" Padding="18,16" Margin="0,0,8,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="CPU LOAD" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                            <TextBlock x:Name="CpuPercentText" Text="0.0%" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}"/>
                            <TextBlock Text=" active" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,3"/>
                        </StackPanel>

                        <ProgressBar Grid.Row="2" x:Name="CpuProgressBar" Style="{StaticResource FlatProgressBar}"
                                     Minimum="0" Maximum="100" Value="0"/>
                    </Grid>
                </Border>

                <!-- 2. Memory Usage -->
                <Border Style="{StaticResource Card}" CornerRadius="10" Padding="18,16" Margin="4,0,4,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="🧠" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="MEMORY (RAM)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                            <TextBlock x:Name="RamUsageText" Text="0.0 / 0.0 GB" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="RamPercentText" Text=" (0%)" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                        </StackPanel>

                        <ProgressBar Grid.Row="2" x:Name="RamProgressBar" Style="{StaticResource FlatProgressBar}"
                                     Minimum="0" Maximum="100" Value="0"/>
                    </Grid>
                </Border>

                <!-- 3. Disk Space (C:) -->
                <Border Style="{StaticResource Card}" CornerRadius="10" Padding="18,16" Margin="8,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="💾" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="DISK (C:)" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Bottom">
                            <TextBlock x:Name="DiskUsageText" Text="0.0 GB Free" FontSize="20" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" VerticalAlignment="Bottom"/>
                            <TextBlock x:Name="DiskTotalText" Text=" of 0.0 GB" FontSize="12" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                        </StackPanel>

                        <ProgressBar Grid.Row="2" x:Name="DiskProgressBar" Style="{StaticResource FlatProgressBar}"
                                     Minimum="0" Maximum="100" Value="0"/>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- 3. Modules Section -->
            <StackPanel x:Name="ModulesSection" Grid.Row="3">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="ModulesTransform" Y="0"/>
                </StackPanel.RenderTransform>

                <Grid Margin="0,0,0,12">
                    <TextBlock Text="COMMAND MODULES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="Click any tile to jump directly into the module" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 6 Responsive Module Tiles in 3x2 Grid -->
                <UniformGrid Columns="3" Rows="2">
                    <!-- 01 Setup Apps -->
                    <Button x:Name="TileSetupApps" Style="{StaticResource DashboardTile}" Margin="0,0,8,12" Click="TileSetupApps_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="01" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                                ResourcePath="pack://application:,,,/Assets/Lottie/gears.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Setup Apps" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,10,0,4"/>
                            <TextBlock Grid.Row="2" Text="Search winget catalog and install essential apps in one click."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 02 Update Center -->
                    <Button x:Name="TileUpdateCenter" Style="{StaticResource DashboardTile}" Margin="4,0,4,12" Click="TileUpdateCenter_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="02" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                                ResourcePath="pack://application:,,,/Assets/Lottie/loading_disc.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Update Center" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,10,0,4"/>
                            <TextBlock Grid.Row="2" Text="Detect out-of-date apps and upgrade them individually or all at once."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 03 Uninstaller -->
                    <Button x:Name="TileUninstaller" Style="{StaticResource DashboardTile}" Margin="8,0,0,12" Click="TileUninstaller_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="03" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="🗑️" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Uninstaller" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,10,0,4"/>
                            <TextBlock Grid.Row="2" Text="View all installed applications and uninstall unwanted software."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 04 Cleanup -->
                    <Button x:Name="TileCleanup" Style="{StaticResource DashboardTile}" Margin="0,0,8,0" Click="TileCleanup_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="04" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock Text="🧹" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Cleanup" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,10,0,4"/>
                            <TextBlock Grid.Row="2" Text="Scan and safely purge temporary files, caches, and prefetch items."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 05 Activity -->
                    <Button x:Name="TileActivity" Style="{StaticResource DashboardTile}" Margin="4,0,4,0" Click="TileActivity_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="05" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                                ResourcePath="pack://application:,,,/Assets/Lottie/wave.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Activity" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,10,0,4"/>
                            <TextBlock Grid.Row="2" Text="Live event log and telemetry history for installs, updates and cleanups."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>

                    <!-- 06 Storage -->
                    <Button x:Name="TileStorage" Style="{StaticResource DashboardTile}" Margin="8,0,0,0" Click="TileStorage_Click">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="{StaticResource BrushBackground}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="06" Foreground="{StaticResource BrushAccent}" FontSize="10" FontWeight="Bold"/>
                                    </Border>
                                    <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                                                ResourcePath="pack://application:,,,/Assets/Lottie/scan.json"
                                                                VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="→" Foreground="{StaticResource BrushAccent}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Storage" FontFamily="{StaticResource AppFont}" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource BrushTextPrimary}" Margin="0,10,0,4"/>
                            <TextBlock Grid.Row="2" Text="View disk footprint and open the local application data directory."
                                       Style="{StaticResource TextBody}" FontSize="12"/>
                        </Grid>
                    </Button>
                </UniformGrid>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
