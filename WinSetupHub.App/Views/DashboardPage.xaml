<UserControl x:Class="SetupHub180Hz.Views.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Style="{StaticResource CleanScrollViewer}" Padding="28">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
            <TextBlock Text="Dashboard" Style="{StaticResource TextHeader}"/>
            <TextBlock Text="System status, feature flow, and quick actions." Style="{StaticResource TextBody}" Margin="0,4,0,20"/>

            <!-- Hero card -->
            <Border Style="{StaticResource Card}" Padding="24" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="OPTIMIZE. MONITOR. DEPLOY." FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"/>
                        <TextBlock Text="Automated app setup, update tracking, and junk cleanup — all in one place."
                                   Style="{StaticResource TextBody}" Margin="0,6,0,16"/>
                        <TextBlock x:Name="UpdateSummaryText" Text="Checking for updates…" Style="{StaticResource TextBody}"
                                   Foreground="{StaticResource BrushAccent}" FontWeight="SemiBold"/>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BrushBackground}" CornerRadius="8" Padding="16">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="180Hz" Foreground="{StaticResource BrushAccent}" FontSize="12"
                                       HorizontalAlignment="Center" FontFamily="{StaticResource AppFont}"/>
                            <TextBlock x:Name="ModuleCountText" Text="6" FontSize="34" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Modules" Style="{StaticResource TextBody}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Module tiles -->
            <UniformGrid Columns="3" Rows="2">
                <Button x:Name="TileSetupApps" Style="{StaticResource OutlineButton}" Margin="0,0,8,8" Padding="16" Click="TileSetupApps_Click">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="01" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                        <TextBlock Text="Setup Apps" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileUpdateCenter" Style="{StaticResource OutlineButton}" Margin="4,0,4,8" Padding="16" Click="TileUpdateCenter_Click">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="02" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                        <TextBlock Text="Update Center" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileUninstaller" Style="{StaticResource OutlineButton}" Margin="8,0,0,8" Padding="16" Click="TileUninstaller_Click">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="03" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                        <TextBlock Text="Uninstaller" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileCleanup" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" Padding="16" Click="TileCleanup_Click">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="04" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                        <TextBlock Text="Cleanup" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileActivity" Style="{StaticResource OutlineButton}" Margin="4,0,4,0" Padding="16" Click="TileActivity_Click">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="05" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                        <TextBlock Text="Activity" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                </Button>
                <Button x:Name="TileStorage" Style="{StaticResource OutlineButton}" Margin="8,0,0,0" Padding="16" Click="TileStorage_Click">
                    <StackPanel HorizontalAlignment="Left">
                        <TextBlock Text="06" Foreground="{StaticResource BrushTextSecondary}" FontSize="11"/>
                        <TextBlock Text="Storage" Foreground="{StaticResource BrushTextPrimary}" FontWeight="SemiBold" FontSize="14"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
