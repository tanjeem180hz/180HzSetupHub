<UserControl x:Class="SetupHub180Hz.Views.ActivityPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:SetupHub180Hz.Converters"
             xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
             xmlns:services="clr-namespace:SetupHub180Hz.Services">
    <UserControl.Resources>
        <conv:ActivityTypeToBrushConverter x:Key="TypeToBrush"/>
    </UserControl.Resources>
    <Grid Margin="32,24,32,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <lottie:LottieAnimationView Width="26" Height="26" AutoPlay="True" RepeatCount="-1"
                                            services:LottieHelper.AssetName="activity_pulse.json" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="Activity Feed" Style="{StaticResource TextHeader}" FontSize="26" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="Live immutable event ledger of installations, upgrades, cleanups, and service lifecycle events."
                       Style="{StaticResource TextBody}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Toolbar -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="LogCountText" Text="Live event feed active" VerticalAlignment="Center" Style="{StaticResource TextBody}" FontWeight="SemiBold"/>
            <Button Grid.Column="1" Tag="Refresh" Style="{StaticResource ExpandableOutlineButton}" Margin="0,0,8,0" Click="Refresh_Click">
                <lottie:LottieAnimationView Width="16" Height="16" AutoPlay="True" RepeatCount="-1"
                                            services:LottieHelper.AssetName="activity_pulse.json"/>
            </Button>
            <Button Grid.Column="2" Content="✕" Tag="Clear Log" Style="{StaticResource ExpandableDangerButton}" Click="Clear_Click"/>
        </Grid>

        <!-- Log List -->
        <ScrollViewer Grid.Row="2" Style="{StaticResource CleanScrollViewer}">
            <ItemsControl x:Name="LogList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource ListRow}" Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="{Binding Type, Converter={StaticResource TypeToBrush}}"
                                         VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Message}" Style="{StaticResource TextBody}"
                                           Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding TimestampDisplay}" Style="{StaticResource TextBody}"
                                           FontSize="11" Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
