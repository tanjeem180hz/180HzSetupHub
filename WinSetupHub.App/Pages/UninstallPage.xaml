<Page x:Class="WindowsSetupHub.Pages.UninstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PrimaryBgBrush}"
      FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Search + Sort -->
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}"
                    Height="46"
                    x:Name="SearchBox"/>
            <ComboBox Grid.Column="1"
                     Width="140" Height="46"
                     Margin="10,0">
                <ComboBoxItem Content="Sort by Name" IsSelected="True"/>
                <ComboBoxItem Content="Sort by Size"/>
                <ComboBoxItem Content="Sort by Date"/>
            </ComboBox>
            <Button Grid.Column="2"
                   Style="{StaticResource DangerButton}"
                   Content="🗑️  Uninstall Selected"
                   Height="46"
                   Click="UninstallSelected_Click"/>
        </Grid>

        <!-- Info Bar -->
        <Border Grid.Row="1"
               Background="#08E74C3C"
               BorderBrush="#20E74C3C"
               BorderThickness="1"
               CornerRadius="10"
               Padding="18,14"
               Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SelectCountText"
                              Text="🗑️  Select apps to uninstall"
                              FontSize="13" FontWeight="SemiBold"
                              Foreground="White"/>
                    <TextBlock Text="18 apps installed  •  0 selected"
                              FontSize="12" Foreground="#8B8B9E"/>
                </StackPanel>
                <TextBlock Grid.Column="1"
                          Text="Total: 900 MB"
                          FontSize="13"
                          Foreground="#8B8B9E"
                          VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- App List -->
        <ScrollViewer Grid.Row="2">
            <StackPanel x:Name="UninstallList">

                <!-- Item Template -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                       MouseEnter="UninstallItem_MouseEnter"
                       MouseLeave="UninstallItem_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Center" Margin="0,0,14,0"
                                 Checked="AppCheck_Changed"
                                 Unchecked="AppCheck_Changed"/>
                        <Border Grid.Column="1"
                               Background="#204285F4"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="🌐" FontSize="20"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Google Chrome"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v120.0.6099  •  Installed: Jan 10, 2024"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                  Text="120 MB"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center"
                                  Margin="16,0"/>
                        <Button Grid.Column="4"
                               Style="{StaticResource DangerButton}"
                               Content="🗑️  Uninstall"
                               Click="UninstallOne_Click"
                               Tag="Google Chrome"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                       MouseEnter="UninstallItem_MouseEnter"
                       MouseLeave="UninstallItem_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Center" Margin="0,0,14,0"
                                 Checked="AppCheck_Changed"
                                 Unchecked="AppCheck_Changed"/>
                        <Border Grid.Column="1"
                               Background="#200078D4"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="💻" FontSize="20"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Visual Studio Code"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v1.85.1  •  Installed: Dec 5, 2023"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                  Text="380 MB"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center"
                                  Margin="16,0"/>
                        <Button Grid.Column="4"
                               Style="{StaticResource DangerButton}"
                               Content="🗑️  Uninstall"
                               Click="UninstallOne_Click"
                               Tag="VS Code"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                       MouseEnter="UninstallItem_MouseEnter"
                       MouseLeave="UninstallItem_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Center" Margin="0,0,14,0"
                                 Checked="AppCheck_Changed"
                                 Unchecked="AppCheck_Changed"/>
                        <Border Grid.Column="1"
                               Background="#205865F2"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="💬" FontSize="20"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Discord"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v0.0.290  •  Installed: Nov 20, 2023"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                  Text="245 MB"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center"
                                  Margin="16,0"/>
                        <Button Grid.Column="4"
                               Style="{StaticResource DangerButton}"
                               Content="🗑️  Uninstall"
                               Click="UninstallOne_Click"
                               Tag="Discord"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                       MouseEnter="UninstallItem_MouseEnter"
                       MouseLeave="UninstallItem_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Center" Margin="0,0,14,0"
                                 Checked="AppCheck_Changed"
                                 Unchecked="AppCheck_Changed"/>
                        <Border Grid.Column="1"
                               Background="#20FF8C00"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="🎵" FontSize="20"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="VLC Media Player"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v3.0.18  •  Installed: Oct 12, 2023"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                  Text="87 MB"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center"
                                  Margin="16,0"/>
                        <Button Grid.Column="4"
                               Style="{StaticResource DangerButton}"
                               Content="🗑️  Uninstall"
                               Click="UninstallOne_Click"
                               Tag="VLC Player"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,8"
                       MouseEnter="UninstallItem_MouseEnter"
                       MouseLeave="UninstallItem_MouseLeave">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox VerticalAlignment="Center" Margin="0,0,14,0"
                                 Checked="AppCheck_Changed"
                                 Unchecked="AppCheck_Changed"/>
                        <Border Grid.Column="1"
                               Background="#20F05032"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="🔀" FontSize="20"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <TextBlock Text="Git"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v2.42.0  •  Installed: Sep 3, 2023"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                  Text="56 MB"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center"
                                  Margin="16,0"/>
                        <Button Grid.Column="4"
                               Style="{StaticResource DangerButton}"
                               Content="🗑️  Uninstall"
                               Click="UninstallOne_Click"
                               Tag="Git"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
