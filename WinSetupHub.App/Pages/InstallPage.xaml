<Page x:Class="WindowsSetupHub.Pages.InstallPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PrimaryBgBrush}"
      FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" Margin="24,24,24,0">
            <StackPanel>

                <!-- Search + Filter -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Style="{StaticResource SearchBox}"
                            x:Name="TxtSearch"
                            Height="46"
                            TextChanged="TxtSearch_TextChanged"/>
                    <StackPanel Grid.Column="1"
                               Orientation="Horizontal"
                               Margin="12,0,0,0">
                        <ToggleButton Style="{StaticResource FilterButton}"
                                     Content="All"
                                     IsChecked="True"
                                     Margin="0,0,6,0"
                                     Click="Filter_Click"/>
                        <ToggleButton Style="{StaticResource FilterButton}"
                                     Content="Browsers"
                                     Margin="0,0,6,0"
                                     Click="Filter_Click"/>
                        <ToggleButton Style="{StaticResource FilterButton}"
                                     Content="Media"
                                     Margin="0,0,6,0"
                                     Click="Filter_Click"/>
                        <ToggleButton Style="{StaticResource FilterButton}"
                                     Content="Dev Tools"
                                     Margin="0,0,6,0"
                                     Click="Filter_Click"/>
                        <ToggleButton Style="{StaticResource FilterButton}"
                                     Content="Utilities"
                                     Click="Filter_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Stats -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="📦" FontSize="22" Margin="0,0,0,8"/>
                            <TextBlock Text="42"
                                      FontSize="28" FontWeight="Bold"
                                      Foreground="White"/>
                            <TextBlock Text="Total Apps"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                           Grid.Column="1" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="✅" FontSize="22" Margin="0,0,0,8"/>
                            <TextBlock Text="18"
                                      FontSize="28" FontWeight="Bold"
                                      Foreground="#00B294"/>
                            <TextBlock Text="Installed"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                           Grid.Column="2" Margin="4,0">
                        <StackPanel>
                            <TextBlock Text="🔄" FontSize="22" Margin="0,0,0,8"/>
                            <TextBlock Text="5"
                                      FontSize="28" FontWeight="Bold"
                                      Foreground="#FF8C00"/>
                            <TextBlock Text="Updates Ready"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}"
                           Grid.Column="3" Margin="8,0,0,0">
                        <StackPanel>
                            <TextBlock Text="⬇️" FontSize="22" Margin="0,0,0,8"/>
                            <TextBlock Text="24"
                                      FontSize="28" FontWeight="Bold"
                                      Foreground="#0078D4"/>
                            <TextBlock Text="Available"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- App Cards -->
                <TextBlock Text="ALL APPLICATIONS"
                          FontSize="10" FontWeight="Bold"
                          Foreground="#4A4A6A"
                          Margin="0,0,0,12"/>

                <WrapPanel x:Name="AppWrapPanel" Margin="0,0,0,16">

                    <!-- Chrome -->
                    <Border Style="{StaticResource Card}"
                           Width="190" Margin="0,0,10,10"
                           MouseEnter="Card_MouseEnter"
                           MouseLeave="Card_MouseLeave">
                        <StackPanel>
                            <Border Background="#204285F4"
                                   CornerRadius="12" Width="50" Height="50"
                                   HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="🌐" FontSize="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Chrome"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v120.0.6099"
                                      FontSize="11" Foreground="#8B8B9E"
                                      Margin="0,2,0,6"/>
                            <TextBlock Text="Fast and secure browser"
                                      FontSize="11" Foreground="#6B6B8E"
                                      TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#1500B294"
                                   BorderBrush="#4000B294"
                                   BorderThickness="1"
                                   CornerRadius="4" Padding="8,4"
                                   HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="✓ INSTALLED"
                                          FontSize="10" FontWeight="Bold"
                                          Foreground="#00B294"/>
                            </Border>
                            <Button Style="{StaticResource SuccessButton}"
                                   Content="Installed"
                                   HorizontalAlignment="Stretch"
                                   IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- Firefox -->
                    <Border Style="{StaticResource Card}"
                           Width="190" Margin="0,0,10,10"
                           MouseEnter="Card_MouseEnter"
                           MouseLeave="Card_MouseLeave">
                        <StackPanel>
                            <Border Background="#20FF5F1F"
                                   CornerRadius="12" Width="50" Height="50"
                                   HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="🦊" FontSize="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Firefox"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v121.0"
                                      FontSize="11" Foreground="#8B8B9E"
                                      Margin="0,2,0,6"/>
                            <TextBlock Text="Privacy-focused browser"
                                      FontSize="11" Foreground="#6B6B8E"
                                      TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#150078D4"
                                   BorderBrush="#400078D4"
                                   BorderThickness="1"
                                   CornerRadius="4" Padding="8,4"
                                   HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="AVAILABLE"
                                          FontSize="10" FontWeight="Bold"
                                          Foreground="#0078D4"/>
                            </Border>
                            <Button Style="{StaticResource PrimaryButton}"
                                   Content="⬇  Install"
                                   HorizontalAlignment="Stretch"
                                   Click="InstallBtn_Click"
                                   Tag="Firefox"/>
                        </StackPanel>
                    </Border>

                    <!-- VLC -->
                    <Border Style="{StaticResource Card}"
                           Width="190" Margin="0,0,10,10"
                           MouseEnter="Card_MouseEnter"
                           MouseLeave="Card_MouseLeave">
                        <StackPanel>
                            <Border Background="#20FF8C00"
                                   CornerRadius="12" Width="50" Height="50"
                                   HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="🎵" FontSize="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="VLC Player"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v3.0.18"
                                      FontSize="11" Foreground="#8B8B9E"
                                      Margin="0,2,0,6"/>
                            <TextBlock Text="Universal media player"
                                      FontSize="11" Foreground="#6B6B8E"
                                      TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#15FF8C00"
                                   BorderBrush="#40FF8C00"
                                   BorderThickness="1"
                                   CornerRadius="4" Padding="8,4"
                                   HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="⬆ UPDATE"
                                          FontSize="10" FontWeight="Bold"
                                          Foreground="#FF8C00"/>
                            </Border>
                            <Button Background="#15FF8C00"
                                   Foreground="#FF8C00"
                                   BorderThickness="1"
                                   BorderBrush="#40FF8C00"
                                   Content="Update Now"
                                   HorizontalAlignment="Stretch"
                                   Padding="0,9"
                                   Cursor="Hand"
                                   Click="UpdateBtn_Click"
                                   Tag="VLC Player">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="8"
                                               Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- VS Code -->
                    <Border Style="{StaticResource Card}"
                           Width="190" Margin="0,0,10,10"
                           MouseEnter="Card_MouseEnter"
                           MouseLeave="Card_MouseLeave">
                        <StackPanel>
                            <Border Background="#200078D4"
                                   CornerRadius="12" Width="50" Height="50"
                                   HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="💻" FontSize="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="VS Code"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v1.85.1"
                                      FontSize="11" Foreground="#8B8B9E"
                                      Margin="0,2,0,6"/>
                            <TextBlock Text="Powerful code editor"
                                      FontSize="11" Foreground="#6B6B8E"
                                      TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#1500B294"
                                   BorderBrush="#4000B294"
                                   BorderThickness="1"
                                   CornerRadius="4" Padding="8,4"
                                   HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="✓ INSTALLED"
                                          FontSize="10" FontWeight="Bold"
                                          Foreground="#00B294"/>
                            </Border>
                            <Button Style="{StaticResource SuccessButton}"
                                   Content="Installed"
                                   HorizontalAlignment="Stretch"
                                   IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- 7-Zip -->
                    <Border Style="{StaticResource Card}"
                           Width="190" Margin="0,0,10,10"
                           MouseEnter="Card_MouseEnter"
                           MouseLeave="Card_MouseLeave">
                        <StackPanel>
                            <Border Background="#2000B294"
                                   CornerRadius="12" Width="50" Height="50"
                                   HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="🗜️" FontSize="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="7-Zip"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v23.01"
                                      FontSize="11" Foreground="#8B8B9E"
                                      Margin="0,2,0,6"/>
                            <TextBlock Text="Free file archiver"
                                      FontSize="11" Foreground="#6B6B8E"
                                      TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#150078D4"
                                   BorderBrush="#400078D4"
                                   BorderThickness="1"
                                   CornerRadius="4" Padding="8,4"
                                   HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="AVAILABLE"
                                          FontSize="10" FontWeight="Bold"
                                          Foreground="#0078D4"/>
                            </Border>
                            <Button Style="{StaticResource PrimaryButton}"
                                   Content="⬇  Install"
                                   HorizontalAlignment="Stretch"
                                   Click="InstallBtn_Click"
                                   Tag="7-Zip"/>
                        </StackPanel>
                    </Border>

                    <!-- Discord -->
                    <Border Style="{StaticResource Card}"
                           Width="190" Margin="0,0,10,10"
                           MouseEnter="Card_MouseEnter"
                           MouseLeave="Card_MouseLeave">
                        <StackPanel>
                            <Border Background="#205865F2"
                                   CornerRadius="12" Width="50" Height="50"
                                   HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="💬" FontSize="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Discord"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v0.0.290"
                                      FontSize="11" Foreground="#8B8B9E"
                                      Margin="0,2,0,6"/>
                            <TextBlock Text="Voice, video, text chat"
                                      FontSize="11" Foreground="#6B6B8E"
                                      TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#1500B294"
                                   BorderBrush="#4000B294"
                                   BorderThickness="1"
                                   CornerRadius="4" Padding="8,4"
                                   HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="✓ INSTALLED"
                                          FontSize="10" FontWeight="Bold"
                                          Foreground="#00B294"/>
                            </Border>
                            <Button Style="{StaticResource SuccessButton}"
                                   Content="Installed"
                                   HorizontalAlignment="Stretch"
                                   IsEnabled="False"/>
                        </StackPanel>
                    </Border>

                    <!-- Git -->
                    <Border Style="{StaticResource Card}"
                           Width="190" Margin="0,0,10,10"
                           MouseEnter="Card_MouseEnter"
                           MouseLeave="Card_MouseLeave">
                        <StackPanel>
                            <Border Background="#20F05032"
                                   CornerRadius="12" Width="50" Height="50"
                                   HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="🔀" FontSize="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Git"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v2.42.0"
                                      FontSize="11" Foreground="#8B8B9E"
                                      Margin="0,2,0,6"/>
                            <TextBlock Text="Version control system"
                                      FontSize="11" Foreground="#6B6B8E"
                                      TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#15FF8C00"
                                   BorderBrush="#40FF8C00"
                                   BorderThickness="1"
                                   CornerRadius="4" Padding="8,4"
                                   HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="⬆ UPDATE"
                                          FontSize="10" FontWeight="Bold"
                                          Foreground="#FF8C00"/>
                            </Border>
                            <Button Style="{StaticResource PrimaryButton}"
                                   Content="Update Now"
                                   HorizontalAlignment="Stretch"
                                   Click="UpdateBtn_Click"
                                   Tag="Git"/>
                        </StackPanel>
                    </Border>

                    <!-- Spotify -->
                    <Border Style="{StaticResource Card}"
                           Width="190" Margin="0,0,10,10"
                           MouseEnter="Card_MouseEnter"
                           MouseLeave="Card_MouseLeave">
                        <StackPanel>
                            <Border Background="#201ED760"
                                   CornerRadius="12" Width="50" Height="50"
                                   HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="🎧" FontSize="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Spotify"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v1.2.26"
                                      FontSize="11" Foreground="#8B8B9E"
                                      Margin="0,2,0,6"/>
                            <TextBlock Text="Music streaming platform"
                                      FontSize="11" Foreground="#6B6B8E"
                                      TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Border Background="#150078D4"
                                   BorderBrush="#400078D4"
                                   BorderThickness="1"
                                   CornerRadius="4" Padding="8,4"
                                   HorizontalAlignment="Left" Margin="0,0,0,8">
                                <TextBlock Text="AVAILABLE"
                                          FontSize="10" FontWeight="Bold"
                                          Foreground="#0078D4"/>
                            </Border>
                            <Button Style="{StaticResource PrimaryButton}"
                                   Content="⬇  Install"
                                   HorizontalAlignment="Stretch"
                                   Click="InstallBtn_Click"
                                   Tag="Spotify"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Progress Bar Bottom -->
        <Border x:Name="ProgressSection"
               Grid.Row="1"
               Style="{StaticResource Card}"
               Margin="24,8,24,16"
               Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⬇️" FontSize="22"
                          VerticalAlignment="Center"
                          Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="ProgressLabel"
                              Text="Installing..."
                              FontSize="13" FontWeight="SemiBold"
                              Foreground="White" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="InstallProgressBar"
                                Value="0" Maximum="100"
                                Height="8" Foreground="#0078D4"/>
                    <TextBlock x:Name="ProgressPct"
                              Text="0%"
                              FontSize="11" Foreground="#8B8B9E"
                              Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="2"
                       Style="{StaticResource DangerButton}"
                       Content="✕  Cancel"
                       Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       Click="CancelInstall_Click"/>
            </Grid>
        </Border>
    </Grid>
</Page>
