<Page x:Class="WindowsSetupHub.Pages.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PrimaryBgBrush}"
      FontFamily="Segoe UI">

    <ScrollViewer Margin="24">
        <StackPanel>

            <!-- Hero Card -->
            <Border CornerRadius="16" Padding="28" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0078D4" Offset="0"/>
                        <GradientStop Color="#00B294" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="🧹  PC Health Check"
                                  FontSize="22" FontWeight="Bold"
                                  Foreground="White"/>
                        <TextBlock Text="Last scan: Never  •  Run a scan to find issues"
                                  FontSize="13"
                                  Foreground="#AAFFFFFF"
                                  Margin="0,6,0,18"/>
                        <Button Content="▶   Start Full Scan"
                               Background="White"
                               Foreground="#0078D4"
                               FontSize="14" FontWeight="Bold"
                               Padding="20,12"
                               BorderThickness="0"
                               HorizontalAlignment="Left"
                               Cursor="Hand"
                               Click="StartScan_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                           CornerRadius="8"
                                           Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                              Text="🛡️"
                              FontSize="80"
                              Opacity="0.25"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Cleanup Grid -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <!-- Temp Files -->
                <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                    <StackPanel>
                        <Border Background="#20FF8C00"
                               CornerRadius="10" Width="48" Height="48"
                               HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="🗂️" FontSize="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Temp Files"
                                  FontSize="16" FontWeight="Bold"
                                  Foreground="White"/>
                        <TextBlock Text="2.4 GB found"
                                  FontSize="12" Foreground="#FF8C00"
                                  FontWeight="SemiBold" Margin="0,4,0,10"/>
                        <ProgressBar Value="68" Maximum="100"
                                    Height="6" Foreground="#FF8C00"
                                    Margin="0,0,0,4"/>
                        <TextBlock Text="68% of limit"
                                  FontSize="11" Foreground="#8B8B9E"
                                  Margin="0,0,0,12"/>
                        <Button Content="🗑️  Clean Now"
                               Background="#15FF8C00"
                               Foreground="#FF8C00"
                               BorderBrush="#40FF8C00"
                               BorderThickness="1"
                               Padding="0,10"
                               HorizontalAlignment="Stretch"
                               Cursor="Hand"
                               Click="CleanTemp_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                           BorderBrush="{TemplateBinding BorderBrush}"
                                           BorderThickness="{TemplateBinding BorderThickness}"
                                           CornerRadius="8"
                                           Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Registry -->
                <Border Style="{StaticResource Card}"
                       Grid.Column="1" Margin="4,0">
                    <StackPanel>
                        <Border Background="#200078D4"
                               CornerRadius="10" Width="48" Height="48"
                               HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="🔑" FontSize="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Registry"
                                  FontSize="16" FontWeight="Bold"
                                  Foreground="White"/>
                        <TextBlock Text="486 issues found"
                                  FontSize="12" Foreground="#0078D4"
                                  FontWeight="SemiBold" Margin="0,4,0,10"/>
                        <ProgressBar Value="45" Maximum="100"
                                    Height="6" Foreground="#0078D4"
                                    Margin="0,0,0,4"/>
                        <TextBlock Text="45% corruption rate"
                                  FontSize="11" Foreground="#8B8B9E"
                                  Margin="0,0,0,12"/>
                        <Button Style="{StaticResource PrimaryButton}"
                               Content="🔧  Fix Issues"
                               HorizontalAlignment="Stretch"
                               Click="FixRegistry_Click"/>
                    </StackPanel>
                </Border>

                <!-- Startup -->
                <Border Style="{StaticResource Card}"
                       Grid.Column="2" Margin="8,0,0,0">
                    <StackPanel>
                        <Border Background="#2000B294"
                               CornerRadius="10" Width="48" Height="48"
                               HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="⚡" FontSize="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Startup Apps"
                                  FontSize="16" FontWeight="Bold"
                                  Foreground="White"/>
                        <TextBlock Text="12 apps slowing boot"
                                  FontSize="12" Foreground="#00B294"
                                  FontWeight="SemiBold" Margin="0,4,0,10"/>
                        <ProgressBar Value="80" Maximum="100"
                                    Height="6" Foreground="#00B294"
                                    Margin="0,0,0,4"/>
                        <TextBlock Text="Boot time: 28 seconds"
                                  FontSize="11" Foreground="#8B8B9E"
                                  Margin="0,0,0,12"/>
                        <Button Style="{StaticResource SuccessButton}"
                               Content="⚙️  Manage"
                               HorizontalAlignment="Stretch"
                               Click="ManageStartup_Click"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Disk Usage -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="💾  Disk Usage Analysis"
                              FontSize="16" FontWeight="Bold"
                              Foreground="White" Margin="0,0,0,16"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Circle -->
                        <Border Width="120" Height="120"
                               CornerRadius="60"
                               Margin="0,0,24,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0078D4" Offset="0"/>
                                    <GradientStop Color="#00B294" Offset="0.6"/>
                                    <GradientStop Color="#FF8C00" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border Width="80" Height="80"
                                   CornerRadius="40"
                                   Background="#1A1A2E">
                                <StackPanel VerticalAlignment="Center"
                                           HorizontalAlignment="Center">
                                    <TextBlock Text="67%"
                                              FontSize="20" FontWeight="Bold"
                                              Foreground="White"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Used"
                                              FontSize="10" Foreground="#8B8B9E"
                                              HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- Bars -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="#0078D4"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="System Files"
                                          FontSize="12" Foreground="#8B8B9E"
                                          VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="2" Value="45" Maximum="100"
                                            Height="6" Foreground="#0078D4"/>
                                <TextBlock Grid.Column="3" Text="124 GB"
                                          FontSize="12" Foreground="White"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="#00B294"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Applications"
                                          FontSize="12" Foreground="#8B8B9E"
                                          VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="2" Value="30" Maximum="100"
                                            Height="6" Foreground="#00B294"/>
                                <TextBlock Grid.Column="3" Text="84 GB"
                                          FontSize="12" Foreground="White"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="#FF8C00"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Junk Files"
                                          FontSize="12" Foreground="#8B8B9E"
                                          VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="2" Value="8" Maximum="100"
                                            Height="6" Foreground="#FF8C00"/>
                                <TextBlock Grid.Column="3" Text="2.4 GB"
                                          FontSize="12" Foreground="#FF8C00"
                                          FontWeight="SemiBold"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Fill="#4A4A6A"
                                        VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="Free Space"
                                          FontSize="12" Foreground="#8B8B9E"
                                          VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="2" Value="33" Maximum="100"
                                            Height="6" Foreground="#4A4A6A"/>
                                <TextBlock Grid.Column="3" Text="92 GB"
                                          FontSize="12" Foreground="#00B294"
                                          FontWeight="SemiBold"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
