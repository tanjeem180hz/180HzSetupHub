<Page x:Class="WindowsSetupHub.Pages.UpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PrimaryBgBrush}"
      FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Update All Banner -->
        <Border Grid.Row="0"
               Background="#100078D4"
               BorderBrush="#300078D4"
               BorderThickness="1"
               CornerRadius="12"
               Padding="20,16"
               Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="🔄  5 updates available"
                              FontSize="16" FontWeight="Bold"
                              Foreground="White"/>
                    <TextBlock Text="Keep your apps secure and up to date"
                              FontSize="12" Foreground="#8B8B9E"
                              Margin="0,4,0,0"/>
                </StackPanel>
                <Button Grid.Column="1"
                       Style="{StaticResource PrimaryButton}"
                       Content="⬆  Update All"
                       VerticalAlignment="Center"
                       Click="UpdateAll_Click"/>
            </Grid>
        </Border>

        <!-- Update List -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>
                <TextBlock Text="PENDING UPDATES"
                          FontSize="10" FontWeight="Bold"
                          Foreground="#4A4A6A" Margin="0,0,0,12"/>

                <!-- Update Item Template -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#20FF8C00"
                               CornerRadius="10" Width="46" Height="46"
                               Margin="0,0,16,0">
                            <TextBlock Text="🎵" FontSize="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="VLC Media Player"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="v3.0.18  →  "
                                          FontSize="12" Foreground="#8B8B9E"/>
                                <TextBlock Text="v3.0.20"
                                          FontSize="12" Foreground="#00B294"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="  •  Bug fixes &amp; performance"
                                          FontSize="12" Foreground="#8B8B9E"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="14 MB"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center"
                                  Margin="16,0"/>
                        <Button Grid.Column="3"
                               Style="{StaticResource PrimaryButton}"
                               Content="⬆  Update"
                               Click="UpdateOne_Click"
                               Tag="VLC Media Player"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#20F05032"
                               CornerRadius="10" Width="46" Height="46"
                               Margin="0,0,16,0">
                            <TextBlock Text="🔀" FontSize="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Git"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="v2.42.0  →  "
                                          FontSize="12" Foreground="#8B8B9E"/>
                                <TextBlock Text="v2.43.0"
                                          FontSize="12" Foreground="#00B294"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="  •  Security patches"
                                          FontSize="12" Foreground="#8B8B9E"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="52 MB"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center"
                                  Margin="16,0"/>
                        <Button Grid.Column="3"
                               Style="{StaticResource PrimaryButton}"
                               Content="⬆  Update"
                               Click="UpdateOne_Click"
                               Tag="Git"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#204285F4"
                               CornerRadius="10" Width="46" Height="46"
                               Margin="0,0,16,0">
                            <TextBlock Text="🌐" FontSize="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Google Chrome"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="v119.0  →  "
                                          FontSize="12" Foreground="#8B8B9E"/>
                                <TextBlock Text="v120.0.6099"
                                          FontSize="12" Foreground="#00B294"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="  •  Security update"
                                          FontSize="12" Foreground="#8B8B9E"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="85 MB"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center"
                                  Margin="16,0"/>
                        <Button Grid.Column="3"
                               Style="{StaticResource PrimaryButton}"
                               Content="⬆  Update"
                               Click="UpdateOne_Click"
                               Tag="Google Chrome"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#201ED760"
                               CornerRadius="10" Width="46" Height="46"
                               Margin="0,0,16,0">
                            <TextBlock Text="🎧" FontSize="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Spotify"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="v1.2.25  →  "
                                          FontSize="12" Foreground="#8B8B9E"/>
                                <TextBlock Text="v1.2.26"
                                          FontSize="12" Foreground="#00B294"
                                          FontWeight="SemiBold"/>
                                <TextBlock Text="  •  UI improvements"
                                          FontSize="12" Foreground="#8B8B9E"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="180 MB"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center"
                                  Margin="16,0"/>
                        <Button Grid.Column="3"
                               Style="{StaticResource PrimaryButton}"
                               Content="⬆  Update"
                               Click="UpdateOne_Click"
                               Tag="Spotify"/>
                    </Grid>
                </Border>

                <!-- Up to date section -->
                <TextBlock Text="UP TO DATE"
                          FontSize="10" FontWeight="Bold"
                          Foreground="#4A4A6A" Margin="0,16,0,12"/>

                <Border Style="{StaticResource Card}"
                       Margin="0,0,0,10"
                       Opacity="0.5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#2064C864"
                               CornerRadius="10" Width="46" Height="46"
                               Margin="0,0,16,0">
                            <TextBlock Text="📝" FontSize="22"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Notepad++"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v8.6.2  •  Up to date"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="✓  Latest"
                                  FontSize="12" Foreground="#00B294"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
