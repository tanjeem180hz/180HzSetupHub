<Page x:Class="WindowsSetupHub.Pages.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource PrimaryBgBrush}"
      FontFamily="Segoe UI">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter Row -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Style="{StaticResource SearchBox}" Height="46"/>
            <ComboBox Grid.Column="1"
                     Width="150" Height="46"
                     Margin="10,0">
                <ComboBoxItem Content="All Actions" IsSelected="True"/>
                <ComboBoxItem Content="Installed"/>
                <ComboBoxItem Content="Uninstalled"/>
                <ComboBoxItem Content="Updated"/>
                <ComboBoxItem Content="Cleaned"/>
            </ComboBox>
            <Button Grid.Column="2"
                   Style="{StaticResource DangerButton}"
                   Content="🗑️  Clear History"
                   Height="46"
                   Click="ClearHistory_Click"/>
        </Grid>

        <!-- History Items -->
        <ScrollViewer Grid.Row="1">
            <StackPanel>

                <!-- Today -->
                <TextBlock Text="TODAY  —  JANUARY 15, 2024"
                          FontSize="10" FontWeight="Bold"
                          Foreground="#4A4A6A" Margin="0,0,0,10"/>

                <!-- Installed -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#1500B294"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="✅" FontSize="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Google Chrome installed successfully"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="Version 120.0.6099.71  •  Size: 120 MB"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="2:34 PM"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center" Margin="16,0"/>
                        <Border Grid.Column="3"
                               Background="#1500B294"
                               BorderBrush="#4000B294"
                               BorderThickness="1"
                               CornerRadius="6" Padding="10,5"
                               VerticalAlignment="Center">
                            <TextBlock Text="INSTALLED"
                                      FontSize="10" FontWeight="Bold"
                                      Foreground="#00B294"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Removed -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#15E74C3C"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="🗑️" FontSize="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="WinRAR uninstalled"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="Version 6.21 removed successfully"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="1:12 PM"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center" Margin="16,0"/>
                        <Border Grid.Column="3"
                               Background="#15E74C3C"
                               BorderBrush="#40E74C3C"
                               BorderThickness="1"
                               CornerRadius="6" Padding="10,5"
                               VerticalAlignment="Center">
                            <TextBlock Text="REMOVED"
                                      FontSize="10" FontWeight="Bold"
                                      Foreground="#E74C3C"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Failed -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#15FF8C00"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="⚠️" FontSize="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Firefox update failed"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="Network error — Please try again"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="11:58 AM"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center" Margin="16,0"/>
                        <Border Grid.Column="3"
                               Background="#15E74C3C"
                               BorderBrush="#40E74C3C"
                               BorderThickness="1"
                               CornerRadius="6" Padding="10,5"
                               VerticalAlignment="Center">
                            <TextBlock Text="FAILED"
                                      FontSize="10" FontWeight="Bold"
                                      Foreground="#E74C3C"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Yesterday -->
                <TextBlock Text="YESTERDAY  —  JANUARY 14, 2024"
                          FontSize="10" FontWeight="Bold"
                          Foreground="#4A4A6A" Margin="0,16,0,10"/>

                <!-- Updated -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#150078D4"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="🔄" FontSize="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="VLC Media Player updated"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="v3.0.18  →  v3.0.20  •  Successfully updated"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="11:45 AM"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center" Margin="16,0"/>
                        <Border Grid.Column="3"
                               Background="#150078D4"
                               BorderBrush="#400078D4"
                               BorderThickness="1"
                               CornerRadius="6" Padding="10,5"
                               VerticalAlignment="Center">
                            <TextBlock Text="UPDATED"
                                      FontSize="10" FontWeight="Bold"
                                      Foreground="#0078D4"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Cleaned -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#15FF8C00"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="🧹" FontSize="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="PC Cleanup completed"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="Freed 3.2 GB  •  Temp files &amp; registry cleaned"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="9:20 AM"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center" Margin="16,0"/>
                        <Border Grid.Column="3"
                               Background="#15FF8C00"
                               BorderBrush="#40FF8C00"
                               BorderThickness="1"
                               CornerRadius="6" Padding="10,5"
                               VerticalAlignment="Center">
                            <TextBlock Text="CLEANED"
                                      FontSize="10" FontWeight="Bold"
                                      Foreground="#FF8C00"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Jan 13 -->
                <TextBlock Text="JANUARY 13, 2024"
                          FontSize="10" FontWeight="Bold"
                          Foreground="#4A4A6A" Margin="0,16,0,10"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="#1500B294"
                               CornerRadius="10" Width="42" Height="42"
                               Margin="0,0,14,0">
                            <TextBlock Text="✅" FontSize="18"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Discord installed successfully"
                                      FontSize="14" FontWeight="SemiBold"
                                      Foreground="White"/>
                            <TextBlock Text="Version 0.0.290  •  Size: 245 MB"
                                      FontSize="12" Foreground="#8B8B9E"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2"
                                  Text="8:05 AM"
                                  FontSize="12" Foreground="#8B8B9E"
                                  VerticalAlignment="Center" Margin="16,0"/>
                        <Border Grid.Column="3"
                               Background="#1500B294"
                               BorderBrush="#4000B294"
                               BorderThickness="1"
                               CornerRadius="6" Padding="10,5"
                               VerticalAlignment="Center">
                            <TextBlock Text="INSTALLED"
                                      FontSize="10" FontWeight="Bold"
                                      Foreground="#00B294"/>
                        </Border>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
