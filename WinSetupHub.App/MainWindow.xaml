<Window x:Class="WindowsSetupHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Setup Hub"
        Height="750" Width="1200"
        MinHeight="620" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Border CornerRadius="16"
            Background="{StaticResource PrimaryBgBrush}"
            BorderBrush="#2A2A3E"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="0" Opacity="0.6"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ======= SIDEBAR ======= -->
            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBgBrush}"
                    CornerRadius="16,0,0,16"
                    BorderBrush="#2A2A3E"
                    BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top"
                               Margin="20,24,20,16"
                               MouseLeftButtonDown="Window_MouseLeftButtonDown"
                               Cursor="SizeAll">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#0078D4"
                                    CornerRadius="10"
                                    Width="42" Height="42"
                                    Margin="0,0,12,0">
                                <TextBlock Text="⚡"
                                          FontSize="20"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Setup Hub"
                                          FontSize="17"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          FontFamily="Segoe UI"/>
                                <TextBlock Text="Windows Manager"
                                          FontSize="11"
                                          Foreground="#8B8B9E"
                                          FontFamily="Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <!-- Version Badge -->
                    <Border DockPanel.Dock="Top"
                            Margin="20,0,20,16"
                            Background="#150078D4"
                            BorderBrush="#400078D4"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                    Fill="#00B294"
                                    VerticalAlignment="Center"
                                    Margin="0,0,7,0"/>
                            <TextBlock Text="v2.0.1  •  Pro Edition"
                                      FontSize="11"
                                      Foreground="#0078D4"
                                      FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <Border DockPanel.Dock="Top"
                            Height="1"
                            Background="#2A2A3E"
                            Margin="20,0,20,10"/>

                    <!-- MAIN MENU Label -->
                    <TextBlock DockPanel.Dock="Top"
                              Text="MAIN MENU"
                              FontSize="10"
                              FontWeight="Bold"
                              Foreground="#4A4A6A"
                              FontFamily="Segoe UI"
                              Margin="28,8,0,6"/>

                    <!-- Nav Items -->
                    <StackPanel DockPanel.Dock="Top">

                        <RadioButton Style="{StaticResource NavButton}"
                                    Content="Install Apps"
                                    Tag="📦"
                                    GroupName="MainNav"
                                    IsChecked="True"
                                    Checked="NavInstall_Checked"/>

                        <RadioButton Style="{StaticResource NavButton}"
                                    Content="Uninstall Apps"
                                    Tag="🗑️"
                                    GroupName="MainNav"
                                    Checked="NavUninstall_Checked"/>

                        <RadioButton x:Name="NavUpdateBtn"
                                    Style="{StaticResource NavButton}"
                                    Content="App Updates"
                                    Tag="🔄"
                                    GroupName="MainNav"
                                    Checked="NavUpdate_Checked">
                            <!-- Badge -->
                        </RadioButton>

                        <!-- SYSTEM Label -->
                        <TextBlock Text="SYSTEM"
                                  FontSize="10"
                                  FontWeight="Bold"
                                  Foreground="#4A4A6A"
                                  FontFamily="Segoe UI"
                                  Margin="28,14,0,6"/>

                        <RadioButton Style="{StaticResource NavButton}"
                                    Content="PC Cleanup"
                                    Tag="🧹"
                                    GroupName="MainNav"
                                    Checked="NavCleanup_Checked"/>

                        <RadioButton Style="{StaticResource NavButton}"
                                    Content="History"
                                    Tag="📋"
                                    GroupName="MainNav"
                                    Checked="NavHistory_Checked"/>
                    </StackPanel>

                    <!-- System Info Bottom -->
                    <Border DockPanel.Dock="Bottom"
                            Margin="12,0,12,12"
                            Background="#1A1A2E"
                            CornerRadius="10"
                            Padding="14,12">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="CPU Usage"
                                          FontSize="11"
                                          Foreground="#8B8B9E"
                                          FontFamily="Segoe UI"/>
                                <TextBlock x:Name="CpuText"
                                          Grid.Column="1"
                                          Text="23%"
                                          FontSize="11"
                                          FontWeight="SemiBold"
                                          Foreground="#0078D4"
                                          FontFamily="Segoe UI"/>
                            </Grid>
                            <ProgressBar x:Name="CpuBar"
                                        Value="23"
                                        Maximum="100"
                                        Height="4"
                                        Foreground="#0078D4"
                                        Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="RAM Usage"
                                          FontSize="11"
                                          Foreground="#8B8B9E"
                                          FontFamily="Segoe UI"/>
                                <TextBlock x:Name="RamText"
                                          Grid.Column="1"
                                          Text="4.2 GB"
                                          FontSize="11"
                                          FontWeight="SemiBold"
                                          Foreground="#00B294"
                                          FontFamily="Segoe UI"/>
                            </Grid>
                            <ProgressBar x:Name="RamBar"
                                        Value="52"
                                        Maximum="100"
                                        Height="4"
                                        Foreground="#00B294"/>
                        </StackPanel>
                    </Border>

                </DockPanel>
            </Border>

            <!-- ======= MAIN CONTENT ======= -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="64"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Grid.Row="0"
                        BorderBrush="#2A2A3E"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="Window_MouseLeftButtonDown"
                        Cursor="SizeAll">
                    <Grid Margin="24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle"
                                      Text="Install Applications"
                                      FontSize="20"
                                      FontWeight="Bold"
                                      Foreground="White"
                                      FontFamily="Segoe UI"/>
                            <TextBlock x:Name="PageSubTitle"
                                      Text="Browse and install apps with one click"
                                      FontSize="12"
                                      Foreground="#8B8B9E"
                                      FontFamily="Segoe UI"/>
                        </StackPanel>

                        <!-- Window Controls -->
                        <StackPanel Grid.Column="1"
                                   Orientation="Horizontal"
                                   VerticalAlignment="Center">
                            <Button Style="{StaticResource IconButton}"
                                   Margin="0,0,6,0"
                                   Click="Btn_Notify">
                                <TextBlock Text="🔔" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                   Margin="0,0,10,0"
                                   Click="Btn_Settings">
                                <TextBlock Text="⚙️" FontSize="15"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                   Margin="0,0,4,0"
                                   Click="Btn_Minimize">
                                <TextBlock Text="—"
                                          Foreground="White"
                                          FontSize="14"
                                          FontWeight="Bold"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                   Margin="0,0,4,0"
                                   Click="Btn_Maximize">
                                <TextBlock Text="□"
                                          Foreground="White"
                                          FontSize="14"/>
                            </Button>
                            <Button Style="{StaticResource CloseButton}"
                                   Click="Btn_Close">
                                <TextBlock Text="✕"
                                          Foreground="White"
                                          FontSize="13"
                                          FontWeight="Bold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Frame -->
                <Frame x:Name="ContentFrame"
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"/>
            </Grid>
        </Grid>
    </Border>
</Window>
