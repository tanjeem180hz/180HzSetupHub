                                                            <TextBlock Text="01"
                                                                       Foreground="{DynamicResource SuccessText}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Update"
                                                                       Foreground="{DynamicResource PrimaryText}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="HomeFeatureTile1"
                                                            Tag="1"
                                                            Background="#0A162C"
                                                            BorderBrush="#1A3B6E"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="14,12"
                                                            Margin="8,0"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="HomeFeatureTile_MouseLeftButtonDown">
                                                        <StackPanel>
                                                            <TextBlock Text="02"
                                                                       Foreground="{DynamicResource SuccessText}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Setup"
                                                                       Foreground="{DynamicResource PrimaryText}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="HomeFeatureTile2"
                                                            Tag="2"
                                                            Background="#0A162C"
                                                            BorderBrush="#1A3B6E"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="14,12"
                                                            Margin="8,0"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="HomeFeatureTile_MouseLeftButtonDown">
                                                        <StackPanel>
                                                            <TextBlock Text="03"
                                                                       Foreground="{DynamicResource SuccessText}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Uninstall"
                                                                       Foreground="{DynamicResource PrimaryText}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="HomeFeatureTile3"
                                                            Tag="3"
                                                            Background="#0A162C"
                                                            BorderBrush="#1A3B6E"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="14,12"
                                                            Margin="8,0"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="HomeFeatureTile_MouseLeftButtonDown">
                                                        <StackPanel>
                                                            <TextBlock Text="04"
                                                                       Foreground="{DynamicResource SuccessText}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Cleanup"
                                                                       Foreground="{DynamicResource PrimaryText}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="HomeFeatureTile4"
                                                            Tag="4"
                                                            Background="#0A162C"
                                                            BorderBrush="#1A3B6E"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="14,12"
                                                            Margin="8,0"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="HomeFeatureTile_MouseLeftButtonDown">
                                                        <StackPanel>
                                                            <TextBlock Text="05"
                                                                       Foreground="{DynamicResource SuccessText}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Activity"
                                                                       Foreground="{DynamicResource PrimaryText}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border x:Name="HomeFeatureTile5"
                                                            Tag="5"
                                                            Background="#0A162C"
                                                            BorderBrush="#1A3B6E"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="14,12"
                                                            Margin="8,0,0,0"
                                                            Cursor="Hand"
                                                            MouseLeftButtonDown="HomeFeatureTile_MouseLeftButtonDown">
                                                        <StackPanel>
                                                            <TextBlock Text="06"
                                                                       Foreground="{DynamicResource SuccessText}"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                            <TextBlock Text="Storage"
                                                                       Foreground="{DynamicResource PrimaryText}"
                                                                       FontSize="15"
                                                                       FontWeight="SemiBold"
                                                                       Margin="0,5,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </UniformGrid>

                                                <Grid Grid.Row="1"
                                                      Margin="0,16,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <Button x:Name="HomeBackButton"
                                                            Content="Back"
                                                            Style="{StaticResource HomeGhostButton}"
                                                            Click="PreviousHomeFeature_Click" />
                                                    <TextBlock x:Name="HomeFeaturePositionText"
                                                               Grid.Column="1"
                                                               Text="01 of 06"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource MutedText}" />
                                                    <Button Grid.Column="2"
                                                            x:Name="HomeNextButton"
                                                            Content="Next"
                                                            Style="{StaticResource HomeGhostButton}"
                                                            Click="NextHomeFeature_Click" />
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="SetupPage"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0"
                                                        Margin="0,0,10,0">
                                                <TextBlock Text="Search apps"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MutedText}"
                                                           Margin="2,0,0,4" />
                                                <TextBox x:Name="SearchBox"
                                                         ToolTip="Search by app name, category, or package ID"
                                                         TextChanged="SearchBox_TextChanged" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="1"
                                                        Margin="0,0,10,0">
                                                <TextBlock Text="Category"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MutedText}"
                                                           Margin="2,0,0,4" />
                                                <ComboBox x:Name="CategoryFilter"
                                                          SelectionChanged="CategoryFilter_SelectionChanged" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2"
                                                        Margin="0,0,10,0">
                                                <TextBlock Text="Workflow profile"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MutedText}"
                                                           Margin="2,0,0,4" />
                                                <ComboBox x:Name="ProfileSelector" />
                                            </StackPanel>

                                            <WrapPanel Grid.Column="3"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom">
                                                <Button x:Name="ApplyProfileButton"
                                                        Content="Apply Selected Profile"
                                                        Click="ApplyProfile_Click" />
                                                <Button x:Name="SelectEssentialsButton"
                                                        Content="Starter Pack"
                                                        Click="SelectEssentials_Click" />
                                                <Button x:Name="SelectAllButton"
                                                        Content="All Apps"
                                                        Click="SelectAll_Click" />
                                                <Button x:Name="ClearSelectionButton"
                                                        Content="Clear Selection"
                                                        Click="ClearSelection_Click" />
                                            </WrapPanel>
                                        </Grid>

                                        <Grid Grid.Row="1"
                                              Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <WrapPanel VerticalAlignment="Center">
                                                <Border Background="{DynamicResource SuccessBackground}"
                                                        CornerRadius="8"
                                                        Padding="10,7"
                                                        Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="InstalledCountText"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource SuccessText}" />
                                                        <TextBlock Text=" installed"
                                                                   Foreground="{DynamicResource SuccessText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource NeutralBackground}"
                                                        CornerRadius="8"
                                                        Padding="10,7"
                                                        Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="MissingCountText"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource NeutralText}" />
                                                        <TextBlock Text=" missing"
                                                                   Foreground="{DynamicResource NeutralText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource WarningBackground}"
                                                        CornerRadius="8"
                                                        Padding="10,7"
                                                        Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="UpdateCountText"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource WarningText}" />
                                                        <TextBlock Text=" updates"
                                                                   Foreground="{DynamicResource WarningText}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource NeutralBackground}"
                                                        CornerRadius="8"
                                                        Padding="10,7"
                                                        Margin="0,0,8,8">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="UncheckedCountText"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource NeutralText}" />
                                                        <TextBlock Text=" unchecked"
                                                                   Foreground="{DynamicResource NeutralText}" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>

                                            <WrapPanel Grid.Column="1"
                                                       HorizontalAlignment="Right">
                                                <Button x:Name="InstallSelectedButton"
                                                        Content="Install Selected"
                                                        Style="{StaticResource PrimaryButton}"
                                                        Click="InstallSelected_Click" />
                                                <Button x:Name="CheckSelectedButton"
                                                        Content="Check Versions"
                                                        Style="{StaticResource SubtleButton}"
                                                        Click="CheckSelected_Click" />
                                                <Button x:Name="CheckAllButton"
                                                        Content="Check All Versions"
                                                        Style="{StaticResource SubtleButton}"
                                                        Click="CheckAll_Click" />
                                            </WrapPanel>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="2"
                                        Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Apps"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="VisibleCountText"
                                                       Grid.Column="1"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <ListView x:Name="PackagesList"
                                                  Grid.Row="1"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  SelectionMode="Single"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListViewItem}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding AccentSoftBrush}"
                                                            BorderBrush="{DynamicResource PanelBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32" />
                                                                <ColumnDefinition Width="54" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="128" />
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="74" />
                                                                <ColumnDefinition Width="94" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />

                                                            <Border Grid.Column="1"
                                                                    Width="42"
                                                                    Height="42"
                                                                    Background="{Binding AccentSoftBrush}"
                                                                    BorderBrush="{Binding AccentBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    VerticalAlignment="Center"
                                                                    HorizontalAlignment="Left">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Initials}"
                                                                               Foreground="{Binding AccentBrush}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                    <Image Source="{Binding IconUri}"
                                                                           Width="28"
                                                                           Height="28"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="2"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource MutedText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,3,18,0" />
                                                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                            Margin="0,8,18,0">
                                                                    <ProgressBar Height="6"
                                                                                 Minimum="0"
                                                                                 Maximum="100"
                                                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                                 IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                                                                    <TextBlock Text="{Binding ProgressText}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource MutedText}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <Border Grid.Column="3"
                                                                    Background="{Binding StatusBackground}"
                                                                    CornerRadius="8"
                                                                    Padding="9,5"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Foreground="{Binding StatusForeground}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold" />
                                                            </Border>

                                                            <StackPanel Grid.Column="4"
                                                                        VerticalAlignment="Center"
                                                                        Margin="8,0,8,0">
                                                                <TextBlock Text="{Binding Category}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource MutedText}" />
                                                                <TextBlock Text="{Binding Id}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding VersionText}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource MutedText}"
                                                                           TextWrapping="Wrap"
                                                                           ToolTip="{Binding VersionText}"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>

                                                            <Button Grid.Column="5"
                                                                    Content="Check"
                                                                    IsEnabled="{Binding CanCheck}"
                                                                    Margin="0,0,8,0"
                                                                    Click="CheckSingle_Click" />

                                                            <Button Grid.Column="6"
                                                                    Content="{Binding PrimaryActionText}"
                                                                    IsEnabled="{Binding IsActionEnabled}"
                                                                    Margin="0"
                                                                    Click="InstallSingle_Click" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="UpdatesPage"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <UniformGrid Columns="3"
                                             Rows="1"
                                             Margin="0,0,0,16">
                                    <Border Background="{DynamicResource WarningBackground}"
                                            CornerRadius="8"
                                            Padding="18"
                                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Known Updates"
                                                       Foreground="{DynamicResource WarningText}"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding Text, ElementName=UpdateCountText}"
                                                       Foreground="{DynamicResource WarningText}"
                                                       FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI"
                                                       FontSize="32"
                                                       FontWeight="Bold"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource SuccessBackground}"
                                            CornerRadius="8"
                                            Padding="18"
                                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Installed"
                                                       Foreground="{DynamicResource SuccessText}"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding Text, ElementName=InstalledCountText}"
                                                       Foreground="{DynamicResource SuccessText}"
                                                       FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI"
                                                       FontSize="32"
                                                       FontWeight="Bold"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource NeutralBackground}"
                                            CornerRadius="8"
                                            Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Unchecked"
                                                       Foreground="{DynamicResource NeutralText}"
                                                       FontSize="12" />
                                            <TextBlock Text="{Binding Text, ElementName=UncheckedCountText}"
                                                       Foreground="{DynamicResource NeutralText}"
                                                       FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI"
                                                       FontSize="32"
                                                       FontWeight="Bold"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,0,0,16">
                                    <StackPanel>
                                        <TextBlock Text="Update Actions"
                                                   FontSize="18"
                                                   FontWeight="SemiBold" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button x:Name="SelectUpdatesButton"
                                                    Content="Select Updates"
                                                    Click="SelectUpdates_Click" />
                                            <Button x:Name="UpdateSelectedButton"
                                                    Content="Update Selected"
                                                    Style="{StaticResource PrimaryButton}"
                                                    Click="UpdateSelected_Click" />
                                            <Button x:Name="UpgradeAllButton"
                                                    Content="Update All Found"
                                                    Style="{StaticResource SubtleButton}"
                                                    Click="UpgradeAll_Click" />
                                            <Button x:Name="ScanUpdatesButton"
                                                    Content="Scan Updates"
                                                    Style="{StaticResource SubtleButton}"
                                                    Click="ScanUpdates_Click" />
                                            <Button x:Name="RefreshWingetSourcesButton"
                                                    Content="Update Sources"
                                                    Click="RefreshWingetSources_Click" />
                                            <Button Content="Open App Selection"
                                                    Click="SetupNav_Click" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Row="2"
                                        Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Ready Updates"
                                                           FontSize="18"
                                                           FontWeight="SemiBold" />
