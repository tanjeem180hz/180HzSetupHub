<Window x:Class="SetupHub180Hz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:lottie="clr-namespace:LottieSharp.WPF;assembly=LottieSharp"
        xmlns:services="clr-namespace:SetupHub180Hz.Services"
        Title="180Hz Setup Hub" Height="800" Width="1280" MinHeight="560" MinWidth="900"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{DynamicResource BrushBackground}"
        Icon="Assets/AppIcon.ico"
        Style="{StaticResource AppWindow}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             CornerRadius="0"
                             GlassFrameThickness="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Custom Title Bar ===== -->
        <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="{DynamicResource BrushSurface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Logo & Title -->
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="False">
                <Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource BrushSurfaceHover}"
                        BorderBrush="{DynamicResource BrushAccent}" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0">
                    <Image Source="pack://application:,,,/Assets/AppIcon-1024.png" Width="18" Height="18"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="180Hz Setup Hub" VerticalAlignment="Center"
                           Foreground="{DynamicResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"
                           FontSize="12" FontWeight="SemiBold"/>
                <Border Background="{DynamicResource BrushSurfaceHover}" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource BrushAccent}"/>
                </Border>
            </StackPanel>

            <!-- Chrome Controls: Vector Window Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Minimize -->
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" ToolTip="Minimize" Click="Minimize_Click">
                    <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Maximize / Restore -->
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" ToolTip="Maximize" Click="Maximize_Click">
                    <Path x:Name="MaximizeIconPath" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Close -->
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close" Click="Close_Click">
                    <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Body: Collapsible Animated Sidebar + Content ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar (Collapsible / Auto-Expanding with smooth animation) -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="68"
                    Background="{DynamicResource BrushBackground}"
                    BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,1,0"
                    ClipToBounds="True"
                    MouseEnter="Sidebar_MouseEnter" MouseLeave="Sidebar_MouseLeave">
                <DockPanel Margin="10,10,10,12">
                    <!-- Top section: Header & Nav Items -->
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Sidebar Header with Pin/Expand toggle -->
                        <Grid Margin="0,0,0,10" Height="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="BtnSidebarToggle" Grid.Column="0" Style="{StaticResource SidebarButton}"
                                    Height="28" Padding="0" Click="SidebarToggle_Click" ToolTip="Pin / Unpin Sidebar">
                                <TextBlock x:Name="SidebarToggleIcon" Text="☰" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <TextBlock x:Name="SidebarBrandText" Grid.Column="1" Text="NAVIGATION" FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0"/>

                            <Button x:Name="BtnPinSidebar" Grid.Column="2" Style="{StaticResource SidebarButton}"
                                    Height="24" Padding="4,2" Click="SidebarToggle_Click" ToolTip="Lock Sidebar Expanded" Opacity="0">
                                <TextBlock x:Name="SidebarPinIcon" Text="📌" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </Grid>

                        <!-- Nav Items -->
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource SidebarItem}" IsChecked="True"
                                     Checked="NavItem_Checked" Tag="Dashboard" Margin="0,0,0,4" ToolTip="Dashboard">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="wave.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavDashboardLabel" Grid.Column="1" Text="Dashboard" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavSetupApps" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="SetupApps" Margin="0,0,0,4" ToolTip="Setup Apps">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="gears.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavSetupAppsLabel" Grid.Column="1" Text="Setup Apps" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavDownloads" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Downloads" Margin="0,0,0,4" ToolTip="Downloads &amp; Bandwidth">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="download_flow.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavDownloadsLabel" Grid.Column="1" Text="Downloads" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                                <Border x:Name="DownloadsNavBadge" Grid.Column="2" Background="{DynamicResource BrushAccent}"
                                        CornerRadius="8" Padding="6,1" Margin="4,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="DownloadsNavBadgeText" Text="0" FontSize="10" FontWeight="Bold" Foreground="#0A0E17"/>
                                </Border>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavUpdateCenter" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="UpdateCenter" Margin="0,0,0,4" ToolTip="Update Center">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="update_sync.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavUpdateCenterLabel" Grid.Column="1" Text="Update Center" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavUninstaller" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Uninstaller" Margin="0,0,0,4" ToolTip="Uninstaller">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="uninstaller_bin.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavUninstallerLabel" Grid.Column="1" Text="Uninstaller" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavStartup" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Startup" Margin="0,0,0,4" ToolTip="Startup Apps">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="startup_boost.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavStartupLabel" Grid.Column="1" Text="Startup Apps" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavCleanup" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Cleanup" Margin="0,0,0,4" ToolTip="Disk Cleanup">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="cleanup_sparkle.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavCleanupLabel" Grid.Column="1" Text="Cleanup" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavActivity" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Activity" Margin="0,0,0,4" ToolTip="Activity Log">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="activity_pulse.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavActivityLabel" Grid.Column="1" Text="Activity" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                            </Grid>
                        </RadioButton>

                        <RadioButton x:Name="NavStorage" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Storage" Margin="0,0,0,4" ToolTip="Storage Analysis">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="scan.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavStorageLabel" Grid.Column="1" Text="Storage" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                            </Grid>
                        </RadioButton>


                        <RadioButton x:Name="NavOptimization" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Optimization" Margin="0,0,0,4" ToolTip="Optimization">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="startup_boost.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavOptimizationLabel" Grid.Column="1" Text="Optimization" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                            </Grid>
                        </RadioButton>

                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrushBorder}" Margin="0,6,0,6"/>

                        <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Settings" Margin="0,0,0,4" ToolTip="Settings">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="20" Height="20" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="settings_dial.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="NavSettingsLabel" Grid.Column="1" Text="Settings" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <!-- Bottom Section: Dark/Light Theme Button (Sidebar Footer) -->
                    <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                        <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BrushBorder}" Margin="0,0,0,8"/>
                        <!-- Theme Toggle Button inside Sidebar Bottom-Left -->
                        <Button x:Name="SidebarThemeButton" Style="{StaticResource SidebarThemeButtonStyle}"
                                Click="ThemeToggle_Click" ToolTip="Switch Theme">
                            <Grid Width="180">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <lottie:LottieAnimationView Width="22" Height="22" AutoPlay="True" RepeatCount="-1"
                                                            services:LottieHelper.AssetName="toggle_switch.json"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock x:Name="SidebarThemeLabel" Grid.Column="1" Text="Light Theme" VerticalAlignment="Center" FontWeight="SemiBold" Opacity="0"/>
                                <TextBlock x:Name="SidebarThemeIcon" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Content host: pages are swapped in here with a fade+slide transition -->
            <Border Grid.Column="1" Background="{DynamicResource BrushBackground}" ClipToBounds="True">
                <ContentControl x:Name="ContentHost" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TranslateTransform/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
