<Window x:Class="WinSetupHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="180Hz Setup Hub"
        Icon="Assets/AppIcon.ico"
        Height="820"
        Width="1280"
        MinHeight="720"
        MinWidth="1060"
        Loaded="Window_Loaded">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="BgStopOne" Color="#050C1E" Offset="0" />
            <GradientStop x:Name="BgStopTwo" Color="#0A1C3E" Offset="0.52" />
            <GradientStop x:Name="BgStopThree" Color="#002D66" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>
    <Grid>
        <Grid x:Name="ShellRoot"
              Margin="22"
              Opacity="0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="ShellTransform" Y="18" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SidebarColumn" Width="268" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SidebarPanel"
                            Grid.Column="0"
                            Background="{DynamicResource PanelBackground}"
                            BorderBrush="{DynamicResource PanelBorder}"
                            BorderThickness="0,0,1,0"
                            CornerRadius="8,0,0,8"
                            Padding="16"
                            MouseEnter="SidebarPanel_MouseEnter"
                            MouseLeave="SidebarPanel_MouseLeave">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="Assets/AppIcon-1024.png"
                                           Width="42"
                                           Height="42"
                                           Stretch="Uniform"
                                           Margin="0,0,10,0" />
                                    <StackPanel x:Name="SidebarBrandBlock"
                                                Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock x:Name="SidebarBrandText"
                                                   Text="180Hz Setup Hub"
                                                   FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI"
                                                   FontSize="21"
                                                   FontWeight="Bold" />
                                        <TextBlock x:Name="SidebarSubtitleText"
                                                   Text="SETUP COMMAND CENTER"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Margin="1,3,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="ThemeToggleButton"
                                            Content="&#x2600; Light"
                                            HorizontalContentAlignment="Center"
                                            Click="ThemeToggle_Click" />
                                    <Button x:Name="SidebarToggleButton"
                                            Grid.Column="1"
                                            Content="Hide"
                                            MinWidth="58"
                                            HorizontalContentAlignment="Center"
                                            Click="SidebarToggle_Click" />
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Margin="0,24,0,16">
                                <Button x:Name="HomeNavButton"
                                        HorizontalContentAlignment="Stretch"
                                        Click="HomeNav_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M4,11 L12,4 L20,11"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                                <Path Data="M6,10 L6,20 L10,20 L10,15 L14,15 L14,20 L18,20 L18,10"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="NavHomeText"
                                                   Grid.Column="1"
                                                   Text="Dashboard"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                                <Button x:Name="SetupNavButton"
                                        HorizontalContentAlignment="Stretch"
                                        Click="SetupNav_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Ellipse Canvas.Left="8"
                                                         Canvas.Top="8"
                                                         Width="8"
                                                         Height="8"
                                                         Fill="Transparent"
                                                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                         StrokeThickness="2.2" />
                                                <Path Data="M12,2 L12,5 M12,19 L12,22 M2,12 L5,12 M19,12 L22,12 M4.9,4.9 L7,7 M17,17 L19.1,19.1 M19.1,4.9 L17,7 M7,17 L4.9,19.1"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="NavSetupText"
                                                   Grid.Column="1"
                                                   Text="Setup Apps"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                                <Button x:Name="UpdatesNavButton"
                                        HorizontalContentAlignment="Stretch"
                                        Click="UpdatesNav_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M19.5,13 A7.5,7.5 0 0,1 6.8,18.2"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round" />
                                                <Path Data="M4.5,11 A7.5,7.5 0 0,1 17.2,5.8"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round" />
                                                <Path Data="M20,7 L20,13 L14,13 M4,17 L4,11 L10,11"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      StrokeThickness="2.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="NavUpdatesText"
                                                   Grid.Column="1"
                                                   Text="Update Center"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                                <Button x:Name="UninstallerNavButton"
                                        HorizontalContentAlignment="Stretch"
                                        Click="UninstallerNav_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M8,7 L16,7 M10,7 L10,5 L14,5 L14,7 M6,9 L18,9 L17,20 L7,20 Z"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                                <Path Data="M10,12 L10,17 M14,12 L14,17"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="NavUninstallerText"
                                                   Grid.Column="1"
                                                   Text="Uninstaller"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                                <Button x:Name="CleanupNavButton"
                                        HorizontalContentAlignment="Stretch"
                                        Click="CleanupNav_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="M5,14 C8,7 16,6 19,4 C18,10 15,17 8,19 C7,17 6,16 5,14 Z"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      StrokeLineJoin="Round" />
                                                <Path Data="M8,16 C11,13 14,10 18,5"
                                                      Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                      StrokeThickness="2"
                                                      StrokeStartLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="NavCleanupText"
                                                   Grid.Column="1"
                                                   Text="Cleanup"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                                <Button x:Name="ActivityNavButton"
                                        HorizontalContentAlignment="Stretch"
                                        Click="ActivityNav_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Path Data="M3,12 L7.2,12 L9.3,6 L14,18 L16.5,12 L21,12"
                                                  Fill="Transparent"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  StrokeThickness="2.6"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform" />
                                        </Viewbox>
                                        <TextBlock x:Name="NavActivityText"
                                                   Grid.Column="1"
                                                   Text="Activity"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                                <Button x:Name="StorageNavButton"
                                        HorizontalContentAlignment="Stretch"
                                        Click="StorageNav_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Viewbox Width="22"
                                                 Height="22"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Path Data="M3,7 L9,7 L11,9 L21,9 L21,19 L3,19 Z"
                                                  Fill="Transparent"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                                                  StrokeThickness="2.3"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  Stretch="Uniform" />
                                        </Viewbox>
                                        <TextBlock x:Name="NavStorageText"
                                                   Grid.Column="1"
                                                   Text="Storage"
                                                   Margin="8,0,0,0" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <Border x:Name="SidebarStatusPanel"
                                    Grid.Row="3"
                                    Background="{DynamicResource NeutralBackground}"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="SidebarStatusLabel"
                                               Text="Status"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedText}" />
                                    <TextBlock x:Name="SidebarStatusText"
                                               Text="Ready for setup"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Background="{DynamicResource PanelBorder}" />

                    <Grid Grid.Column="2"
                          Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0"
                              Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PageTitleText"
                                           Text="Home"
                                           FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI"
                                           FontSize="28"
                                           FontWeight="Bold" />
                                <TextBlock x:Name="PageSubtitleText"
                                           Text="Pick a setup area and move step by step."
                                           FontSize="13"
                                           Foreground="{DynamicResource MutedText}"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Background="{DynamicResource InfoBackground}"
                                    CornerRadius="8"
                                    Padding="12,8"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="SelectedCountText"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource InfoText}" />
                                    <TextBlock Text=" selected"
                                               Foreground="{DynamicResource InfoText}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1"
                              x:Name="PagesHost">
                            <Grid x:Name="HomePage"
                                  ClipToBounds="True">
                                <Grid.Resources>
                                    <Style x:Key="HomeActionButton" TargetType="{x:Type Button}">
                                        <Setter Property="MinWidth" Value="154" />
                                        <Setter Property="Height" Value="42" />
                                        <Setter Property="Padding" Value="18,0" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#00F0FF" Offset="0" />
                                                    <GradientStop Color="#0078FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="BorderBrush" Value="#00F0FF" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="Chrome"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="{TemplateBinding Content}"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   FontWeight="{TemplateBinding FontWeight}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.9" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.78" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>

                                    <Style x:Key="HomeGhostButton" TargetType="{x:Type Button}">
                                        <Setter Property="MinWidth" Value="72" />
                                        <Setter Property="Height" Value="36" />
                                        <Setter Property="Padding" Value="14,0" />
                                        <Setter Property="Background" Value="{DynamicResource NeutralBackground}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <Border x:Name="Chrome"
                                                            Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="{TemplateBinding Content}"
                                                                   Foreground="{TemplateBinding Foreground}"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ButtonHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="Chrome" Property="Opacity" Value="0.76" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Grid.Resources>
                                <Border x:Name="HomeDeckBorder"
                                        BorderBrush="#1A3B6E"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop x:Name="HomeDeckStopOne"
                                                          Color="#050C1E"
                                                          Offset="0" />
                                            <GradientStop x:Name="HomeDeckStopTwo"
                                                          Color="#0A1C3E"
                                                          Offset="0.52" />
                                            <GradientStop x:Name="HomeDeckStopThree"
                                                          Color="#002D66"
                                                          Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Grid ClipToBounds="True">
                                        <Image Source="Assets/BrandArtwork.png"
                                               Stretch="UniformToFill"
                                               Opacity="0.16"
                                               IsHitTestVisible="False"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center" />
                                        <Canvas IsHitTestVisible="False">
                                            <Border x:Name="HomeBandOne"
                                                    Width="760"
                                                    Height="86"
                                                    Background="#0078FF"
                                                    CornerRadius="8"
                                                    Canvas.Left="-120"
                                                    Canvas.Top="86"
                                                    Opacity="0.18">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <RotateTransform Angle="-12" />
                                                        <TranslateTransform x:Name="HomeBandOneTransform" />
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                            </Border>
                                            <Border x:Name="HomeBandTwo"
                                                    Width="680"
                                                    Height="74"
                                                    Background="#00F0FF"
                                                    CornerRadius="8"
                                                    Canvas.Right="-130"
                                                    Canvas.Bottom="96"
                                                    Opacity="0.14">
                                                <Border.RenderTransform>
                                                    <TransformGroup>
                                                        <RotateTransform Angle="-12" />
                                                        <TranslateTransform x:Name="HomeBandTwoTransform" />
                                                    </TransformGroup>
                                                </Border.RenderTransform>
                                            </Border>
                                        </Canvas>

                                        <Grid Margin="34">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Border Background="#163260"
                                                            BorderBrush="#00F0FF"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,2"
                                                            Margin="0,0,8,0">
                                                        <TextBlock Text="⚡ 180Hz"
                                                                   FontSize="11"
                                                                   FontWeight="Bold"
                                                                   Foreground="#00F0FF" />
                                                    </Border>
                                                    <TextBlock x:Name="HomeDeckEyebrowText"
                                                               Text="COMMAND DECK • PEAK GAMING OPTIMIZATION"
                                                               FontSize="11.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock x:Name="HomeDeckTitleText"
                                                           Text="OPTIMIZE. MONITOR. DOMINATE."
                                                           FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI"
                                                           FontSize="30"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryText}"
                                                           Margin="0,3,0,0" />
                                                <TextBlock x:Name="HomeDeckSubtitleText"
                                                           Text="Unlock Peak Gaming Performance with automated app setup, driver updates, and junk cleanup."
                                                           FontSize="13"
                                                           Foreground="{DynamicResource MutedText}"
                                                           Margin="0,6,0,0" />
                                            </StackPanel>

                                            <Border x:Name="HomeFeatureStage"
                                                    Grid.Row="1"
                                                    Width="700"
                                                    MinHeight="300"
                                                    Background="#E60A162C"
                                                    BorderBrush="#1A3B6E"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="30"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                                <Border.RenderTransform>
                                                    <TranslateTransform x:Name="HomeFeatureTransform" />
                                                </Border.RenderTransform>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="178" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0"
                                                                Margin="0,0,28,0"
                                                                VerticalAlignment="Center">
                                                        <Border x:Name="HomeFeatureBadge"
                                                                Background="#082042"
                                                                BorderBrush="#00D2FF"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="10,6"
                                                                HorizontalAlignment="Left">
                                                            <TextBlock x:Name="HomeFeatureBadgeText"
                                                                       Text="01 / Updates"
                                                                       Foreground="#00F0FF"
                                                                       FontSize="12"
                                                                       FontWeight="SemiBold" />
                                                        </Border>
                                                        <TextBlock x:Name="HomeFeatureTitleText"
                                                                   Text="Update Center"
                                                                   FontFamily="Segoe UI Variable Display, Bahnschrift, Segoe UI"
                                                                   FontSize="34"
                                                                   FontWeight="Bold"
                                                                   Foreground="{DynamicResource PrimaryText}"
                                                                   Margin="0,22,0,0" />
                                                        <TextBlock x:Name="HomeFeatureSubtitleText"
                                                                   Text="Refresh sources and run known updates."
                                                                   FontSize="14"
                                                                   Foreground="{DynamicResource MutedText}"
                                                                   TextWrapping="Wrap"
                                                                   Margin="0,10,0,0" />
                                                        <Button x:Name="HomeFeatureActionButton"
                                                                Content="Open Update Center"
                                                                Style="{StaticResource HomeActionButton}"
                                                                HorizontalAlignment="Left"
                                                                Margin="0,28,0,0"
                                                                Click="OpenHomeFeature_Click" />
                                                    </StackPanel>
                                                    <Border x:Name="HomeFeatureNumberPanel"
                                                            Grid.Column="1"
                                                            Background="#0A1C3E"
                                                            BorderBrush="#0078FF"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="18"
                                                            VerticalAlignment="Stretch">
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock x:Name="HomeFeatureBrandText"
                                                                       Text="180Hz"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontSize="16"
