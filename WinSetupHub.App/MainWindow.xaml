<Window x:Class="SetupHub180Hz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="180Hz Setup Hub" Height="800" Width="1280" MinHeight="560" MinWidth="900"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="False"
        Background="{StaticResource BrushBackground}"
        Icon="Assets/AppIcon.ico"
        Style="{StaticResource AppWindow}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36"
                             ResizeBorderThickness="6"
                             CornerRadius="0"
                             GlassFrameThickness="0"
                             UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== Custom Title Bar ===== -->
        <Grid Grid.Row="0" Background="{StaticResource BrushSurface}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Brand Logo & Title -->
            <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center"
                        shell:WindowChrome.IsHitTestVisibleInChrome="False">
                <Border Width="22" Height="22" CornerRadius="5" Background="#16253B"
                        BorderBrush="{StaticResource BrushAccent}" BorderThickness="1" ClipToBounds="True" Margin="0,0,8,0">
                    <Image Source="pack://application:,,,/Assets/AppIcon-1024.png" Width="18" Height="18"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="180Hz Setup Hub" VerticalAlignment="Center"
                           Foreground="{StaticResource BrushTextPrimary}" FontFamily="{StaticResource AppFont}"
                           FontSize="12" FontWeight="SemiBold"/>
                <Border Background="#1C2E44" CornerRadius="4" Padding="5,1" Margin="8,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="PRO" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BrushAccent}"/>
                </Border>
            </StackPanel>

            <!-- Chrome Controls: Theme Pill & Vector Window Buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <!-- Theme Toggle Button -->
                <Button x:Name="ThemeToggleButton" Style="{StaticResource ThemeToggleButtonStyle}" Margin="0,0,8,0" Click="ThemeToggle_Click" ToolTip="Toggle Dark / Light Theme">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ThemeToggleIcon" Text="☀️" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ThemeToggleText" Text="Light" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Minimize -->
                <Button x:Name="MinimizeButton" Style="{StaticResource TitleBarButton}" ToolTip="Minimize" Click="Minimize_Click">
                    <Path Data="M 0,0 L 10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Maximize / Restore -->
                <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" ToolTip="Maximize" Click="Maximize_Click">
                    <Path x:Name="MaximizeIconPath" Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>

                <!-- Close -->
                <Button x:Name="CloseButton" Style="{StaticResource TitleBarCloseButton}" ToolTip="Close" Click="Close_Click">
                    <Path Data="M 0.5,0.5 L 9.5,9.5 M 9.5,0.5 L 0.5,9.5"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== Body: Sidebar + Content ===== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BrushBackground}"
                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top">
                        <RadioButton x:Name="NavDashboard" Style="{StaticResource SidebarItem}" IsChecked="True"
                                     Checked="NavItem_Checked" Tag="Dashboard" Margin="0,0,0,4">
                            <TextBlock Text="🏠  Dashboard"/>
                        </RadioButton>
                        <RadioButton x:Name="NavSetupApps" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="SetupApps" Margin="0,0,0,4">
                            <TextBlock Text="⚙️  Setup Apps"/>
                        </RadioButton>
                        <RadioButton x:Name="NavDownloads" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Downloads" Margin="0,0,0,4">
                            <Grid Width="176">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📥  Downloads" VerticalAlignment="Center"/>
                                <Border x:Name="DownloadsNavBadge" Grid.Column="1" Background="{StaticResource BrushAccent}"
                                        CornerRadius="8" Padding="6,1" Margin="6,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
                                    <TextBlock x:Name="DownloadsNavBadgeText" Text="0" FontSize="10" FontWeight="Bold" Foreground="#0A0E17"/>
                                </Border>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="NavUpdateCenter" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="UpdateCenter" Margin="0,0,0,4">
                            <TextBlock Text="🔄  Update Center"/>
                        </RadioButton>
                        <RadioButton x:Name="NavUninstaller" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Uninstaller" Margin="0,0,0,4">
                            <TextBlock Text="🗑️  Uninstaller"/>
                        </RadioButton>
                        <RadioButton x:Name="NavStartup" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Startup" Margin="0,0,0,4">
                            <TextBlock Text="🚀  Startup Apps"/>
                        </RadioButton>
                        <RadioButton x:Name="NavCleanup" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Cleanup" Margin="0,0,0,4">
                            <TextBlock Text="🧹  Cleanup"/>
                        </RadioButton>
                        <RadioButton x:Name="NavActivity" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Activity" Margin="0,0,0,4">
                            <TextBlock Text="📈  Activity"/>
                        </RadioButton>
                        <RadioButton x:Name="NavStorage" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Storage" Margin="0,0,0,4">
                            <TextBlock Text="📁  Storage"/>
                        </RadioButton>
                        <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource BrushBorder}" Margin="0,8,0,8"/>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarItem}"
                                     Checked="NavItem_Checked" Tag="Settings" Margin="0,0,0,4">
                            <TextBlock Text="⚙️  Settings"/>
                        </RadioButton>
                    </StackPanel>

                    <!-- Status footer -->
                    <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="12" VerticalAlignment="Bottom">
                        <StackPanel>
                            <TextBlock Text="STATUS" FontSize="10" Foreground="{StaticResource BrushTextSecondary}"/>
                            <TextBlock x:Name="StatusText" Text="Ready for setup" Foreground="{StaticResource BrushTextPrimary}"
                                       FontFamily="{StaticResource AppFont}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid/>
                </DockPanel>
            </Border>

            <!-- Content host: pages are swapped in here with a fade+slide transition -->
            <Border Grid.Column="1" Background="{StaticResource BrushBackground}" ClipToBounds="True">
                <ContentControl x:Name="ContentHost" RenderTransformOrigin="0.5,0.5">
                    <ContentControl.RenderTransform>
                        <TranslateTransform/>
                    </ContentControl.RenderTransform>
                </ContentControl>
            </Border>
        </Grid>
    </Grid>
</Window>
