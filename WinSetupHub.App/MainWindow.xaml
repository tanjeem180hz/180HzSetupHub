                                                           Foreground="{DynamicResource MutedText}"
                                                           Margin="0,4,0,0" />
                                            </StackPanel>
                                            <TextBlock x:Name="VisibleUpdatesText"
                                                       Grid.Column="1"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <ListView x:Name="UpdatesList"
                                                  Grid.Row="1"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  SelectionMode="Single"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListViewItem}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding AccentSoftBrush}"
                                                            BorderBrush="{Binding AccentBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="38" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="220" />
                                                                <ColumnDefinition Width="120" />
                                                                <ColumnDefinition Width="112" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />

                                                            <StackPanel Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource MutedText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,3,0,0" />
                                                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                            Margin="0,8,0,0">
                                                                    <ProgressBar Height="6"
                                                                                 Minimum="0"
                                                                                 Maximum="100"
                                                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                                 IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                                                                    <TextBlock Text="{Binding ProgressText}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource MutedText}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding Id}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding VersionText}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource MutedText}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>

                                                            <Border Grid.Column="3"
                                                                    Background="{Binding StatusBackground}"
                                                                    CornerRadius="8"
                                                                    Padding="9,5"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           Foreground="{Binding StatusForeground}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold" />
                                                            </Border>

                                                            <Button Grid.Column="4"
                                                                    Content="Update"
                                                                    Style="{StaticResource PrimaryButton}"
                                                                    IsEnabled="{Binding IsActionEnabled}"
                                                                    Click="InstallSingle_Click"
                                                                    Margin="0" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="ActivityPage"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Live Activity"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="SummaryText"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                             <ProgressBar x:Name="BusyProgress"
                                                          Height="4"
                                                          Margin="0,12,0,0"
                                                          IsIndeterminate="True"
                                                          Visibility="Collapsed" />
                                             <TextBlock x:Name="CurrentOperationProgressText"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource MutedText}"
                                                        TextTrimming="CharacterEllipsis"
                                                        Margin="0,8,0,0" />
                                         </StackPanel>
                                        <WrapPanel Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Top">
                                            <Button x:Name="PauseOperationButton"
                                                    Content="Pause"
                                                    Style="{StaticResource SubtleButton}"
                                                    IsEnabled="False"
                                                    Click="PauseOperation_Click" />
                                            <Button x:Name="ResumeOperationButton"
                                                    Content="Resume"
                                                    Style="{StaticResource SubtleButton}"
                                                    IsEnabled="False"
                                                    Click="ResumeOperation_Click" />
                                            <Button x:Name="StopOperationButton"
                                                    Content="Stop"
                                                    Style="{StaticResource DangerButton}"
                                                    IsEnabled="False"
                                                    Click="StopOperation_Click" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <TextBox x:Name="LogBox"
                                         Grid.Row="1"
                                         AcceptsReturn="True"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas"
                                         FontSize="12"
                                         BorderBrush="{DynamicResource PanelBorder}"
                                         Margin="0" />

                                <WrapPanel Grid.Row="2"
                                           Margin="0,14,0,0">
                                    <Button x:Name="WindowsUpdateButton"
                                            Content="Windows Update"
                                            Click="WindowsUpdate_Click" />
                                    <Button x:Name="CheckAppUpdateButton"
                                            Content="App Update"
                                            Click="CheckAppUpdate_Click" />
                                </WrapPanel>
                            </Grid>

                            <Grid x:Name="UninstallerPage"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Search installed apps"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource MutedText}"
                                                           Margin="2,0,0,4" />
                                                <TextBox x:Name="UninstallerSearchBox"
                                                         ToolTip="Search by app, publisher, kind, or install path"
                                                         TextChanged="UninstallerSearchBox_TextChanged" />
                                            </StackPanel>
                                            <WrapPanel Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Bottom">
                                                <Button x:Name="RefreshInstalledAppsButton"
                                                        Content="Refresh"
                                                        Click="RefreshInstalledApps_Click" />
                                                <Button x:Name="ScanSelectedLeftoversButton"
                                                        Content="Scan Leftovers"
                                                        Style="{StaticResource SubtleButton}"
                                                        Click="ScanSelectedLeftovers_Click" />
                                                <Button x:Name="UninstallSelectedAppsButton"
                                                        Content="Uninstall Selected"
                                                        Style="{StaticResource DangerButton}"
                                                        Click="UninstallSelectedApps_Click" />
                                                <Button x:Name="DeleteSelectedLeftoversButton"
                                                        Content="Delete Leftovers"
                                                        Style="{StaticResource DangerButton}"
                                                        Click="DeleteSelectedLeftovers_Click" />
                                            </WrapPanel>
                                        </Grid>

                                        <WrapPanel Grid.Row="1"
                                                   Margin="0,8,0,0">
                                            <Border Background="{DynamicResource NeutralBackground}"
                                                    CornerRadius="8"
                                                    Padding="10,7"
                                                    Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="InstalledAppsCountText"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource NeutralText}" />
                                                    <TextBlock Text=" apps found"
                                                               Foreground="{DynamicResource NeutralText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource WarningBackground}"
                                                    CornerRadius="8"
                                                    Padding="10,7"
                                                    Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="ProtectedAppsCountText"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource WarningText}" />
                                                    <TextBlock Text=" protected"
                                                               Foreground="{DynamicResource WarningText}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{DynamicResource InfoBackground}"
                                                    CornerRadius="8"
                                                    Padding="10,7"
                                                    Margin="0,0,8,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="SelectedInstalledAppsText"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource InfoText}" />
                                                    <TextBlock Text=" selected"
                                                               Foreground="{DynamicResource InfoText}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Installed Software"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="VisibleInstalledAppsText"
                                                       Grid.Column="1"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <ListView x:Name="InstalledAppsList"
                                                  Grid.Row="1"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  SelectionMode="Single"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListViewItem}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding AccentSoftBrush}"
                                                            BorderBrush="{Binding AccentBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32" />
                                                                <ColumnDefinition Width="58" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="1.15*" />
                                                                <ColumnDefinition Width="1.6*" />
                                                                <ColumnDefinition Width="128" />
                                                                <ColumnDefinition Width="132" />
                                                                <ColumnDefinition Width="250" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />

                                                            <Border Grid.Column="1"
                                                                    Width="44"
                                                                    Height="44"
                                                                    Background="{DynamicResource PanelBackground}"
                                                                    BorderBrush="{Binding AccentBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding Initials}"
                                                                               Foreground="{Binding AccentBrush}"
                                                                               FontSize="13"
                                                                               FontWeight="SemiBold"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center" />
                                                                    <Image Source="{Binding IconSource}"
                                                                           Width="30"
                                                                           Height="30"
                                                                           Stretch="Uniform"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Border>

                                                            <StackPanel Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,14,0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Version}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource MutedText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,3,0,0" />
                                                                <StackPanel Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                            Margin="0,8,0,0">
                                                                    <ProgressBar Height="6"
                                                                                 Minimum="0"
                                                                                 Maximum="100"
                                                                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                                 IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}" />
                                                                    <TextBlock Text="{Binding ProgressText}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource MutedText}"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               Margin="0,4,0,0" />
                                                                </StackPanel>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="3"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,12,0">
                                                                <TextBlock Text="{Binding KindText}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource MutedText}" />
                                                                <TextBlock Text="{Binding Publisher}"
                                                                           FontSize="12"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>

                                                            <TextBlock Grid.Column="4"
                                                                       Text="{Binding InstallLocation}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource MutedText}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding InstallLocation}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,12,0" />

                                                            <Border Grid.Column="5"
                                                                    Background="{DynamicResource PanelBackground}"
                                                                    BorderBrush="{DynamicResource PanelBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="9,5"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding StatusText}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource PrimaryText}" />
                                                            </Border>

                                                            <StackPanel Grid.Column="6"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,10,0">
                                                                <TextBlock Text="Leftovers"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource MutedText}" />
                                                                <TextBlock Text="{Binding LeftoverText}"
                                                                           FontSize="12"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <WrapPanel Grid.Column="7"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center">
                                                                <Button Content="Scan"
                                                                        IsEnabled="{Binding CanScanLeftovers}"
                                                                        Click="ScanLeftoversSingle_Click" />
                                                                <Button Content="Uninstall"
                                                                        IsEnabled="{Binding CanUninstall}"
                                                                        Style="{StaticResource DangerButton}"
                                                                        Click="UninstallSingle_Click" />
                                                                <Button Content="Delete"
                                                                        IsEnabled="{Binding CanDeleteLeftovers}"
                                                                        Style="{StaticResource DangerButton}"
                                                                        Click="DeleteLeftoversSingle_Click" />
                                                            </WrapPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="CleanupPage"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="16"
                                        Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Junk Cleanup"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="CleanupSummaryText"
                                                       Text="Scan safe temp/cache targets, then clean only selected items."
                                                       FontSize="13"
                                                       Foreground="{DynamicResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,4,0,0" />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                            <Button x:Name="SelectCleanupDefaultsButton"
                                                    Content="Safe Defaults"
                                                    Click="SelectCleanupDefaults_Click" />
                                            <Button x:Name="ScanCleanupButton"
                                                    Content="Scan Junk"
                                                    Style="{StaticResource SubtleButton}"
                                                    Click="ScanCleanup_Click" />
                                            <Button x:Name="CleanSelectedJunkButton"
                                                    Content="Clean Selected"
                                                    Style="{StaticResource DangerButton}"
                                                    Click="CleanSelectedJunk_Click" />
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Cleanup Targets"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="CleanupSelectedText"
                                                       Grid.Column="1"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MutedText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <ListView x:Name="CleanupTargetsList"
                                                  Grid.Row="1"
                                                  BorderThickness="0"
                                                  Background="Transparent"
                                                  SelectionMode="Single"
                                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListView.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListViewItem}">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="Margin" Value="0,0,0,8" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderThickness" Value="0" />
                                                </Style>
                                            </ListView.ItemContainerStyle>
                                            <ListView.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource NeutralBackground}"
                                                            BorderBrush="{DynamicResource PanelBorder}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="12">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="32" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="2*" />
                                                                <ColumnDefinition Width="116" />
                                                                <ColumnDefinition Width="132" />
                                                            </Grid.ColumnDefinitions>

                                                            <CheckBox Grid.Column="0"
                                                                      IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />

                                                            <StackPanel Grid.Column="1"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,16,0">
                                                                <TextBlock Text="{Binding Name}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Description}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource MutedText}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2"
                                                                        VerticalAlignment="Center"
                                                                        Margin="0,0,16,0">
                                                                <TextBlock Text="{Binding RootPath}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource MutedText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           ToolTip="{Binding RootPath}" />
                                                                <TextBlock Text="{Binding FileText}"
                                                                           FontSize="12"
                                                                           Margin="0,3,0,0" />
                                                            </StackPanel>

                                                            <Border Grid.Column="3"
                                                                    Background="{DynamicResource PanelBackground}"
                                                                    BorderBrush="{DynamicResource PanelBorder}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="9,5"
                                                                    HorizontalAlignment="Left"
                                                                    VerticalAlignment="Center">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding SizeText}"
                                                                               FontSize="14"
                                                                               FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding StatusText}"
                                                                               FontSize="11"
                                                                               Foreground="{DynamicResource MutedText}" />
                                                                </StackPanel>
                                                            </Border>

                                                            <WrapPanel Grid.Column="4"
                                                                       HorizontalAlignment="Right"
                                                                       VerticalAlignment="Center">
                                                                <Button Content="Scan"
                                                                        IsEnabled="{Binding CanRun}"
                                                                        Click="ScanCleanupSingle_Click" />
                                                                <Button Content="Clean"
                                                                        IsEnabled="{Binding CanRun}"
                                                                        Style="{StaticResource DangerButton}"
                                                                        Click="CleanJunkSingle_Click" />
                                                            </WrapPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListView.ItemTemplate>
                                        </ListView>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid x:Name="StoragePage"
                                  Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource PanelBackground}"
                                        BorderBrush="{DynamicResource PanelBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="18"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Storage Root"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock x:Name="DataRootText"
                                                       FontSize="13"
                                                       Foreground="{DynamicResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                x:Name="OpenDataFolderButton"
                                                Content="Open Storage"
                                                VerticalAlignment="Center"
                                                Click="OpenDataFolder_Click" />
                                    </Grid>
                                </Border>

                                <UniformGrid Grid.Row="1"
                                             Columns="3"
                                             Rows="1">
                                    <Border Background="{DynamicResource NeutralBackground}"
                                            CornerRadius="8"
                                            Padding="18"
                                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Config"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="packages.json, appsettings.json"
                                                       Foreground="{DynamicResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource NeutralBackground}"
                                            CornerRadius="8"
                                            Padding="18"
                                            Margin="0,0,10,0">
                                        <StackPanel>
                                            <TextBlock Text="Logs"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Session history stays local."
                                                       Foreground="{DynamicResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource NeutralBackground}"
                                            CornerRadius="8"
                                            Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Downloads"
                                                       FontSize="18"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="Reserved for future self-updates."
                                                       Foreground="{DynamicResource MutedText}"
                                                       TextWrapping="Wrap"
                                                       Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{DynamicResource PanelBackground}"
                    BorderBrush="{DynamicResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="10,8"
                    Margin="0,16,0,0">
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="{DynamicResource MutedText}" />
            </Border>
        </Grid>

        <Grid x:Name="WelcomeOverlay"
              Panel.ZIndex="20">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop x:Name="WelcomeBgStopOne"
                                  Color="#050C1E"
                                  Offset="0" />
                    <GradientStop x:Name="WelcomeBgStopTwo"
                                  Color="#0A1C3E"
                                  Offset="0.45" />
                    <GradientStop x:Name="WelcomeBgStopThree"
                                  Color="#002D66"
                                  Offset="1" />
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.Resources>
                <Style x:Key="WelcomeTile" TargetType="{x:Type Border}">
                    <Setter Property="Width" Value="64" />
                    <Setter Property="Height" Value="64" />
                    <Setter Property="Padding" Value="12" />
                    <Setter Property="Margin" Value="11" />
                    <Setter Property="CornerRadius" Value="8" />
                    <Setter Property="Background" Value="#DFFFFFFF" />
                    <Setter Property="BorderBrush" Value="#D7E6F4" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <RotateTransform Angle="90" />
                        </Setter.Value>
                    </Setter>
                    <Setter Property="CacheMode">
                        <Setter.Value>
                            <BitmapCache RenderAtScale="0.85" />
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="WelcomeLogo" TargetType="{x:Type Image}">
                    <Setter Property="Width" Value="36" />
                    <Setter Property="Height" Value="36" />
                    <Setter Property="Stretch" Value="Uniform" />
                    <Setter Property="RenderOptions.BitmapScalingMode" Value="LowQuality" />
